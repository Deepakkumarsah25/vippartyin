<!doctype html><html lang="hi-IN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= pageTitle %></title><meta name="description" content="<%= announcement.summary || announcement.title %>"><link rel="icon" type="image/svg+xml" href="/images/vip-logo.svg"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"><script src="https://cdn.tailwindcss.com"></script><script>tailwind.config={theme:{extend:{colors:{primary:{DEFAULT:'#0066b2',50:'#eff6ff',100:'#dbeafe',200:'#bfdbfe',300:'#93c5fd',400:'#60a5fa',500:'#0066b2',600:'#004b87',700:'#003a6c',800:'#002e54',900:'#001e38',950:'#001426'},secondary:{DEFAULT:'#004b87',hover:'#003a6c'},accent:'#f0f7ff',dark:'#0f172a'},fontFamily:{sans:['"Plus Jakarta Sans"','"Noto Sans Devanagari"','Poppins','sans-serif']}}}}</script><link rel="stylesheet" href="/css/style.css"><style>.announcement-copy{white-space:pre-line;line-height:1.9}.announcement-hero{background:radial-gradient(circle at 85% 15%,#2789c244,transparent 30%),linear-gradient(135deg,#082c50,#0869a7)}</style></head><body class="font-sans text-gray-700 bg-white antialiased"><%- include('common/navbar') %><main class="pb-20"><section class="announcement-hero relative overflow-hidden text-white"><div class="absolute -right-20 -bottom-48 w-[30rem] h-[30rem] rounded-full border border-white/10"></div><div class="relative max-w-6xl mx-auto px-5 sm:px-8 py-14 sm:py-20"><a href="/" class="inline-flex items-center gap-2 text-sm text-blue-100 hover:text-white mb-8"><i class="fa-solid fa-arrow-left"></i> Home par wapas</a><span class="block uppercase tracking-[.18em] text-amber-300 font-bold text-xs sm:text-sm mb-4">VIP Party · Announcement</span><h1 class="max-w-4xl text-3xl sm:text-5xl leading-tight font-extrabold"><%= announcement.title %></h1><% if(announcement.summary){ %><p class="max-w-3xl text-blue-100 mt-5 text-base sm:text-lg leading-relaxed"><%= announcement.summary %></p><% } %></div></section><div class="max-w-5xl mx-auto px-5 sm:px-8 -mt-7 relative z-10"><% if(announcement.coverImage){ %><div class="rounded-2xl overflow-hidden shadow-xl mb-7"><img src="<%= announcement.coverImage %>" alt="<%= announcement.title %>" class="w-full max-h-[440px] object-cover"></div><% } %><% if(announcement.content){ %><section class="bg-white rounded-2xl shadow-lg shadow-slate-900/5 border border-slate-100 p-6 sm:p-10 mb-6"><div class="w-12 h-1 rounded bg-amber-400 mb-5"></div><p class="announcement-copy text-slate-600 text-base sm:text-lg"><%= announcement.content %></p></section><% } %><% (announcement.sections||[]).forEach((section,index)=>{ %><section class="bg-white rounded-2xl shadow-lg shadow-slate-900/5 border border-slate-100 p-6 sm:p-10 mb-6"><% if(section.imageUrl){ %><img src="<%= section.imageUrl %>" alt="<%= section.heading||announcement.title %>" loading="lazy" class="w-full max-h-[420px] object-cover rounded-xl mb-7"><% } %><div class="flex gap-4 items-start"><span class="shrink-0 w-11 h-11 rounded-xl bg-blue-50 text-primary flex items-center justify-center font-extrabold"><%= String(index+1).padStart(2,'0') %></span><div><% if(section.heading){ %><h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 mb-3"><%= section.heading %></h2><% } %><% if(section.content){ %><p class="announcement-copy text-slate-600 text-base leading-8"><%= section.content %></p><% } %></div></div></section><% }) %></div></main><%- include('common/footer') %><script src="/js/i18n.js"></script><script src="/js/main.js"></script></body></html>
