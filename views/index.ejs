<!DOCTYPE html>
<html lang="hi-IN" prefix="og: http://ogp.me/ns#">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- SEO Title & Meta Tags -->
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'विकासशील इंसान पार्टी (VIP) – आधिकारिक वेबसाइट' %></title>
  <meta name="title" content="विकासशील इंसान पार्टी (VIP) – आधिकारिक वेबसाइट">
  <meta name="description" content="विकासशील इंसान पार्टी (VIP) का मुख्य उद्देश्य सामाजिक न्याय, समानता, निषाद आरक्षण और हर वर्ग का सशक्तीकरण है। 'सन ऑफ मल्लाह' श्री मुकेश सहनी के नेतृत्व में शिक्षित, विकसित, रोजगारयुक्त और समृद्ध बिहार बनाने के हमारे विजन, नेतृत्व, समाचार और कार्यक्रमों के बारे में जानें।">
  <meta name="keywords" content="VIP Party, Vikassheel Insaan Party, Mukesh Sahani, Son of Mallah, Bihar Politics, Nishad Aarakshan, Jubba Sahani, Bihar Elections 2026">
  <meta name="author" content="Vikassheel Insaan Party (VIP)">
  <meta name="robots" content="index, follow">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://vipparty.in/">
  <meta property="og:title" content="विकासशील इंसान पार्टी (VIP) – आधिकारिक वेबसाइट">
  <meta property="og:description" content="विकासशील इंसान पार्टी (VIP) का मुख्य उद्देश्य सामाजिक न्याय, समानता, निषाद आरक्षण और हर वर्ग का सशक्तीकरण है।">
  <meta property="og:image" content="/images/vip-logo.svg">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/vip-logo.svg">
  <link rel="shortcut icon" type="image/svg+xml" href="/images/vip-logo.svg">
  <link rel="apple-touch-icon" href="/images/vip-logo.svg">

  <!-- Google Fonts: Plus Jakarta Sans, Noto Sans Devanagari & Poppins -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- FontAwesome 6 Free Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Tailwind CSS CDN Configured with VIP Colors -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              DEFAULT: '#0066b2',
              50: '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#0066b2',
              600: '#004b87',
              700: '#003a6c',
              800: '#002e54',
              900: '#001e38',
              950: '#001426',
            },
            secondary: {
              DEFAULT: '#004b87',
              hover: '#003a6c',
            },
            accent: '#f0f7ff',
            dark: '#0f172a'
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '"Noto Sans Devanagari"', 'Poppins', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Custom VIP Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="font-sans text-gray-700 bg-blue-50/50 antialiased">

  <!-- 1. Header & Navigation (Shared Component) -->
  <%- include('common/navbar') %>

  <!-- ========================================================
       SECTION 1: HERO SECTION (FULL WIDTH & FULL HEIGHT BANNER SLIDER)
       Synced with vip-a Admin Panel & Mobile App
       ======================================================== -->
  <section class="home-hero relative w-full overflow-hidden bg-slate-950">
    <div class="hero-carousel-wrapper relative w-full overflow-hidden group select-none" id="heroCarousel">
      
      <!-- Full-Width Responsive Slides Container matching 1807x870 banner aspect ratio -->
      <div class="hero-carousel-slides relative w-full aspect-[2.08/1] overflow-hidden bg-slate-950">
        <% if (typeof heroBanners !== 'undefined' && heroBanners && heroBanners.length > 0) { %>
          <% heroBanners.forEach((banner, idx) => { %>
            <div class="hero-slide absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out <%= idx === 0 ? 'opacity-100 z-10' : 'opacity-0 pointer-events-none z-0' %>" data-slide-index="<%= idx %>">
              <img
                src="<%= banner.imageUrl %>"
                alt="<%= banner.title || 'विकासशील इंसान पार्टी - VIP Party' %>"
                class="main-hero-img w-full h-full block"
                loading="<%= idx === 0 ? 'eager' : 'lazy' %>"
              />
            </div>
          <% }) %>
        <% } else { %>
          <!-- Fallback when no banners are uploaded in vip-a -->
          <div class="hero-slide absolute inset-0 w-full h-full flex items-center justify-center bg-gradient-to-r from-primary-950 via-primary to-primary-900 text-white p-8">
            <div class="text-center max-w-xl">
              <div class="w-20 h-20 mx-auto mb-4 bg-white/10 rounded-2xl p-3 backdrop-blur-md border border-white/20 flex items-center justify-center">
                <img src="/images/vip-logo.svg" alt="VIP Party" class="w-14 h-14 object-contain">
              </div>
              <h2 class="text-3xl font-black mb-2 tracking-tight">विकासशील इंसान पार्टी (VIP)</h2>
              <p class="text-blue-100 text-sm">कृपया admin panel (vip-a) से Hero Banner अपलोड करें।</p>
            </div>
          </div>
        <% } %>
      </div>

      <% if (typeof heroBanners !== 'undefined' && heroBanners && heroBanners.length > 1) { %>
        <!-- Left Navigation Arrow -->
        <button
          type="button"
          id="heroPrevBtn"
          aria-label="Previous Banner"
          class="absolute left-2.5 sm:left-6 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-12 sm:h-12 rounded-full bg-black/40 hover:bg-black/75 text-white shadow-xl backdrop-blur-md flex items-center justify-center transition-all opacity-80 sm:opacity-0 sm:group-hover:opacity-100 hover:scale-110 z-20 border border-white/20 focus:outline-none"
        >
          <i class="fa-solid fa-chevron-left text-sm sm:text-base"></i>
        </button>

        <!-- Right Navigation Arrow -->
        <button
          type="button"
          id="heroNextBtn"
          aria-label="Next Banner"
          class="absolute right-2.5 sm:right-6 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-12 sm:h-12 rounded-full bg-black/40 hover:bg-black/75 text-white shadow-xl backdrop-blur-md flex items-center justify-center transition-all opacity-80 sm:opacity-0 sm:group-hover:opacity-100 hover:scale-110 z-20 border border-white/20 focus:outline-none"
        >
          <i class="fa-solid fa-chevron-right text-sm sm:text-base"></i>
        </button>

        <!-- Slide Indicators / Dots -->
        <div class="absolute bottom-3 sm:bottom-6 inset-x-0 flex items-center justify-center gap-2 sm:gap-2.5 z-20" id="heroDots">
          <% heroBanners.forEach((_, idx) => { %>
            <button
              type="button"
              class="hero-dot h-2 sm:h-2.5 transition-all duration-300 rounded-full shadow-md <%= idx === 0 ? 'w-8 sm:w-10 bg-primary border border-white/60' : 'w-2.5 sm:w-3 bg-white/70 hover:bg-white' %>"
              data-dot-index="<%= idx %>"
              aria-label="Slide <%= idx + 1 %>"
            ></button>
          <% }) %>
        </div>
      <% } %>

      <!-- Live Sync Indicator Badge -->
      <div class="absolute top-3 right-3 sm:top-4 sm:right-4 z-20 bg-primary/90 backdrop-blur-md text-white text-[9px] sm:text-xs font-bold px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-full shadow-lg flex items-center gap-1.5 border border-white/25 pointer-events-none">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>LIVE UPDATES</span>
      </div>

    </div>
  </section>

  <!-- ========================================================
       SECTION 2: 3 QUICK ACTION CARDS
       Identical to RJD layout with VIP Colors
       ======================================================== -->
  <section class="relative z-30 pt-5 sm:pt-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6 sm:mb-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">

      <!-- 1. सदस्य बनें -->
      <a href="/active-member" class="group relative bg-white rounded-2xl shadow-lg shadow-blue-900/10 overflow-hidden border border-blue-100 hover:shadow-2xl hover:shadow-blue-900/15 transition-all duration-500 transform hover:-translate-y-2">
        <div class="absolute inset-0 bg-gradient-to-r from-primary to-blue-700 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="p-5 sm:p-7 relative z-10">
          <div class="w-12 h-12 sm:w-14 sm:h-14 bg-blue-50 rounded-xl flex items-center justify-center text-primary mb-4 sm:mb-5 group-hover:bg-white/20 group-hover:text-white transition-colors duration-500 shadow-sm">
            <i class="fa-solid fa-user-plus text-xl sm:text-2xl"></i>
          </div>
          <h3 class="text-xl sm:text-2xl font-black text-gray-900 group-hover:text-white mb-2 transition-colors duration-500 tracking-tight" data-i18n="quick.member_title">
            सदस्य बनें
          </h3>
          <p class="text-xs sm:text-sm text-gray-500 group-hover:text-blue-50 transition-colors duration-500 leading-relaxed" data-i18n="quick.member_desc">
            VIP परिवार से जुड़ें और बिहार के नवनिर्माण व सामाजिक न्याय के आंदोलन में अपना बहुमूल्य योगदान दें।
          </p>
          <div class="mt-4 sm:mt-5 flex items-center text-primary group-hover:text-white font-bold text-xs sm:text-sm tracking-wide">
            <span data-i18n="quick.join_now">अभी जुड़ें</span> <i class="fa-solid fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform duration-300"></i>
          </div>
        </div>
      </a>

      <!-- 2. सक्रिय सदस्य बनें -->
      <a href="/active-member" class="group relative bg-white rounded-2xl shadow-lg shadow-sky-900/10 overflow-hidden border border-sky-100 hover:shadow-2xl hover:shadow-sky-900/15 transition-all duration-500 transform hover:-translate-y-2">
        <div class="absolute inset-0 bg-gradient-to-r from-sky-600 to-primary-800 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="p-5 sm:p-7 relative z-10">
          <div class="w-12 h-12 sm:w-14 sm:h-14 bg-sky-50 rounded-xl flex items-center justify-center text-sky-600 mb-4 sm:mb-5 group-hover:bg-white/20 group-hover:text-white transition-colors duration-500 shadow-sm">
            <i class="fa-solid fa-handshake-angle text-xl sm:text-2xl"></i>
          </div>
          <h3 class="text-xl sm:text-2xl font-black text-gray-900 group-hover:text-white mb-2 transition-colors duration-500 tracking-tight" data-i18n="quick.active_title">
            सक्रिय सदस्य बनें
          </h3>
          <p class="text-xs sm:text-sm text-gray-500 group-hover:text-sky-50 transition-colors duration-500 leading-relaxed" data-i18n="quick.active_desc">
            पार्टी के संगठनात्मक अभियानों और सामाजिक कार्यों में जमीनी स्तर पर बढ़-चढ़कर सक्रिय हिस्सा लें।
          </p>
          <div class="mt-4 sm:mt-5 flex items-center text-sky-600 group-hover:text-white font-bold text-xs sm:text-sm tracking-wide">
            <span data-i18n="quick.register_now">रजिस्टर करें</span> <i class="fa-solid fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform duration-300"></i>
          </div>
        </div>
      </a>

      <!-- 3. सहयोग करें (दान दें) -->
      <a href="/donate" class="group relative bg-white rounded-2xl shadow-lg shadow-amber-900/10 overflow-hidden border border-amber-100 hover:shadow-2xl hover:shadow-amber-900/15 transition-all duration-500 transform hover:-translate-y-2">
        <div class="absolute inset-0 bg-gradient-to-r from-amber-500 to-orange-600 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="p-5 sm:p-7 relative z-10">
          <div class="w-12 h-12 sm:w-14 sm:h-14 bg-orange-50 rounded-xl flex items-center justify-center text-orange-500 mb-4 sm:mb-5 group-hover:bg-white/20 group-hover:text-white transition-colors duration-500 shadow-sm">
            <i class="fa-solid fa-hand-holding-dollar text-xl sm:text-2xl"></i>
          </div>
          <h3 class="text-xl sm:text-2xl font-black text-gray-900 group-hover:text-white mb-2 transition-colors duration-500 tracking-tight" data-i18n="quick.support_title">
            सहयोग करें
          </h3>
          <p class="text-xs sm:text-sm text-gray-500 group-hover:text-orange-50 transition-colors duration-500 leading-relaxed" data-i18n="quick.support_desc">
            पार्टी को मजबूत बनाने के लिए अपना आर्थिक सहयोग प्रदान कर सामाजिक न्याय के संघर्ष को सशक्त करें।
          </p>
          <div class="mt-4 sm:mt-5 flex items-center text-orange-500 group-hover:text-white font-bold text-xs sm:text-sm tracking-wide">
            <span data-i18n="quick.donate_now">दान दें</span> <i class="fa-solid fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform duration-300"></i>
          </div>
        </div>
      </a>

    </div>
  </section>

  <!-- ========================================================
       SECTION 3: हमारा संकल्प (VISION FOR BIHAR)
       3-Column Pillars Layout matching RJD
       ======================================================== -->
  <section class="py-10 sm:py-[2.1rem] bg-blue-50/50 border-y border-blue-100/80 relative overflow-hidden">
    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-64 h-64 rounded-full bg-blue-100 opacity-50"></div>
    <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-amber-50 opacity-50"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-2xl mx-auto mb-5 sm:mb-12">
        <span class="text-primary font-bold tracking-widest text-xs sm:text-sm uppercase mb-1.5 sm:mb-2 block" data-i18n="vision.badge">हमारा संकल्प</span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-gray-900 mb-2 sm:mb-4" data-i18n="vision.title">बिहार के नवनिर्माण का दृष्टिकोण</h2>
        <p class="text-gray-600 text-xs sm:text-sm md:text-base leading-relaxed" data-i18n="vision.subtitle">
          हम एक ऐसे बिहार के निर्माण के लिए प्रतिबद्ध हैं जहाँ हर युवा को रोजगार, हर किसान-मजदूर को सम्मान और हर नागरिक को न्याय मिले।
        </p>
        <!-- Mobile Swipe Hint -->
        <div class="flex items-center justify-center gap-1.5 mt-3 md:hidden">
          <span class="text-[11px] font-bold text-primary bg-primary/10 px-2.5 py-0.5 rounded-full flex items-center gap-1.5">
            <i class="fa-solid fa-arrows-left-right text-[10px]"></i> 3 स्तंभ देखने के लिए स्वाइप करें
          </span>
        </div>
      </div>

      <div id="home-vision-pillars" class="flex md:grid overflow-x-auto md:overflow-visible snap-x snap-mandatory md:snap-none gap-4 md:gap-8 pb-3 md:pb-0 px-4 -mx-4 md:px-0 md:mx-0 scroll-smooth no-scrollbar md:grid-cols-3">
        
        <!-- 01. जन उत्थान -->
        <div class="flex-none md:flex-initial w-[82vw] max-w-[320px] md:w-auto snap-start bg-white rounded-2xl p-5 sm:p-8 shadow-md shadow-blue-900/5 hover:shadow-xl hover:-translate-y-1 transition-all border border-blue-100 border-b-4 border-b-primary group flex flex-col justify-between relative overflow-hidden">
          <div>
            <div class="flex items-center justify-between mb-4 sm:mb-6">
              <div class="w-12 h-12 sm:w-16 sm:h-16 bg-blue-50 rounded-2xl flex items-center justify-center text-primary text-xl sm:text-2xl group-hover:scale-110 transition-transform shadow-inner">
                <i class="fa-solid fa-user-graduate"></i>
              </div>
              <span class="text-[10px] font-black uppercase tracking-wider text-primary bg-blue-50 px-2.5 py-1 rounded-full md:hidden">स्तंभ ०१</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-gray-900 mb-2 sm:mb-3" data-i18n="vision.p1_title">जन उत्थान</h3>
            <p class="text-gray-600 text-xs sm:text-sm leading-relaxed" data-i18n="vision.p1_desc">
              बिहार के हर नागरिक, विशेषकर युवाओं और वंचितों को प्रगति के समान अवसर प्रदान करना। हमारी नीतियां जमीनी स्तर पर विकास सुनिश्चित कर एक आत्मनिर्भर और सशक्त समाज के निर्माण के लिए प्रतिबद्ध हैं।
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-gray-100 flex items-center text-[11px] sm:text-xs font-semibold text-primary">
            <i class="fa-solid fa-circle-check mr-1.5 text-primary"></i> <span>रोजगार व आत्मनिर्भरता</span>
          </div>
        </div>

        <!-- 02. जन कल्याण -->
        <div class="flex-none md:flex-initial w-[82vw] max-w-[320px] md:w-auto snap-start bg-white rounded-2xl p-5 sm:p-8 shadow-md shadow-sky-900/5 hover:shadow-xl hover:-translate-y-1 transition-all border border-sky-100 border-b-4 border-b-sky-500 group flex flex-col justify-between relative overflow-hidden">
          <div>
            <div class="flex items-center justify-between mb-4 sm:mb-6">
              <div class="w-12 h-12 sm:w-16 sm:h-16 bg-sky-50 rounded-2xl flex items-center justify-center text-sky-500 text-xl sm:text-2xl group-hover:scale-110 transition-transform shadow-inner">
                <i class="fa-solid fa-seedling"></i>
              </div>
              <span class="text-[10px] font-black uppercase tracking-wider text-sky-600 bg-sky-50 px-2.5 py-1 rounded-full md:hidden">स्तंभ ०२</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-gray-900 mb-2 sm:mb-3" data-i18n="vision.p2_title">जन कल्याण</h3>
            <p class="text-gray-600 text-xs sm:text-sm leading-relaxed" data-i18n="vision.p2_desc">
              किसानों, मत्स्यपालकों, मजदूरों और आम जनता के जीवन को खुशहाल बनाने के लिए समर्पित। बेहतर स्वास्थ्य, गुणवत्तापूर्ण शिक्षा और सर्वसुलभ बुनियादी सुविधाएं प्रदान कर हर चेहरे पर मुस्कान लाना ही हमारा संकल्प है।
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-gray-100 flex items-center text-[11px] sm:text-xs font-semibold text-sky-600">
            <i class="fa-solid fa-circle-check mr-1.5 text-sky-500"></i> <span>स्वास्थ्य, शिक्षा व समृद्धि</span>
          </div>
        </div>

        <!-- 03. जन-सम्मान -->
        <div class="flex-none md:flex-initial w-[82vw] max-w-[320px] md:w-auto snap-start bg-white rounded-2xl p-5 sm:p-8 shadow-md shadow-amber-900/5 hover:shadow-xl hover:-translate-y-1 transition-all border border-amber-100 border-b-4 border-b-amber-500 group flex flex-col justify-between relative overflow-hidden">
          <div>
            <div class="flex items-center justify-between mb-4 sm:mb-6">
              <div class="w-12 h-12 sm:w-16 sm:h-16 bg-amber-50 rounded-2xl flex items-center justify-center text-amber-500 text-xl sm:text-2xl group-hover:scale-110 transition-transform shadow-inner">
                <i class="fa-solid fa-scale-balanced"></i>
              </div>
              <span class="text-[10px] font-black uppercase tracking-wider text-amber-600 bg-amber-50 px-2.5 py-1 rounded-full md:hidden">स्तंभ ०३</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-gray-900 mb-2 sm:mb-3" data-i18n="vision.p3_title">जन-सम्मान</h3>
            <p class="text-gray-600 text-xs sm:text-sm leading-relaxed" data-i18n="vision.p3_desc">
              सामाजिक न्याय की अडिग विचारधारा के साथ, समाज के अंतिम पायदान पर खड़े हर व्यक्ति को उसका वास्तविक अधिकार दिलाना। हम एक ऐसे समतामूलक समाज के पैरोकार हैं जहाँ हर नागरिक स्वाभिमान से जिए।
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-gray-100 flex items-center text-[11px] sm:text-xs font-semibold text-amber-600">
            <i class="fa-solid fa-circle-check mr-1.5 text-amber-500"></i> <span>सामाजिक न्याय व स्वाभिमान</span>
          </div>
        </div>

