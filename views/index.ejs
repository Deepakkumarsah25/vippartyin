<!DOCTYPE html>
<html lang="hi-IN" prefix="og: http://ogp.me/ns#">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- SEO Title & Meta Tags -->
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'विकासशील इंसान पार्टी (VIP) – आधिकारिक वेबसाइट' %></title>
  <meta name="title" content="विकासशील इंसान पार्टी (VIP) – आधिकारिक वेबसाइट">
  <meta name="description" content="विकासशील इंसान पार्टी (VIP) का मुख्य उद्देश्य सामाजिक न्याय, समानता, निषाद आरक्षण और हर वर्ग का सशक्तीकरण है। 'सन ऑफ मल्लाह' श्री मुकेश सहनी के नेतृत्व में शिक्षित, विकसित, रोजगारयुक्त और समृद्ध बिहार बनाने के हमारे विजन, नेतृत्व, समाचार और कार्यक्रमों के बारे में जानें।">
  <meta name="keywords" content="VIP Party, Vikassheel Insaan Party, Mukesh Sahani, Son of Mallah, Bihar Politics, Nishad Aarakshan, Jubba Sahani, Bihar Elections 2026">
  <meta name="author" content="Vikassheel Insaan Party (VIP)">
  <meta name="robots" content="index, follow">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://vipparty.in/">
  <meta property="og:title" content="विकासशील इंसान पार्टी (VIP) – आधिकारिक वेबसाइट">
  <meta property="og:description" content="विकासशील इंसान पार्टी (VIP) का मुख्य उद्देश्य सामाजिक न्याय, समानता, निषाद आरक्षण और हर वर्ग का सशक्तीकरण है।">
  <meta property="og:image" content="/images/vip-logo.svg">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/vip-logo.svg">
  <link rel="shortcut icon" type="image/svg+xml" href="/images/vip-logo.svg">
  <link rel="apple-touch-icon" href="/images/vip-logo.svg">

  <!-- Google Fonts: Plus Jakarta Sans, Noto Sans Devanagari & Poppins -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- FontAwesome 6 Free Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Tailwind CSS CDN Configured with VIP Colors -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              DEFAULT: '#0066b2',
              50: '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#0066b2',
              600: '#004b87',
              700: '#003a6c',
              800: '#002e54',
              900: '#001e38',
              950: '#001426',
            },
            secondary: {
              DEFAULT: '#004b87',
              hover: '#003a6c',
            },
            accent: '#f0f7ff',
            dark: '#0f172a'
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '"Noto Sans Devanagari"', 'Poppins', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Custom VIP Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="font-sans text-gray-700 bg-blue-50/50 antialiased">

  <!-- 1. Header & Navigation (Shared Component) -->
  <%- include('common/navbar') %>

  <!-- ========================================================
       SECTION 1: HERO SECTION (FULL WIDTH & FULL HEIGHT BANNER SLIDER)
       Synced with vip-a Admin Panel & Mobile App
       ======================================================== -->
  <section class="home-hero relative w-full overflow-hidden bg-slate-950">
    <div class="hero-carousel-wrapper relative w-full overflow-hidden group select-none" id="heroCarousel">
      
      <!-- Full-Width Responsive Slides Container matching 1807x870 banner aspect ratio -->
      <div class="hero-carousel-slides relative w-full aspect-[2.08/1] overflow-hidden bg-slate-950">
        <% if (typeof heroBanners !== 'undefined' && heroBanners && heroBanners.length > 0) { %>
          <% heroBanners.forEach((banner, idx) => { %>
            <div class="hero-slide absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out <%= idx === 0 ? 'opacity-100 z-10' : 'opacity-0 pointer-events-none z-0' %>" data-slide-index="<%= idx %>">
              <img
                src="<%= banner.imageUrl %>"
                alt="<%= banner.title || 'विकासशील इंसान पार्टी - VIP Party' %>"
                class="main-hero-img w-full h-full block"
                loading="<%= idx === 0 ? 'eager' : 'lazy' %>"
              />
            </div>
          <% }) %>
        <% } else { %>
          <!-- Fallback when no banners are uploaded in vip-a -->
          <div class="hero-slide absolute inset-0 w-full h-full flex items-center justify-center bg-gradient-to-r from-primary-950 via-primary to-primary-900 text-white p-8">
            <div class="text-center max-w-xl">
              <div class="w-20 h-20 mx-auto mb-4 bg-white/10 rounded-2xl p-3 backdrop-blur-md border border-white/20 flex items-center justify-center">
                <img src="/images/vip-logo.svg" alt="VIP Party" class="w-14 h-14 object-contain">
              </div>
              <h2 class="text-3xl font-black mb-2 tracking-tight">विकासशील इंसान पार्टी (VIP)</h2>
              <p class="text-blue-100 text-sm">कृपया admin panel (vip-a) से Hero Banner अपलोड करें।</p>
            </div>
          </div>
        <% } %>
      </div>

      <% if (typeof heroBanners !== 'undefined' && heroBanners && heroBanners.length > 1) { %>
        <!-- Left Navigation Arrow -->
        <button
          type="button"
          id="heroPrevBtn"
          aria-label="Previous Banner"
          class="absolute left-2.5 sm:left-6 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-12 sm:h-12 rounded-full bg-black/40 hover:bg-black/75 text-white shadow-xl backdrop-blur-md flex items-center justify-center transition-all opacity-80 sm:opacity-0 sm:group-hover:opacity-100 hover:scale-110 z-20 border border-white/20 focus:outline-none"
        >
          <i class="fa-solid fa-chevron-left text-sm sm:text-base"></i>
        </button>

        <!-- Right Navigation Arrow -->
        <button
          type="button"
          id="heroNextBtn"
          aria-label="Next Banner"
          class="absolute right-2.5 sm:right-6 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-12 sm:h-12 rounded-full bg-black/40 hover:bg-black/75 text-white shadow-xl backdrop-blur-md flex items-center justify-center transition-all opacity-80 sm:opacity-0 sm:group-hover:opacity-100 hover:scale-110 z-20 border border-white/20 focus:outline-none"
        >
          <i class="fa-solid fa-chevron-right text-sm sm:text-base"></i>
        </button>

        <!-- Slide Indicators / Dots -->
        <div class="absolute bottom-3 sm:bottom-6 inset-x-0 flex items-center justify-center gap-2 sm:gap-2.5 z-20" id="heroDots">
          <% heroBanners.forEach((_, idx) => { %>
            <button
              type="button"
              class="hero-dot h-2 sm:h-2.5 transition-all duration-300 rounded-full shadow-md <%= idx === 0 ? 'w-8 sm:w-10 bg-primary border border-white/60' : 'w-2.5 sm:w-3 bg-white/70 hover:bg-white' %>"
              data-dot-index="<%= idx %>"
              aria-label="Slide <%= idx + 1 %>"
            ></button>
          <% }) %>
        </div>
      <% } %>

      <!-- Live Sync Indicator Badge -->
      <div class="absolute top-3 right-3 sm:top-4 sm:right-4 z-20 bg-primary/90 backdrop-blur-md text-white text-[9px] sm:text-xs font-bold px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-full shadow-lg flex items-center gap-1.5 border border-white/25 pointer-events-none">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>LIVE UPDATES</span>
      </div>

    </div>
  </section>

  <!-- ========================================================
       SECTION 2: MISSION STATEMENT & TEXT CONTENT
       ======================================================== -->
  <section class="relative z-30 pt-5 sm:pt-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8 sm:mb-12">

    <!-- Mission Statement & Callout Banner (Matching Reference Design) -->
    <div class="bg-white rounded-2xl sm:rounded-3xl p-5 sm:p-7 lg:p-8 border border-blue-100 shadow-xl shadow-blue-900/5 relative overflow-hidden">
      <!-- Subtle Decorative Accent Blurs -->
      <div class="absolute -right-16 -top-16 w-56 h-56 rounded-full bg-primary/5 blur-3xl pointer-events-none"></div>
      <div class="absolute -left-16 -bottom-16 w-56 h-56 rounded-full bg-amber-400/10 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 sm:gap-6 lg:gap-8">
        <!-- Text Content -->
        <div class="max-w-3xl">
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-gray-900 tracking-tight leading-tight" data-i18n="mission_cta.title">
            विकासशील इंसान पार्टी
          </h2>
          <p class="mt-2.5 sm:mt-3 text-sm sm:text-base lg:text-lg text-gray-600 leading-relaxed font-normal" data-i18n="mission_cta.desc">
            हमारा लक्ष्य एक समतामूलक, प्रगतिशील और खुशहाल बिहार का निर्माण है, जहाँ हर व्यक्ति को सम्मान और अवसर मिले।
          </p>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-3.5 shrink-0 w-full lg:w-auto">
          <!-- Button 1: Our Ideology -->
          <a
            href="/ideology"
            class="w-full sm:w-auto min-w-[180px] lg:min-w-[190px] inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-primary hover:bg-primary-600 text-white font-bold text-base transition-all duration-300 shadow-md hover:shadow-lg hover:shadow-primary/30 transform hover:-translate-y-0.5 active:translate-y-0 group text-center"
          >
            <span data-i18n="mission_cta.btn_ideology">हमारे विचार</span>
            <i class="fa-solid fa-arrow-right text-xs transition-transform duration-300 group-hover:translate-x-1.5"></i>
          </a>

          <!-- Button 2: Join VIP Party -->
          <a
            href="/member"
            class="w-full sm:w-auto min-w-[180px] lg:min-w-[190px] inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-white hover:bg-primary-50 text-primary border-2 border-primary hover:border-primary-600 font-bold text-base transition-all duration-300 shadow-sm hover:shadow-md transform hover:-translate-y-0.5 active:translate-y-0 text-center"
          >
            <span data-i18n="mission_cta.btn_join">हमसे जुड़ें</span>
            <i class="fa-solid fa-users text-sm"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================
       SECTION 2B: प्रमुख सामाजिक मुद्दे (MAJOR SOCIAL ISSUES)
       With Interactive Popping Up Card Animation
       Data fetched dynamically from DB (MajorIssue)
       ======================================================== -->
  <%
    const defaultMajorIssues = [
      {
        order: 1,
        title: 'सामाजिक सद्भाव',
        englishTitle: 'Social Harmony',
        icon: 'fa-people-group',
        image: '/images/issues/social_harmony.png',
        tag: 'आपसी भाईचारा',
        badge: 'मुद्दा #01',
        description: 'समाज के सर्वांगीण विकास के लिए सद्भाव और सौहार्द का माहौल अत्यंत आवश्यक है। आपसी प्रेम, मित्रता और भाईचारे से परिपूर्ण एकजुट समाज का निर्माण।'
      },
      {
        order: 2,
        title: 'समान अधिकार',
        englishTitle: 'Equal Rights',
        icon: 'fa-scale-balanced',
        image: '/images/issues/equal_rights.png',
        tag: 'निषाद आरक्षण',
        badge: 'मुद्दा #02',
        description: 'भारतीय संविधान के अनुसार हर नागरिक को समान अधिकार। देश के अन्य राज्यों की तर्ज पर बिहार में भी निषाद आरक्षण और संवैधानिक हिस्सेदारी सुनिश्चित करना।'
      },
      {
        order: 3,
        title: 'शांति और सुरक्षा',
        englishTitle: 'Peace & Security',
        icon: 'fa-shield-halved',
        image: '/images/issues/peace_security.png',
        tag: 'भयमुक्त समाज',
        badge: 'मुद्दा #03',
        description: 'अपराध पर शून्य सहनशीलता के साथ भयमुक्त माहौल, जहाँ महिलाएं, बच्चे और समाज के वंचित वर्ग बिना डर के गरिमापूर्ण जीवन जी सकें।'
      },
      {
        order: 4,
        title: 'सामाजिक न्याय',
        englishTitle: 'Social Justice',
        icon: 'fa-hand-holding-heart',
        image: '/images/issues/social_justice.png',
        tag: 'शोषणविहीन व्यवस्था',
        badge: 'मुद्दा #04',
        description: 'अंतिम पायदान पर खड़े हर व्यक्ति को मान-सम्मान व अधिकार दिलाना। शोषणविहीन व्यवस्था और सत्ता में वंचितों की न्यायसंगत भागीदारी।'
      },
      {
        order: 5,
        title: 'गुणवत्तापूर्ण शिक्षा',
        englishTitle: 'Quality Education',
        icon: 'fa-graduation-cap',
        image: '/images/issues/education_empowerment.png',
        tag: 'डिजिटल साक्षरता',
        badge: 'मुद्दा #05',
        description: 'सरकारी विद्यालयों का आधुनिकीकरण, तार्किक व वैज्ञानिक सोच, डिजिटल साक्षरता और युवाओं के लिए रोजगारपरक व्यावसायिक शिक्षा।'
      },
      {
        order: 6,
        title: 'स्वास्थ्य सेवा',
        englishTitle: 'Healthcare for All',
        icon: 'fa-heart-pulse',
        image: '/images/issues/healthcare_for_all.png',
        tag: 'मुफ्त दवाएं व जांच',
        badge: 'मुद्दा #06',
        description: 'प्राथमिक स्वास्थ्य नेटवर्क को मजबूत कर हर नागरिक को बिना भेदभाव के मुफ्त जीवनरक्षक दवाएं और गुणवत्तापूर्ण सुलभ चिकित्सा।'
      },
      {
        order: 7,
        title: 'रोजगार व उद्योग',
        englishTitle: 'Employment & Economy',
        icon: 'fa-briefcase',
        image: '/images/issues/employment_growth.png',
        tag: 'स्थानीय रोजगार',
        badge: 'मुद्दा #07',
        description: 'कच्चे माल और स्थानीय संसाधनों के आधार पर क्षेत्रीय उद्योगों की स्थापना, मत्स्य पालन को बढ़ावा देकर युवाओं को अपने राज्य में सम्मानजनक आजीविका।'
      }
    ];

    const issueTitleMap = {
      1: 'सामाजिक सद्भाव',
      2: 'समान अधिकार',
      3: 'शांति और सुरक्षा',
      4: 'सामाजिक न्याय',
      5: 'गुणवत्तापूर्ण शिक्षा',
      6: 'स्वास्थ्य सेवा',
      7: 'रोजगार व उद्योग'
    };

    const rawIssues = (typeof locals !== 'undefined' && Array.isArray(locals.issues))
      ? locals.issues
      : ((typeof issues !== 'undefined' && Array.isArray(issues)) ? issues : []);

    const displayIssues = (rawIssues.length > 0)
      ? rawIssues.map((item, idx) => {
          const orderNum = item.order || (idx + 1);
          const defaultRef = defaultMajorIssues.find(d => Number(d.order) === Number(orderNum)) || defaultMajorIssues[idx % defaultMajorIssues.length];

          // Get the short topic title (e.g. सामाजिक सद्भाव, समान अधिकार, आदि)
          // If the DB title is a generic label like "अंक 1", "मुद्दा #2", "Issue 1", replace with standard short title
          let title = item.shortTitle || item.topic || item.name || item.title || item.heading || '';
          if (!title || /^(अंक|मुद्दा|issue|point)[\s#०-९\d]*$/i.test(title.trim())) {
            title = issueTitleMap[orderNum] || defaultRef.title;
          }

          // Top left badge: Issue / Mudda Number (e.g. मुद्दा #01, मुद्दा #02)
          const badgeText = 'मुद्दा #' + String(orderNum).padStart(2, '0');

          return {
            order: orderNum,
            title: title.trim(),
            badge: badgeText,
            icon: item.icon || defaultRef.icon,
            image: item.image || item.imageUrl || defaultRef.image,
            tag: item.tag || defaultRef.tag,
            description: item.description || item.summary || item.content || defaultRef.description
          };
        })
      : defaultMajorIssues;
  %>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12 sm:mb-16">
    <div class="mb-5 sm:mb-7">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-gray-900 tracking-tight">
        पार्टी के प्रमुख सामाजिक मुद्दे
      </h2>
      <p class="mt-1.5 sm:mt-2 text-xs sm:text-sm md:text-base text-gray-600 max-w-2xl">
        सामाजिक समरसता, समान अधिकार, सुरक्षा, सामाजिक न्याय, शिक्षा, स्वास्थ्य व रोजगार — बिहार के सर्वांगीण विकास के लिए हमारी प्रतिबद्धता।
      </p>
    </div>

    <!-- Popping up issues rail (Horizontal Scroll) -->
    <div class="relative group/rail">
      <div 
        id="issues-rail" 
        class="flex overflow-x-auto snap-x snap-mandatory gap-4 sm:gap-6 pb-6 pt-2 px-1 scroll-smooth no-scrollbar"
      >
        <% displayIssues.forEach((issue, index) => { %>
          <article class="issue-pop-card flex-none w-[275px] sm:w-[310px] md:w-[330px] snap-start bg-white rounded-2xl sm:rounded-3xl border border-blue-100 shadow-md shadow-blue-900/5 overflow-hidden flex flex-col justify-between">
            <div>
              <!-- Card Image Container with overlay badge -->
              <div class="relative aspect-[16/10] bg-slate-900 overflow-hidden">
                <img 
                  src="<%= issue.image %>" 
                  alt="<%= issue.title %>" 
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  onerror="this.onerror=null; this.src='/images/issues/social_harmony.png';"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-900/20 to-transparent"></div>
                
                <!-- Badge (Issue / Mudda Number) -->
                <div class="absolute top-3 left-3 bg-white/95 backdrop-blur-md text-primary font-black text-[11px] px-2.5 py-1 rounded-lg shadow-sm border border-blue-100 flex items-center gap-1.5">
                  <i class="fa-solid <%= issue.icon %> text-amber-500 text-xs shrink-0"></i>
                  <span><%= issue.badge %></span>
                </div>

                <% if (issue.tag) { %>
                  <div class="absolute bottom-2.5 left-3 bg-amber-400 text-gray-950 font-bold text-[10px] px-2 py-0.5 rounded shadow-sm">
                    #<%= issue.tag %>
                  </div>
                <% } %>
              </div>

              <!-- Card Body -->
              <div class="p-4 sm:p-5">
                <h3 class="text-base sm:text-lg font-black text-gray-900 group-hover:text-primary transition-colors mb-2 line-clamp-1">
                  <%= issue.title %>
                </h3>
                <p class="text-xs sm:text-sm text-gray-600 leading-relaxed line-clamp-3">
                  <%= issue.description %>
                </p>
              </div>
            </div>

            <!-- Card Footer -->
            <div class="px-4 pb-4 sm:px-5 sm:pb-5 pt-0">
              <a 
                href="/major-issues#issue-<%= issue.order %>" 
                class="w-full inline-flex items-center justify-between text-xs font-bold text-primary group-hover:text-white bg-blue-50 group-hover:bg-primary px-3.5 py-2 rounded-xl transition-all duration-300"
              >
                <span>विस्तार से पढ़ें</span>
                <i class="fa-solid fa-arrow-right text-[11px] transform group-hover:translate-x-1 transition-transform"></i>
              </a>
            </div>
          </article>
        <% }) %>
      </div>

      <!-- Desktop/Tablet Nav Arrows for Rail -->
      <button 
        type="button" 
        onclick="document.getElementById('issues-rail').scrollBy({left: -330, behavior: 'smooth'})"
        aria-label="Scroll Left"
