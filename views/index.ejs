  <!-- ========================================================
       SECTION 11: बड़ा बैनर ("आपका साथ, हमारा संकल्प")
       Wide Curved Banner matching RJD
       ======================================================== -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10 sm:mb-[2.4rem]">
    <div class="bg-gradient-to-r from-primary-900 via-primary to-primary-700 rounded-3xl overflow-hidden relative shadow-2xl hover:shadow-3xl transition-shadow duration-500 group border border-primary-600">
      
      <!-- Rally Background Blend Overlay -->
      <div class="absolute inset-0 bg-cover bg-center opacity-20 mix-blend-overlay group-hover:scale-105 transition-transform duration-1000" style="background-image: url('/images/event_rally.jpg');"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-primary-950 via-primary-900 to-transparent opacity-90"></div>

      <div class="relative z-10 p-5 sm:p-8 md:p-12 flex flex-col md:flex-row items-center justify-between">
        
        <div class="text-white mb-6 md:mb-0 w-full md:w-2/3">
          <div class="inline-block bg-amber-400 text-gray-950 text-[10px] sm:text-xs font-black px-3 py-1 rounded-full uppercase tracking-wider mb-2.5 sm:mb-3">
            जन-आंदोलन से सत्ता परिवर्तन
          </div>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold mb-2 sm:mb-3 transform transition-transform group-hover:translate-x-2 tracking-tight">
            आपका साथ, हमारा संकल्प
