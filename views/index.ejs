  <!-- Bilingual Translation & VIP Interactions Scripts -->
  <script src="/js/i18n.js"></script>
  <script src="/js/main.js"></script>
  <script>
    (() => {
      const newsGrid = document.getElementById('home-news-list');
      const videoGrid = document.getElementById('home-video-grid');
      if (!newsGrid || !videoGrid) return;

      const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, char => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      })[char]);
      const plainText = value => String(value ?? '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
      const extractRows = payload => Array.isArray(payload) ? payload : (payload?.data || payload?.news || payload?.videos || payload?.media || []);

      async function fetchAll(path) {
        const all = [];
        let page = 1;
        let hasMore = true;
        while (hasMore) {
          const response = await fetch(`${path}?page=${page}&limit=30`);
          if (!response.ok) throw new Error(`Request failed: ${path}`);
          const payload = await response.json();
          const rows = extractRows(payload);
          all.push(...rows);
          hasMore = Boolean(payload?.hasMore) && rows.length > 0;
          page += 1;
        }
        return all;
      }

      const formatDate = value => {
        if (!value) return '';
        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? '' : date.toLocaleDateString('hi-IN', { day: 'numeric', month: 'long', year: 'numeric' });
      };

      fetchAll('/api/press/news').then(items => {
        newsGrid.innerHTML = items.length ? items.map(item => {
          const title = item.title || 'VIP Party';
          const summary = plainText(item.summary || item.description || item.content || '');
          const image = item.coverImage || item.image || item.imageUrl || '/images/event_rally.jpg';
          const date = formatDate(item.date || item.createdAt);
          return `<a href="/news" class="flex flex-col sm:flex-row gap-4 group bg-white p-3 rounded-2xl hover:shadow-md transition-shadow border border-gray-100">
            <div class="w-full sm:w-1/3 overflow-hidden rounded-xl bg-blue-100 h-36"><img src="${escapeHtml(image)}" alt="${escapeHtml(title)}" class="w-full h-full object-cover" loading="lazy" onerror="this.onerror=null;this.src='/images/event_rally.jpg'"></div>
            <div class="w-full sm:w-2/3 flex flex-col justify-center">${date ? `<span class="text-xs text-primary font-bold mb-1 block">${escapeHtml(date)}</span>` : ''}<h3 class="text-lg font-bold text-gray-900 group-hover:text-primary transition mb-2 line-clamp-2">${escapeHtml(title)}</h3>${summary ? `<p class="text-sm text-gray-600 line-clamp-2 mb-2">${escapeHtml(summary)}</p>` : ''}<span class="text-primary text-sm font-semibold flex items-center mt-auto">और पढ़ें <i class="fa-solid fa-arrow-right text-xs ml-1"></i></span></div>
          </a>`;
        }).join('<hr class="border-gray-100">') : '<p class="rounded-xl bg-white p-5 text-gray-500">अभी कोई समाचार उपलब्ध नहीं है।</p>';
      }).catch(error => {
        console.error('Homepage news could not be loaded:', error);
        newsGrid.innerHTML = '<p class="rounded-xl bg-white p-5 text-gray-500">समाचार अभी लोड नहीं हो सके।</p>';
      });

      fetchAll('/api/press/interviews').then(items => {
        videoGrid.innerHTML = items.length ? items.map(item => {
          const title = item.title || 'VIP Party Video';
          const videoId = item.youtubeId || '';
          const link = item.youtubeUrl || (videoId ? `https://www.youtube.com/watch?v=${encodeURIComponent(videoId)}` : '/gallery/video');
          const image = item.thumbnail || item.thumbnailUrl || item.coverImage || item.image || (videoId ? `https://img.youtube.com/vi/${encodeURIComponent(videoId)}/hqdefault.jpg` : '/images/event_rally.jpg');
          return `<article class="group bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-xl transition-all duration-300"><div class="relative overflow-hidden bg-gray-900" style="aspect-ratio:16/9"><img src="${escapeHtml(image)}" alt="${escapeHtml(title)}" class="w-full h-full object-cover" loading="lazy" onerror="this.onerror=null;this.src='/images/event_rally.jpg'"><a href="${escapeHtml(link)}" target="_blank" rel="noopener noreferrer" aria-label="${escapeHtml(title)}" class="absolute inset-0 flex items-center justify-center"><span class="w-12 h-12 bg-white/95 rounded-full flex items-center justify-center text-red-600 shadow-lg group-hover:scale-110 transition-transform"><i class="fa-solid fa-play ml-1"></i></span></a></div><div class="p-4"><h3 class="text-sm font-bold text-gray-900 mb-2 group-hover:text-primary line-clamp-2">${escapeHtml(title)}</h3><a href="${escapeHtml(link)}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-red-600 font-semibold mt-1"><i class="fa-solid fa-play text-[10px]"></i> वीडियो देखें</a></div></article>`;
        }).join('') : '<p class="col-span-full rounded-xl bg-gray-50 p-5 text-center text-gray-500">अभी कोई वीडियो उपलब्ध नहीं है।</p>';
      }).catch(error => {
        console.error('Homepage videos could not be loaded:', error);
        videoGrid.innerHTML = '<p class="col-span-full rounded-xl bg-gray-50 p-5 text-center text-gray-500">वीडियो अभी लोड नहीं हो सके।</p>';
      });
    })();
  </script>
