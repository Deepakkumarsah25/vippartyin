  <!-- Bilingual Translation & VIP Interactions Scripts -->
  <script src="/js/i18n.js"></script>
  <script src="/js/main.js"></script>
  <script>
    (() => {
      const newsGrid = document.getElementById('home-news-list');
      const videoGrid = document.getElementById('home-video-grid');
      if (!newsGrid || !videoGrid) return;

      const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, char => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      })[char]);
      const plainText = value => String(value ?? '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
      const extractRows = payload => Array.isArray(payload) ? payload : (payload?.data || payload?.news || payload?.videos || payload?.media || []);

      async function fetchAll(path) {
        const all = [];
        let page = 1;
        let hasMore = true;
        while (hasMore) {
          const response = await fetch(`${path}?page=${page}&limit=30`);
          if (!response.ok) throw new Error(`Request failed: ${path}`);
          const payload = await response.json();
          const rows = extractRows(payload);
          all.push(...rows);
          hasMore = Boolean(payload?.hasMore) && rows.length > 0;
          page += 1;
        }
        return all;
      }

      const formatDate = value => {
        if (!value) return '';
        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? '' : date.toLocaleDateString('hi-IN', { day: 'numeric', month: 'long', year: 'numeric' });
      };

      fetchAll('/api/press/news').then(items => {
        newsGrid.innerHTML = items.length ? items.slice(0, 3).map(item => {
          const title = item.title || 'VIP Party';
          const summary = plainText(item.description || item.content || '');
          const isVideo = Boolean(item.youtubeId || item.youtubeUrl || item.videoType === 'youtube');
          const videoId = item.youtubeId || '';
          const image = item.coverImage || item.image || item.imageUrl || item.mediaUrl || item.cover || item.thumbnail || (item.images && item.images[0] && (item.images[0].url || item.images[0])) || (videoId ? `https://img.youtube.com/vi/${encodeURIComponent(videoId)}/hqdefault.jpg` : '/images/event_rally.jpg');
          const date = formatDate(item.date || item.createdAt);
          const link = (isVideo && item.youtubeUrl) ? item.youtubeUrl : '/news';
          const targetAttr = (isVideo && item.youtubeUrl) ? 'target="_blank" rel="noopener noreferrer"' : '';
          const category = item.category || (isVideo ? 'वीडियो समाचार' : 'समाचार');

          return `<a href="${escapeHtml(link)}" ${targetAttr} class="w-full min-h-[136px] sm:min-h-[168px] group bg-white p-4 rounded-2xl hover:shadow-lg transition-all border border-gray-200/80 shadow-sm flex flex-row gap-3 sm:gap-4">
            <div class="w-[42%] max-w-[250px] aspect-video overflow-hidden rounded-xl bg-gray-100 relative flex-shrink-0">
              <img src="${escapeHtml(image)}" alt="${escapeHtml(title)}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.onerror=null;this.src='/images/event_rally.jpg'">
              ${isVideo ? `
                <div class="absolute inset-0 bg-black/30 flex items-center justify-center transition-all group-hover:bg-black/40">
                  <span class="w-11 h-11 bg-white/95 text-red-600 rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-play ml-0.5 text-sm"></i>
                  </span>
                </div>
                <span class="absolute top-2.5 left-2.5 bg-red-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-full flex items-center gap-1 shadow-md">
                  <i class="fa-brands fa-youtube text-[10px]"></i> वीडियो
                </span>
              ` : `
                <span class="absolute top-2.5 left-2.5 bg-primary text-white text-[10px] font-bold px-2 py-0.5 rounded-full flex items-center gap-1 shadow-sm">
                  <i class="fa-regular fa-newspaper text-[9px]"></i> समाचार
                </span>
              `}
            </div>
            <div class="min-w-0 flex-1 flex flex-col justify-between flex-1">
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  ${date ? `<span class="text-xs text-primary font-bold flex items-center gap-1"><i class="fa-regular fa-calendar-alt text-[10px]"></i>${escapeHtml(date)}</span>` : ''}
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-blue-50 text-primary uppercase">${escapeHtml(category)}</span>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-gray-900 group-hover:text-primary transition-colors line-clamp-2 mb-1.5 leading-snug">${escapeHtml(title)}</h3>
                ${summary ? `<p class="text-xs sm:text-sm text-gray-600 line-clamp-2 mb-3 leading-relaxed">${escapeHtml(summary)}</p>` : ''}
              </div>
              <div class="flex items-center justify-between mt-auto pt-2 border-t border-gray-100">
                <span class="text-primary text-xs sm:text-sm font-semibold flex items-center group-hover:translate-x-0.5 transition-transform">
                  ${isVideo ? 'वीडियो देखें' : 'और पढ़ें'} <i class="fa-solid fa-arrow-right text-xs ml-1.5"></i>
                </span>
                ${isVideo ? '<span class="text-[11px] font-semibold text-red-600 flex items-center gap-1"><i class="fa-brands fa-youtube"></i> YouTube</span>' : ''}
              </div>
            </div>
          </a>`;
        }).join('') : '<p class="rounded-xl bg-white p-5 text-gray-500">अभी कोई समाचार उपलब्ध नहीं है।</p>';
      }).catch(error => {
        console.error('Homepage news could not be loaded:', error);
        newsGrid.innerHTML = '<p class="rounded-xl bg-white p-5 text-gray-500">समाचार अभी लोड नहीं हो सके।</p>';
      });

      fetchAll('/api/press/interviews').then(items => {
        videoGrid.innerHTML = items.length ? items.map(item => {
          const title = item.title || 'VIP Party Video';
          const videoId = item.youtubeId || '';
          const link = item.youtubeUrl || (videoId ? `https://www.youtube.com/watch?v=${encodeURIComponent(videoId)}` : '/gallery/video');
          const image = item.thumbnail || item.thumbnailUrl || item.coverImage || item.image || (videoId ? `https://img.youtube.com/vi/${encodeURIComponent(videoId)}/hqdefault.jpg` : '/images/event_rally.jpg');
          const duration = item.duration || '';
          const category = item.category || '';
          return `<article class="flex-none sm:flex-initial w-[82vw] max-w-[310px] sm:w-auto snap-start group bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col">
            <div class="relative overflow-hidden bg-gray-900" style="aspect-ratio:16/9">
              <img src="${escapeHtml(image)}" alt="${escapeHtml(title)}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.onerror=null;this.src='/images/event_rally.jpg'">
              <a href="${escapeHtml(link)}" target="_blank" rel="noopener noreferrer" aria-label="${escapeHtml(title)}" class="absolute inset-0 flex items-center justify-center">
                <span class="w-12 h-12 bg-white/95 rounded-full flex items-center justify-center text-red-600 shadow-lg group-hover:scale-110 transition-transform">
                  <i class="fa-solid fa-play ml-1"></i>
                </span>
              </a>
              ${category ? `<span class="absolute top-2 left-2 bg-red-600 text-white text-[10px] font-bold px-2 py-0.5 rounded flex items-center gap-1 shadow"><i class="fa-brands fa-youtube text-xs"></i> ${escapeHtml(category)}</span>` : ''}
              ${duration ? `<span class="absolute bottom-2 right-2 bg-black/80 text-white text-[10px] font-semibold px-1.5 py-0.5 rounded backdrop-blur-sm">${escapeHtml(duration)}</span>` : ''}
            </div>
            <div class="p-4 flex flex-col flex-1 justify-between">
              <h3 class="text-sm font-bold text-gray-900 mb-2 group-hover:text-primary transition-colors line-clamp-2">${escapeHtml(title)}</h3>
              <a href="${escapeHtml(link)}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-red-600 font-semibold hover:text-red-700 mt-auto">
                <i class="fa-solid fa-play text-[10px]"></i> वीडियो देखें
              </a>
            </div>
          </article>`;
        }).join('') : '<p class="col-span-full rounded-xl bg-gray-50 p-5 text-center text-gray-500">अभी कोई वीडियो उपलब्ध नहीं है।</p>';
      }).catch(error => {
        console.error('Homepage videos could not be loaded:', error);
        videoGrid.innerHTML = '<p class="col-span-full rounded-xl bg-gray-50 p-5 text-center text-gray-500">वीडियो अभी लोड नहीं हो सके।</p>';
      });

    })();

    // WOW.js Initialization & Viewport Animation Trigger (Only runs when scrolled into view)
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof WOW !== 'undefined') {
        new WOW({
          boxClass: 'wow',
          animateClass: 'animated',
          offset: 80,
          mobile: true,
          live: true
        }).init();
      }

      // Viewport scroll trigger fallback: ensures elements only animate when user scrolls to them
      const initScrollObserver = () => {
        const unhandled = document.querySelectorAll('.wow:not(.animated)');
        if (!unhandled.length) return;
        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const el = entry.target;
              const delay = el.getAttribute('data-wow-delay') || '0s';
              el.style.animationDelay = delay;
              el.classList.add('animated', 'in-view');
              el.style.visibility = 'visible';
              obs.unobserve(el);
            }
          });
        }, { rootMargin: '0px 0px -80px 0px', threshold: 0.1 });

        unhandled.forEach(el => observer.observe(el));
      };

      if (typeof WOW === 'undefined') {
        initScrollObserver();
      } else {
        setTimeout(initScrollObserver, 400);
      }
    });
  </script>

  <!-- WOW.js Library for Viewport Triggered Scroll Animations -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/wow/1.1.2/wow.min.js"></script>
</body>

</html>
