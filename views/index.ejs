        <article class="flex-none sm:flex-initial w-[82vw] max-w-[310px] sm:w-auto snap-start group bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col">
          <div class="relative bg-gray-900 overflow-hidden" style="aspect-ratio:16/9;">
            <div class="w-full h-full bg-gradient-to-tr from-amber-900 to-primary flex items-center justify-center">
              <i class="fa-solid fa-bullhorn text-white/50 text-4xl"></i>
            </div>
            <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="absolute inset-0 flex items-center justify-center">
              <div class="w-12 h-12 bg-white/95 rounded-full flex items-center justify-center text-red-600 shadow-lg group-hover:scale-110 transition-transform">
                <i class="fa-solid fa-play ml-1"></i>
              </div>
            </a>
