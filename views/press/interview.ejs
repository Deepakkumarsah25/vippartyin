<!doctype html>
<html lang="hi-IN">
<head>
  <meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>इंटरव्यू | VIP Party</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = { theme: { extend: {
    colors: { primary: { DEFAULT: '#0066b2', 50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd', 400: '#60a5fa', 500: '#0066b2', 600: '#004b87', 700: '#003a6c', 800: '#002e54', 900: '#001e38', 950: '#001426' }, secondary: { DEFAULT: '#004b87', hover: '#003a6c' }, accent: '#f0f7ff', dark: '#0f172a' },
    fontFamily: { sans: ['"Plus Jakarta Sans"', '"Noto Sans Devanagari"', 'Poppins', 'sans-serif'] }
  } }};
</script>
<link rel="stylesheet" href="/css/style.css">
  <style>
    :root { --press-primary: #0066b2; --press-hero-height: 190px; --press-hero-height-desktop: 235px; }
    .press-hero { background: linear-gradient(90deg, #001426 0%, var(--press-primary) 52%, #004b87 100%); }
    .press-hero-content { min-height: var(--press-hero-height); padding: 1.5rem 1.25rem; }
    .press-search { border: 2px solid #cbd5e1; box-shadow: 0 1px 2px rgb(15 23 42 / 8%); }
    .press-search::placeholder { color: #94a3b8; }
    .press-search:focus { border-color: var(--press-primary); box-shadow: 0 0 0 4px rgb(0 102 178 / 14%); }
    .press-chip { border: 2px solid #cbd5e1; background: #fff; color: #334155; }
    .press-chip:hover { border-color: var(--press-primary); background: #eff6ff; color: #004b87; }
    .press-chip.is-active { border-color: var(--press-primary); background: var(--press-primary); color: #fff; }
    .press-card { box-shadow: 0 12px 34px rgb(15 23 42 / 8%); }
    @media (min-width: 640px) { .press-hero-content { min-height: var(--press-hero-height-desktop); padding-top: 2rem; padding-bottom: 2rem; } }
  </style>
</head>
<body class="font-sans text-gray-700 bg-white antialiased">
  <%- include('../common/navbar') %>
  <main class="min-h-screen pb-20">
    <section class="press-hero text-white">
      <div class="press-hero-content mx-auto flex max-w-7xl items-center justify-center text-center">
        <div>
          <p class="mb-2 text-sm font-bold uppercase tracking-[.2em] text-blue-200">VIP Party</p>
          <h1 class="text-4xl font-black sm:text-6xl">इंटरव्यू</h1>
          <p class="mx-auto mt-3 max-w-2xl text-base text-blue-100 sm:text-lg">पार्टी के नेताओं और कार्यकर्ताओं के विचार सुनें।</p>
        </div>
      </div>
    </section>
    <section class="mx-auto max-w-7xl px-5 pb-12 pt-6 sm:pb-16 sm:pt-8">
      <div class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div id="press-categories" class="flex flex-wrap gap-2" aria-label="श्रेणी चुनें"></div>
        <label class="relative block w-full sm:w-72 lg:w-80"><span class="sr-only">खोजें</span><i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-500"></i><input id="press-search" type="search" placeholder="खोजें..." class="press-search w-full rounded-full bg-white py-3 pl-11 pr-4 outline-none transition"></label>
      </div>
      <div id="press-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" aria-live="polite"><div class="col-span-full rounded-2xl bg-white p-10 text-center text-slate-500">लोड हो रहा है...</div></div>
      <div id="press-empty" class="hidden rounded-2xl bg-white p-10 text-center text-slate-500">कोई सामग्री नहीं मिली।</div>
    </section>
  </main>
  <%- include('../common/footer') %>
  <script src="/js/i18n.js"></script>
  <script src="/js/main.js"></script>
  <script>
    (() => {
      const pageType = 'interview';
      const grid = document.getElementById('press-grid');
      const chips = document.getElementById('press-categories');
      const search = document.getElementById('press-search');
      const empty = document.getElementById('press-empty');
      let items = [];
      let category = 'all';
      const safe = value => String(value || '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
      const imageFor = item => item.coverImage || item.image || item.imageUrl || item.mediaUrl || item.cover || item.thumbnail || (item.images && item.images[0] && (item.images[0].url || item.images[0])) || (item.youtubeId ? `https://img.youtube.com/vi/${encodeURIComponent(item.youtubeId)}/hqdefault.jpg` : '/images/event_rally.jpg');
      const drawChips = () => {
        const values = ['all', ...new Set(items.map(item => item.category).filter(Boolean))];
        chips.innerHTML = values.map(value => `<button type="button" data-category="${safe(value)}" class="press-chip rounded-full px-4 py-2 text-sm font-bold transition ${value === category ? 'is-active' : ''}">${value === 'all' ? 'सभी' : safe(value)}</button>`).join('');
        chips.querySelectorAll('button').forEach(button => button.addEventListener('click', () => { category = button.dataset.category; drawChips(); drawItems(); }));
      };
      const drawItems = () => {
        const term = search.value.trim().toLowerCase();
        const visible = items.filter(item => (category === 'all' || item.category === category) && `${item.title || ''} ${item.description || ''} ${item.content || ''} ${item.category || ''}`.toLowerCase().includes(term));
        grid.innerHTML = visible.map((item, index) => {
          const image = imageFor(item);
          const dateValue = item.date || item.createdAt;
          const date = dateValue && !Number.isNaN(new Date(dateValue).getTime()) ? new Date(dateValue).toLocaleDateString('hi-IN', {day:'numeric',month:'long',year:'numeric'}) : '';
          const summary = item.description || item.content || '';
          const link = item.youtubeUrl || (item.youtubeId ? `https://www.youtube.com/watch?v=${encodeURIComponent(item.youtubeId)}` : '');
          return `<article class="press-card overflow-hidden rounded-2xl bg-white"><div class="aspect-[4/3] overflow-hidden bg-slate-100"><img src="${safe(image)}" alt="${safe(item.title)}" class="h-full w-full object-cover" loading="${index < 6 ? 'eager' : 'lazy'}" onerror="this.onerror=null;this.src='/images/event_rally.jpg'"></div><div class="p-5"><div class="mb-3 flex items-start justify-between gap-3"><h2 class="font-bold text-slate-900">${safe(item.title || 'VIP Party')}</h2><span class="shrink-0 rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">${safe(item.category || (pageType === 'interview' ? 'Interview' : 'News'))}</span></div>${summary ? `<p class="line-clamp-3 text-sm leading-6 text-slate-600">${safe(summary)}</p>` : ''}<div class="mt-4 flex items-center justify-between gap-3 text-xs text-slate-500">${date ? `<time>${date}</time>` : '<span></span>'}${link ? `<a href="${safe(link)}" target="_blank" rel="noopener noreferrer" class="font-bold text-primary hover:text-primary-700">वीडियो देखें <i class="fa-solid fa-arrow-up-right-from-square ml-1"></i></a>` : ''}</div></div></article>`;
        }).join('');
        empty.classList.toggle('hidden', visible.length > 0);
        grid.classList.toggle('hidden', visible.length === 0);
      };
      search.addEventListener('input', drawItems);
      const rows = <%- JSON.stringify(initialItems || []).replace(/</g, '\\u003c') %>;
      items = pageType === 'interview' ? rows.filter(item => String(item.category || '').toLowerCase() === 'interview') : rows;
      if (pageType === 'press-release') items = items.map(item => ({...item, category: item.category || 'Press Release'}));
      drawChips();
      drawItems();
    })();
  </script>
</body>
</html>






