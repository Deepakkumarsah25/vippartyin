<!doctype html>
<html lang="hi-IN">
<head>
  <meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>प्रेस विज्ञप्ति | VIP Party</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = { theme: { extend: {
    colors: { primary: { DEFAULT: '#0066b2', 50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd', 400: '#60a5fa', 500: '#0066b2', 600: '#004b87', 700: '#003a6c', 800: '#002e54', 900: '#001e38', 950: '#001426' }, secondary: { DEFAULT: '#004b87', hover: '#003a6c' }, accent: '#f0f7ff', dark: '#0f172a' },
    fontFamily: { sans: ['"Plus Jakarta Sans"', '"Noto Sans Devanagari"', 'Poppins', 'sans-serif'] }
  } }};
</script>
<link rel="stylesheet" href="/css/style.css">
  <style>
    :root { --press-primary: #0066b2; --press-hero-height: 190px; --press-hero-height-desktop: 235px; }
    .press-hero { background: linear-gradient(90deg, #001426 0%, var(--press-primary) 52%, #004b87 100%); }
    .press-hero-content { min-height: var(--press-hero-height); padding: 1.5rem 1.25rem; }
    .press-search { border: 2px solid #cbd5e1; box-shadow: 0 1px 2px rgb(15 23 42 / 8%); }
    .press-search::placeholder { color: #94a3b8; }
    .press-search:focus { border-color: var(--press-primary); box-shadow: 0 0 0 4px rgb(0 102 178 / 14%); }
    .press-chip { border: 2px solid #cbd5e1; background: #fff; color: #334155; }
    .press-chip:hover { border-color: var(--press-primary); background: #eff6ff; color: #004b87; }
    .press-chip.is-active { border-color: var(--press-primary); background: var(--press-primary); color: #fff; }
    .press-card { box-shadow: 0 12px 34px rgb(15 23 42 / 8%); }
    #photo-modal.hidden { display: none !important; }
    #photo-modal:not(.hidden) { display: flex !important; }
    @media (min-width: 640px) { .press-hero-content { min-height: var(--press-hero-height-desktop); padding-top: 2rem; padding-bottom: 2rem; } }
  </style>
</head>
<body class="font-sans text-gray-700 bg-white antialiased">
  <%- include('../common/navbar') %>
  <main class="min-h-screen pb-20">
    <section class="press-hero text-white">
      <div class="press-hero-content mx-auto flex max-w-7xl items-center justify-center text-center">
        <div>
          <p class="mb-2 text-sm font-bold uppercase tracking-[.2em] text-blue-200">VIP Party</p>
          <h1 class="text-4xl font-black sm:text-6xl">प्रेस विज्ञप्ति</h1>
          <p class="mx-auto mt-3 max-w-2xl text-base text-blue-100 sm:text-lg">पार्टी की आधिकारिक प्रेस विज्ञप्तियां एवं पत्र पढ़ें व देखें।</p>
        </div>
      </div>
    </section>
    <section class="mx-auto max-w-7xl px-5 pb-12 pt-6 sm:pb-16 sm:pt-8">
      <div class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div id="press-categories" class="flex flex-wrap gap-2" aria-label="श्रेणी चुनें"></div>
        <label class="relative block w-full sm:w-72 lg:w-80"><span class="sr-only">खोजें</span><i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-500"></i><input id="press-search" type="search" placeholder="खोजें..." class="press-search w-full rounded-full bg-white py-3 pl-11 pr-4 outline-none transition"></label>
      </div>
      <div id="press-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" aria-live="polite"><div class="col-span-full rounded-2xl bg-white p-10 text-center text-slate-500">लोड हो रहा है...</div></div>
      <div id="press-empty" class="hidden rounded-2xl bg-white p-10 text-center text-slate-500">कोई सामग्री नहीं मिली।</div>
    </section>

    <!-- Photo Preview Lightbox Modal -->
    <div id="photo-modal" class="fixed inset-0 z-[999] hidden items-center justify-center bg-black/92 p-2 sm:p-4 backdrop-blur-sm transition-opacity duration-200" role="dialog" aria-modal="true" aria-label="Press Release Photo Preview">
      
      <!-- Top Control Bar -->
      <div class="absolute top-0 inset-x-0 z-30 flex items-center justify-between p-3 sm:p-5 bg-gradient-to-b from-black/90 via-black/50 to-transparent text-white">
        <div class="flex items-center gap-2.5 max-w-[65%] sm:max-w-[75%]">
          <span class="rounded-full bg-primary px-3 py-1 text-xs font-bold text-white uppercase tracking-wider shrink-0 shadow-sm">प्रेस विज्ञप्ति</span>
          <h2 id="modal-title" class="text-sm sm:text-base font-bold truncate text-white drop-shadow"></h2>
        </div>
        <div class="flex items-center gap-2">
          <!-- Open original in new tab -->
          <a id="modal-external-link" href="#" target="_blank" rel="noopener noreferrer" title="मूल फोटो नए टैब में देखें" class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/15 hover:bg-white/30 flex items-center justify-center text-white transition-colors" aria-label="Open photo in new tab">
            <i class="fa-solid fa-arrow-up-right-from-square text-xs sm:text-sm"></i>
          </a>
          <!-- Download photo -->
          <a id="modal-download-link" href="#" download target="_blank" title="फोटो डाउनलोड करें" class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/15 hover:bg-white/30 flex items-center justify-center text-white transition-colors" aria-label="Download photo">
            <i class="fa-solid fa-download text-xs sm:text-sm"></i>
          </a>
          <!-- Close button -->
          <button id="modal-close" type="button" title="बंद करें (Esc)" class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/15 hover:bg-red-600 flex items-center justify-center text-white transition-colors" aria-label="Close modal">
            <i class="fa-solid fa-xmark text-lg"></i>
          </button>
        </div>
      </div>

      <!-- Navigation Arrows -->
      <button id="modal-prev" type="button" title="पिछली फोटो (Left Arrow)" class="absolute left-2 sm:left-5 top-1/2 -translate-y-1/2 z-30 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white/20 hover:bg-primary text-white flex items-center justify-center transition-all active:scale-95 shadow-xl border border-white/25" aria-label="Previous photo">
        <i class="fa-solid fa-chevron-left text-base sm:text-lg"></i>
      </button>

      <!-- Center Photo Display -->
      <div id="modal-image-wrap" class="relative max-h-[82vh] max-w-[94vw] sm:max-w-[85vw] flex flex-col items-center justify-center select-none z-20">
        <img id="modal-img" src="" alt="Press Release Photo" class="max-h-[72vh] sm:max-h-[78vh] w-auto max-w-full rounded-xl object-contain shadow-2xl transition-all duration-200">
        <div id="modal-caption-wrap" class="mt-2.5 flex items-center justify-center gap-3 text-xs sm:text-sm text-slate-200 text-center max-w-xl px-4 drop-shadow">
          <span id="modal-caption" class="font-medium truncate"></span>
          <span id="modal-date" class="text-slate-400 shrink-0"></span>
        </div>
      </div>

      <button id="modal-next" type="button" title="अगली फोटो (Right Arrow)" class="absolute right-2 sm:right-5 top-1/2 -translate-y-1/2 z-30 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white/20 hover:bg-primary text-white flex items-center justify-center transition-all active:scale-95 shadow-xl border border-white/25" aria-label="Next photo">
        <i class="fa-solid fa-chevron-right text-base sm:text-lg"></i>
      </button>

      <!-- Bottom Counter Indicator -->
      <div class="absolute bottom-3 inset-x-0 z-30 flex flex-col items-center gap-2 pointer-events-none">
        <span id="modal-counter" class="bg-black/70 px-3.5 py-1 rounded-full backdrop-blur-sm border border-white/15 text-xs text-white/90 font-medium shadow-md"></span>
      </div>

    </div>
  </main>
  <%- include('../common/footer') %>
  <script src="/js/i18n.js"></script>
  <script src="/js/main.js"></script>
  <script>
    (() => {
      const pageType = 'press-release';
      const grid = document.getElementById('press-grid');
      const chips = document.getElementById('press-categories');
      const search = document.getElementById('press-search');
      const empty = document.getElementById('press-empty');

      // Modal elements
      const modal = document.getElementById('photo-modal');
      const modalImg = document.getElementById('modal-img');
      const modalTitle = document.getElementById('modal-title');
      const modalCaption = document.getElementById('modal-caption');
      const modalDate = document.getElementById('modal-date');
      const modalCounter = document.getElementById('modal-counter');
      const modalLink = document.getElementById('modal-external-link');
      const modalDownload = document.getElementById('modal-download-link');
      const modalClose = document.getElementById('modal-close');
      const modalPrev = document.getElementById('modal-prev');
      const modalNext = document.getElementById('modal-next');

      let items = [];
      let currentVisible = [];
      let currentIndex = 0;
      let category = 'all';

      const safe = value => String(value || '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
      const imageFor = item => item.coverImage || item.image || item.imageUrl || item.mediaUrl || item.cover || item.thumbnail || (item.images && item.images[0] && (item.images[0].url || item.images[0])) || (item.youtubeId ? `https://img.youtube.com/vi/${encodeURIComponent(item.youtubeId)}/hqdefault.jpg` : '/images/event_rally.jpg');

      const updateModalPhoto = (index) => {
        if (!currentVisible.length) return;
        if (index < 0) index = currentVisible.length - 1;
        if (index >= currentVisible.length) index = 0;
        currentIndex = index;

        const item = currentVisible[currentIndex];
        const image = imageFor(item);
        const dateValue = item.date || item.createdAt;
        const date = dateValue && !Number.isNaN(new Date(dateValue).getTime()) ? new Date(dateValue).toLocaleDateString('hi-IN', {day:'numeric',month:'long',year:'numeric'}) : '';

        modalImg.src = image;
        modalImg.alt = item.title || 'Press Release Photo';
        modalTitle.textContent = item.title || 'प्रेस विज्ञप्ति';
        modalCaption.textContent = item.title || '';
        modalDate.textContent = date ? `(${date})` : '';
        modalCounter.textContent = `${currentIndex + 1} / ${currentVisible.length}`;

        modalLink.href = image;
        modalDownload.href = image;
      };

      const openModal = (index) => {
        updateModalPhoto(index);
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      };

      const closeModal = () => {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      };

      modalClose.addEventListener('click', closeModal);
      modalPrev.addEventListener('click', () => updateModalPhoto(currentIndex - 1));
      modalNext.addEventListener('click', () => updateModalPhoto(currentIndex + 1));

      modal.addEventListener('click', (e) => {
        if (e.target === modal || e.target.id === 'modal-image-wrap') closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if (modal.classList.contains('hidden')) return;
        if (e.key === 'Escape') closeModal();
        else if (e.key === 'ArrowLeft') updateModalPhoto(currentIndex - 1);
        else if (e.key === 'ArrowRight') updateModalPhoto(currentIndex + 1);
      });

      const drawChips = () => {
        const categories = [...new Set(items.map(item => item.category).filter(Boolean))];
        const values = ['all', ...categories];
        chips.innerHTML = values.map(value => {
          let label = value === 'all' ? 'सभी' : (value === 'pressrelease' || value === 'Press Release' ? 'प्रेस विज्ञप्ति' : safe(value));
          return `<button type="button" data-category="${safe(value)}" class="press-chip rounded-full px-4 py-2 text-sm font-bold transition ${value === category ? 'is-active' : ''}">${label}</button>`;
        }).join('');
        chips.querySelectorAll('button').forEach(button => button.addEventListener('click', () => { category = button.dataset.category; drawChips(); drawItems(); }));
      };

      const drawItems = () => {
        const term = search.value.trim().toLowerCase();
        currentVisible = items.filter(item => (category === 'all' || item.category === category) && `${item.title || ''} ${item.description || ''} ${item.content || ''} ${item.category || ''}`.toLowerCase().includes(term));
        
        grid.innerHTML = currentVisible.map((item, index) => {
          const image = imageFor(item);
          const dateValue = item.date || item.createdAt;
          const date = dateValue && !Number.isNaN(new Date(dateValue).getTime()) ? new Date(dateValue).toLocaleDateString('hi-IN', {day:'numeric',month:'long',year:'numeric'}) : '';
          const summary = item.description || item.content || '';

          return `
            <article data-index="${index}" role="button" tabindex="0" class="press-release-card press-card group flex flex-col overflow-hidden rounded-2xl bg-white border border-slate-200/90 hover:border-primary/40 shadow-sm hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1.5 cursor-pointer select-none">
              <div class="aspect-[4/3] relative overflow-hidden bg-slate-100 flex-shrink-0">
                <img src="${safe(image)}" alt="${safe(item.title)}" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.onerror=null;this.src='/images/event_rally.jpg'">
                
                <!-- Hover magnifying overlay -->
                <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                  <span class="w-12 h-12 rounded-full bg-white text-primary shadow-xl flex items-center justify-center transform scale-90 group-hover:scale-100 transition-transform duration-300">
                    <i class="fa-solid fa-magnifying-glass-plus text-lg"></i>
                  </span>
                </div>

                <span class="absolute top-2.5 left-2.5 bg-primary text-white text-[10px] sm:text-[11px] font-bold px-2.5 py-0.5 rounded-full flex items-center gap-1 shadow-md">
                  <i class="fa-solid fa-bullhorn text-xs"></i> प्रेस विज्ञप्ति
                </span>
              </div>
              <div class="p-5 flex flex-col justify-between flex-1">
                <div>
                  <h2 class="font-bold text-slate-900 group-hover:text-primary transition-colors text-base sm:text-lg line-clamp-2 leading-snug mb-2">
                    ${safe(item.title || 'VIP Party प्रेस विज्ञप्ति')}
                  </h2>
                  ${summary ? `<p class="line-clamp-2 text-xs sm:text-sm leading-relaxed text-slate-600 mb-3">${safe(summary)}</p>` : ''}
                </div>
                <div class="mt-4 flex items-center justify-between gap-3 text-xs text-slate-500 pt-3 border-t border-slate-100">
                  ${date ? `<time class="flex items-center gap-1.5 font-medium"><i class="fa-regular fa-calendar-alt text-slate-400"></i>${date}</time>` : '<span></span>'}
                  <span class="font-bold text-primary flex items-center gap-1.5 group-hover:translate-x-1 transition-transform">
                    <i class="fa-solid fa-expand text-[11px]"></i> फोटो देखें
                  </span>
                </div>
              </div>
            </article>
          `;
        }).join('');

        grid.querySelectorAll('.press-release-card').forEach(card => {
          const idx = parseInt(card.dataset.index, 10);
          const handleOpen = () => openModal(idx);
          card.addEventListener('click', handleOpen);
          card.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              handleOpen();
            }
          });
        });

        empty.classList.toggle('hidden', currentVisible.length > 0);
        grid.classList.toggle('hidden', currentVisible.length === 0);
      };

      search.addEventListener('input', drawItems);
      const rows = <%- JSON.stringify(initialItems || []).replace(/</g, '\\u003c') %>;
      if (Array.isArray(rows) && rows.length > 0) {
        items = rows.map(item => ({...item, category: item.category || 'Press Release'}));
        drawChips();
        drawItems();
      } else {
        const url = '/api/press/releases';
        fetch(url).then(response => { if (!response.ok) throw new Error('Press content request failed'); return response.json(); }).then(result => {
          const apiRows = Array.isArray(result) ? result : (result.data || result.news || result.media || result.videos || []);
          items = apiRows.map(item => ({...item, category: item.category || 'Press Release'}));
          drawChips(); drawItems();
        }).catch(() => { grid.innerHTML = '<div class="col-span-full rounded-2xl bg-white p-10 text-center text-slate-500">अभी सामग्री लोड नहीं हो सकी। कृपया बाद में फिर प्रयास करें।</div>'; });
      }
    })();
  </script>
</body>
</html>






