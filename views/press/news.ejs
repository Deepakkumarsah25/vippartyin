<!doctype html>
<html lang="hi-IN">
<head>
  <meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ताज़ा VIP समाचार | VIP Party</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = { theme: { extend: {
    colors: { primary: { DEFAULT: '#0066b2', 50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd', 400: '#60a5fa', 500: '#0066b2', 600: '#004b87', 700: '#003a6c', 800: '#002e54', 900: '#001e38', 950: '#001426' }, secondary: { DEFAULT: '#004b87', hover: '#003a6c' }, accent: '#f0f7ff', dark: '#0f172a' },
    fontFamily: { sans: ['"Plus Jakarta Sans"', '"Noto Sans Devanagari"', 'Poppins', 'sans-serif'] }
  } }};
</script>
<link rel="stylesheet" href="/css/style.css">
  <style>
    :root { --press-primary: #0066b2; --press-hero-height: 190px; --press-hero-height-desktop: 235px; }
    .press-hero { background: linear-gradient(90deg, #001426 0%, var(--press-primary) 52%, #004b87 100%); }
    .press-hero-content { min-height: var(--press-hero-height); padding: 1.5rem 1.25rem; }
    .press-search { border: 2px solid #cbd5e1; box-shadow: 0 1px 2px rgb(15 23 42 / 8%); }
    .press-search::placeholder { color: #94a3b8; }
    .press-search:focus { border-color: var(--press-primary); box-shadow: 0 0 0 4px rgb(0 102 178 / 14%); }
    .press-chip { border: 2px solid #cbd5e1; background: #fff; color: #334155; }
    .press-chip:hover { border-color: var(--press-primary); background: #eff6ff; color: #004b87; }
    .press-chip.is-active { border-color: var(--press-primary); background: var(--press-primary); color: #fff; }
    .press-card { box-shadow: 0 12px 34px rgb(15 23 42 / 8%); }
    @media (min-width: 640px) { .press-hero-content { min-height: var(--press-hero-height-desktop); padding-top: 2rem; padding-bottom: 2rem; } }
  </style>
</head>
<body class="font-sans text-gray-700 bg-white antialiased">
  <%- include('../common/navbar') %>
  <main class="min-h-screen pb-20">
    <section class="press-hero text-white">
      <div class="press-hero-content mx-auto flex max-w-7xl items-center justify-center text-center">
        <div>
          <p class="mb-2 text-sm font-bold uppercase tracking-[.2em] text-blue-200">VIP Party</p>
          <h1 class="text-4xl font-black sm:text-6xl">ताज़ा समाचार</h1>
          <p class="mx-auto mt-3 max-w-2xl text-base text-blue-100 sm:text-lg">पार्टी की ताज़ा गतिविधियों और समाचारों से जुड़े रहें।</p>
        </div>
      </div>
    </section>
    <section class="mx-auto max-w-7xl px-5 pb-12 pt-6 sm:pb-16 sm:pt-8">
      <div class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div id="press-categories" class="flex flex-wrap gap-2" aria-label="श्रेणी चुनें"></div>
        <label class="relative block w-full sm:w-72 lg:w-80"><span class="sr-only">खोजें</span><i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-500"></i><input id="press-search" type="search" placeholder="खोजें..." class="press-search w-full rounded-full bg-white py-3 pl-11 pr-4 outline-none transition"></label>
      </div>
      <div id="press-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" aria-live="polite"><div class="col-span-full rounded-2xl bg-white p-10 text-center text-slate-500">लोड हो रहा है...</div></div>
      <div id="press-empty" class="hidden rounded-2xl bg-white p-10 text-center text-slate-500">कोई सामग्री नहीं मिली।</div>
    </section>

    <!-- News Article Detail Modal -->
    <div id="news-modal" class="fixed inset-0 z-[999] hidden items-center justify-center bg-black/80 p-3 sm:p-5 backdrop-blur-sm" role="dialog" aria-modal="true">
      <div class="relative w-full max-w-3xl max-h-[90vh] bg-white rounded-2xl shadow-2xl overflow-hidden flex flex-col">
        <div class="flex items-center justify-between p-4 sm:p-5 border-b border-slate-100 bg-slate-50/60">
          <div class="flex items-center gap-2">
            <span id="news-modal-category" class="rounded-full bg-blue-100 px-3 py-1 text-xs font-bold text-primary uppercase">समाचार</span>
            <span id="news-modal-date" class="text-xs text-slate-500 font-medium"></span>
          </div>
          <button id="news-modal-close" type="button" title="बंद करें (Esc)" class="w-9 h-9 rounded-full bg-slate-200/80 hover:bg-red-600 hover:text-white flex items-center justify-center text-slate-600 transition-colors">
            <i class="fa-solid fa-xmark text-lg"></i>
          </button>
        </div>
        <div class="overflow-y-auto p-5 sm:p-6 space-y-4">
          <div id="news-modal-image-wrap" class="rounded-xl overflow-hidden bg-slate-100 max-h-80 sm:max-h-96">
            <img id="news-modal-image" src="" alt="News Image" class="w-full h-full object-contain mx-auto">
          </div>
          <h2 id="news-modal-title" class="text-xl sm:text-2xl font-black text-slate-900 leading-snug"></h2>
          <div id="news-modal-content" class="text-slate-700 leading-relaxed text-sm sm:text-base whitespace-pre-line space-y-3"></div>
          <div id="news-modal-video-link-wrap" class="pt-2 hidden">
            <a id="news-modal-video-link" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white font-bold px-5 py-2.5 rounded-full text-sm transition shadow-md">
              <i class="fa-brands fa-youtube text-base"></i> YouTube पर पूरा वीडियो देखें
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
  <%- include('../common/footer') %>
  <script src="/js/i18n.js"></script>
  <script src="/js/main.js"></script>
  <script>
    (() => {
      const pageType = 'news';
      const grid = document.getElementById('press-grid');
      const chips = document.getElementById('press-categories');
      const search = document.getElementById('press-search');
      const empty = document.getElementById('press-empty');

      // Modal elements
      const modal = document.getElementById('news-modal');
      const modalClose = document.getElementById('news-modal-close');
      const modalTitle = document.getElementById('news-modal-title');
      const modalDate = document.getElementById('news-modal-date');
      const modalCategory = document.getElementById('news-modal-category');
      const modalImage = document.getElementById('news-modal-image');
      const modalImageWrap = document.getElementById('news-modal-image-wrap');
      const modalContent = document.getElementById('news-modal-content');
      const modalVideoWrap = document.getElementById('news-modal-video-link-wrap');
      const modalVideoLink = document.getElementById('news-modal-video-link');

      let items = [];
      let currentVisible = [];
      let category = 'all';

      const safe = value => String(value || '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
      const imageFor = item => item.coverImage || item.image || item.imageUrl || item.mediaUrl || item.cover || item.thumbnail || (item.images && item.images[0] && (item.images[0].url || item.images[0])) || (item.youtubeId ? `https://img.youtube.com/vi/${encodeURIComponent(item.youtubeId)}/hqdefault.jpg` : '/images/event_rally.jpg');

      const openModal = (item) => {
        const image = imageFor(item);
        const dateValue = item.date || item.createdAt;
        const date = dateValue && !Number.isNaN(new Date(dateValue).getTime()) ? new Date(dateValue).toLocaleDateString('hi-IN', {day:'numeric',month:'long',year:'numeric'}) : '';
        const link = item.youtubeUrl || (item.youtubeId ? `https://www.youtube.com/watch?v=${encodeURIComponent(item.youtubeId)}` : '');

        modalTitle.textContent = item.title || 'VIP Party';
        modalDate.textContent = date ? `प्रकाशित: ${date}` : '';
        modalCategory.textContent = item.category || 'समाचार';
        
        if (image && !image.includes('event_rally.jpg')) {
          modalImage.src = image;
          modalImageWrap.classList.remove('hidden');
        } else {
          modalImageWrap.classList.add('hidden');
        }

        const fullText = (item.content || '') + (item.content && item.description ? '\n\n' : '') + (item.description || '');
        modalContent.textContent = fullText || 'कोई विस्तृत विवरण उपलब्ध नहीं है।';

        if (link) {
          modalVideoLink.href = link;
          modalVideoWrap.classList.remove('hidden');
        } else {
          modalVideoWrap.classList.add('hidden');
        }

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      };

      const closeModal = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
      };

      modalClose.addEventListener('click', closeModal);
      modal.addEventListener('click', e => {
        if (e.target === modal) closeModal();
      });
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
      });

      const drawChips = () => {
        const values = ['all', ...new Set(items.map(item => item.category).filter(Boolean))];
        chips.innerHTML = values.map(value => `<button type="button" data-category="${safe(value)}" class="press-chip rounded-full px-4 py-2 text-sm font-bold transition ${value === category ? 'is-active' : ''}">${value === 'all' ? 'सभी' : safe(value)}</button>`).join('');
        chips.querySelectorAll('button').forEach(button => button.addEventListener('click', () => { category = button.dataset.category; drawChips(); drawItems(); }));
      };

      const drawItems = () => {
        const term = search.value.trim().toLowerCase();
        currentVisible = items.filter(item => (category === 'all' || item.category === category) && `${item.title || ''} ${item.description || ''} ${item.content || ''} ${item.category || ''}`.toLowerCase().includes(term));
        
        grid.innerHTML = currentVisible.map((item, index) => {
          const image = imageFor(item);
          const dateValue = item.date || item.createdAt;
          const date = dateValue && !Number.isNaN(new Date(dateValue).getTime()) ? new Date(dateValue).toLocaleDateString('hi-IN', {day:'numeric',month:'long',year:'numeric'}) : '';
          const summary = item.description || item.content || '';
          const isVideo = Boolean(item.youtubeUrl || item.youtubeId || item.videoType === 'youtube');
          const link = item.youtubeUrl || (item.youtubeId ? `https://www.youtube.com/watch?v=${encodeURIComponent(item.youtubeId)}` : '');

          if (link) {
            return `
              <a href="${safe(link)}" target="_blank" rel="noopener noreferrer" class="press-card group flex flex-col overflow-hidden rounded-2xl bg-white border border-slate-200/90 hover:border-primary/40 shadow-sm hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1.5 cursor-pointer text-inherit no-underline">
                <div class="aspect-[16/10] relative overflow-hidden bg-slate-900 flex-shrink-0">
                  <img src="${safe(image)}" alt="${safe(item.title)}" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.onerror=null;this.src='/images/event_rally.jpg'">
                  <div class="absolute inset-0 bg-black/25 group-hover:bg-black/40 transition-all flex items-center justify-center">
                    <span class="w-12 h-12 bg-red-600 text-white rounded-full flex items-center justify-center shadow-2xl group-hover:scale-110 group-hover:bg-red-700 transition-all duration-300">
                      <i class="fa-solid fa-play ml-1 text-base"></i>
                    </span>
                  </div>
                  <span class="absolute top-2.5 left-2.5 bg-red-600 text-white text-[10px] sm:text-[11px] font-bold px-2.5 py-0.5 rounded-full flex items-center gap-1 shadow-md">
                    <i class="fa-brands fa-youtube text-xs"></i> वीडियो
                  </span>
                </div>
                <div class="p-5 flex flex-col justify-between flex-1">
                  <div>
                    <div class="mb-2 flex items-start justify-between gap-2">
                      <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-bold text-primary uppercase">${safe(item.category || 'समाचार')}</span>
                    </div>
                    <h2 class="font-bold text-slate-900 group-hover:text-primary transition-colors text-base sm:text-lg line-clamp-2 leading-snug mb-2">
                      ${safe(item.title || 'VIP Party')}
                    </h2>
                    ${summary ? `<p class="line-clamp-2 text-xs sm:text-sm leading-relaxed text-slate-600 mb-3">${safe(summary)}</p>` : ''}
                  </div>
                  <div class="mt-4 flex items-center justify-between gap-3 text-xs text-slate-500 pt-3 border-t border-slate-100">
                    ${date ? `<time class="flex items-center gap-1.5 font-medium"><i class="fa-regular fa-calendar-alt text-slate-400"></i>${date}</time>` : '<span></span>'}
                    <span class="font-bold text-primary flex items-center gap-1.5 group-hover:translate-x-1 transition-transform">
                      वीडियो देखें <i class="fa-solid fa-arrow-up-right-from-square text-[11px]"></i>
                    </span>
                  </div>
                </div>
              </a>
            `;
          }

          return `
            <div role="button" tabindex="0" data-index="${index}" class="news-card-trigger press-card group flex flex-col overflow-hidden rounded-2xl bg-white border border-slate-200/90 hover:border-primary/40 shadow-sm hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1.5 cursor-pointer text-inherit">
              <div class="aspect-[16/10] relative overflow-hidden bg-slate-100 flex-shrink-0">
                <img src="${safe(image)}" alt="${safe(item.title)}" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.onerror=null;this.src='/images/event_rally.jpg'">
                <span class="absolute top-2.5 left-2.5 bg-primary text-white text-[10px] sm:text-[11px] font-bold px-2.5 py-0.5 rounded-full flex items-center gap-1 shadow-md">
                  <i class="fa-regular fa-newspaper text-xs"></i> समाचार
                </span>
              </div>
              <div class="p-5 flex flex-col justify-between flex-1">
                <div>
                  <div class="mb-2 flex items-start justify-between gap-2">
                    <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-bold text-primary uppercase">${safe(item.category || 'समाचार')}</span>
                  </div>
                  <h2 class="font-bold text-slate-900 group-hover:text-primary transition-colors text-base sm:text-lg line-clamp-2 leading-snug mb-2">
                    ${safe(item.title || 'VIP Party')}
                  </h2>
                  ${summary ? `<p class="line-clamp-2 text-xs sm:text-sm leading-relaxed text-slate-600 mb-3">${safe(summary)}</p>` : ''}
                </div>
                <div class="mt-4 flex items-center justify-between gap-3 text-xs text-slate-500 pt-3 border-t border-slate-100">
                  ${date ? `<time class="flex items-center gap-1.5 font-medium"><i class="fa-regular fa-calendar-alt text-slate-400"></i>${date}</time>` : '<span></span>'}
                  <span class="font-bold text-primary flex items-center gap-1.5 group-hover:translate-x-1 transition-transform">
                    और पढ़ें <i class="fa-solid fa-arrow-right text-[11px]"></i>
                  </span>
                </div>
              </div>
            </div>
          `;
        }).join('');

        // Attach click listener to non-link news cards
        grid.querySelectorAll('.news-card-trigger').forEach(card => {
          const idx = parseInt(card.dataset.index, 10);
          const handleOpen = () => {
            if (currentVisible[idx]) openModal(currentVisible[idx]);
          };
          card.addEventListener('click', handleOpen);
          card.addEventListener('keydown', e => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              handleOpen();
            }
          });
        });

        empty.classList.toggle('hidden', currentVisible.length > 0);
        grid.classList.toggle('hidden', currentVisible.length === 0);
      };

      search.addEventListener('input', drawItems);
      const url = '/api/press/news?limit=50';
      fetch(url).then(response => { if (!response.ok) throw new Error('Press content request failed'); return response.json(); }).then(result => {
        const rows = Array.isArray(result) ? result : (result.data || result.news || result.media || result.videos || []);
        items = rows;
        drawChips(); drawItems();
      }).catch(() => { grid.innerHTML = '<div class="col-span-full rounded-2xl bg-white p-10 text-center text-slate-500">अभी सामग्री लोड नहीं हो सकी। कृपया बाद में फिर प्रयास करें।</div>'; });
    })();
  </script>
  </script>
</body>
</html>






