  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : 'निषाद विकास संघ (NVS) | विकासशील इंसान पार्टी' %>">
  <meta property="og:description" content="निषाद विकास संघ (NVS) - निषादों के सामाजिक, शैक्षिक, आर्थिक और राजनीतिक उत्थान को समर्पित क्रांतिकारी संगठन।">
  <meta property="og:image" content="/images/vip-logo.svg">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/vip-logo.svg">
  <link rel="shortcut icon" type="image/svg+xml" href="/images/vip-logo.svg">
  <link rel="apple-touch-icon" href="/images/vip-logo.svg">

  <!-- Google Fonts: Plus Jakarta Sans, Noto Sans Devanagari & Poppins -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- FontAwesome 6 Free Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Tailwind CSS CDN Configured with VIP Colors -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              DEFAULT: '#0066b2',
              50: '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#0066b2',
              600: '#004b87',
              700: '#003a6c',
              800: '#002e54',
              900: '#001e38',
              950: '#001426',
            },
            secondary: {
              DEFAULT: '#004b87',
              hover: '#003a6c',
            },
            accent: '#f0f7ff',
            dark: '#0f172a'
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '"Noto Sans Devanagari"', 'Poppins', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Custom VIP Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="font-sans text-gray-700 bg-white antialiased">

  <!-- 1. Header & Navigation (Shared Component) -->
  <%- include('common/navbar') %>

  <!-- ========================================================
       HERO BANNER & BREADCRUMBS
       ======================================================== -->
  <section class="bg-gradient-to-r from-primary-950 via-primary-900 to-primary-800 text-white py-12 sm:py-16 relative overflow-hidden border-b border-primary-700/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="flex items-center space-x-2 text-xs sm:text-sm text-blue-200">
          <li>
            <a href="/" class="hover:text-white transition-colors flex items-center gap-1.5">
              <i class="fa-solid fa-house text-[11px]"></i>
              <span data-i18n="nav.home">होम</span>
            </a>
          </li>
          <li class="text-blue-400">/</li>
          <li class="text-blue-200">
            <span data-i18n="nav.about">हमारे बारे में</span>
          </li>
          <li class="text-blue-400">/</li>
          <li class="text-amber-300 font-bold" aria-current="page">
            <span data-i18n="nav.nvs">(NVS) निषाद विकास संघ</span>
          </li>
        </ol>
      </nav>

      <!-- Badge & Title -->
      <div class="max-w-4xl">
        <span class="inline-block bg-amber-400 text-gray-950 font-black text-xs px-3.5 py-1 rounded-full uppercase tracking-wider mb-3">
          ★ सामाजिक क्रांति, एकता एवं आरक्षण आंदोलन का ऐतिहासिक संगठन
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-3">
          <%= (typeof page !== 'undefined' && page && page.title) ? page.title : 'निषाद विकास संघ (NVS)' %>
        </h1>
        <p class="text-blue-100 text-sm sm:text-base lg:text-lg max-w-3xl leading-relaxed">
          <%= (typeof page !== 'undefined' && page && page.introText && page.introText.trim() !== '') 
                ? page.introText 
                : 'निषाद, मल्लाह, मछुआरा तथा पारंपरिक जल-आधारित समुदायों के सामाजिक, शैक्षिक, आर्थिक और राजनीतिक उत्थान को समर्पित क्रांतिकारी संगठन।' %>
        </p>
      </div>

    </div>
  </section>

  <!-- ========================================================
       QUICK FACTS & ORIGIN STRIP (4 METRICS)
       ======================================================== -->
  <div class="relative z-20 -mt-6 sm:-mt-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
    <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-5 sm:p-6 grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 divide-y sm:divide-y-0 sm:divide-x divide-gray-100">
      
      <!-- 1. स्थापना -->
      <div class="flex items-center gap-3.5 pt-2 sm:pt-0">
        <div class="w-12 h-12 rounded-xl bg-blue-50 text-primary flex items-center justify-center flex-shrink-0 text-xl font-bold shadow-sm">
          <i class="fa-solid fa-flag"></i>
        </div>
        <div>
          <span class="text-[11px] sm:text-xs font-bold text-gray-500 uppercase tracking-wider block">स्थापना वर्ष</span>
          <p class="text-sm sm:text-base font-extrabold text-gray-900 tracking-tight">वर्ष 2010</p>
          <span class="text-[10px] text-primary font-semibold block">सन ऑफ मल्लाह द्वारा</span>
        </div>
      </div>

      <!-- 2. संस्थापक -->
      <div class="flex items-center gap-3.5 pt-2 sm:pt-0 sm:pl-6">
        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center flex-shrink-0 text-xl font-bold shadow-sm">
          <i class="fa-solid fa-user-tie"></i>
        </div>
        <div>
          <span class="text-[11px] sm:text-xs font-bold text-gray-500 uppercase tracking-wider block">संस्थापक एवं अध्यक्ष</span>
          <p class="text-sm sm:text-base font-extrabold text-gray-900 tracking-tight">श्री मुकेश सहनी</p>
          <span class="text-[10px] text-gray-600 block">राष्ट्रीय अध्यक्ष, NVS</span>
        </div>
      </div>

      <!-- 3. ऐतिहासिक आंदोलन -->
      <div class="flex items-center gap-3.5 pt-2 sm:pt-0 sm:pl-6">
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0 text-xl font-bold shadow-sm">
          <i class="fa-solid fa-hand-fist"></i>
        </div>
        <div>
          <span class="text-[11px] sm:text-xs font-bold text-gray-500 uppercase tracking-wider block">ऐतिहासिक आंदोलन</span>
          <p class="text-sm sm:text-base font-extrabold text-gray-900 tracking-tight">'निषाद क्रांति'</p>
          <span class="text-[10px] text-emerald-700 font-semibold block">बिहार व उत्तर प्रदेश</span>
        </div>
      </div>

      <!-- 4. मूल उद्देश्य -->
      <div class="flex items-center gap-3.5 pt-2 sm:pt-0 sm:pl-6">
        <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center flex-shrink-0 text-xl font-bold shadow-sm">
          <i class="fa-solid fa-scale-balanced"></i>
        </div>
        <div>
          <span class="text-[11px] sm:text-xs font-bold text-gray-500 uppercase tracking-wider block">मूल अधिकार</span>
          <p class="text-sm sm:text-base font-extrabold text-gray-900 tracking-tight">निषाद आरक्षण व आयोग</p>
          <span class="text-[10px] text-purple-700 font-semibold block">राजनीतिक हिस्सेदारी</span>
        </div>
      </div>

    </div>
  </div>

  <!-- ========================================================
       SECTION 1: THE REVOLUTIONARY STORY & HISTORY (CMS SECTIONS 1-4)
       ======================================================== -->
  <% 
    const allSections = (typeof page !== 'undefined' && page && page.sections) ? page.sections : [];
    
    // Devanagari & Latin digit regex for list points
    const listPointRegex = /^[\d\u0966-\u09EF]+[\.\)]/;

    // Narrative sections (early history sections)
    const narrativeSections = allSections.filter((s) => {
      return s.description && !listPointRegex.test(s.description.trim());
    });

    // Objective / Points sections (all 23 points)
    const objectiveSections = allSections.filter(s => {
      return s.description && listPointRegex.test(s.description.trim());
    });

    // Heading section if present
    const mainHeadingSec = allSections.find(s => s.heading && s.heading.includes('कार्य, उद्देश्य तथा विचारधारा'));
    const supplementalSections = allSections.filter(s => !narrativeSections.includes(s) && !objectiveSections.includes(s) && (s.heading || s.description || s.image));
  %>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
    
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <span class="inline-block bg-primary-50 text-primary font-bold text-xs px-3.5 py-1 rounded-full uppercase tracking-wider mb-2">
        क्रांति से चेतना तक
      </span>
      <h2 class="text-2xl sm:text-4xl font-black text-gray-900 tracking-tight">
        निषाद विकास संघ का ऐतिहासिक संघर्ष
      </h2>
      <p class="text-gray-600 text-xs sm:text-sm mt-2">
        हक, अधिकार, आरक्षण और राजनीतिक स्वाभिमान की ऐतिहासिक यात्रा
      </p>
      <div class="w-16 h-1.5 bg-amber-400 mx-auto mt-3 rounded-full"></div>
    </div>

    <!-- Narrative Chapters -->
    <div class="space-y-12 sm:space-y-16">
      <% narrativeSections.forEach((sec, idx) => { 
           const hasImage = Boolean(sec.image && sec.image.trim() !== '');
           const paragraphs = sec.description.split(/\r?\n/).filter(line => line.trim().length > 0);
      %>
        
        <% if (idx === 0) { %>
          <!-- ==============================================
               HISTORICAL CHAPTER #01: FOUNDATION (2010)
               ============================================== -->
          <div class="bg-white rounded-3xl p-6 sm:p-10 shadow-sm border border-gray-100 hover:shadow-md transition-all">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
              
              <!-- Image Column -->
              <div class="lg:col-span-5 lg:order-1">
                <div class="rounded-2xl overflow-hidden shadow-md aspect-[4/3] bg-slate-900 border border-gray-100 group relative">
                  <img 
                    src="<%= sec.image %>" 
                    alt="निषाद विकास संघ स्थापना" 
                    class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  <div class="absolute bottom-3 left-3 bg-primary/90 backdrop-blur-sm text-white text-xs font-bold px-3 py-1 rounded-lg">
                    <i class="fa-solid fa-flag text-amber-300 mr-1.5"></i> स्थापना: वर्ष 2010
                  </div>
                </div>
              </div>

              <!-- Content Column -->
              <div class="lg:col-span-7 lg:order-2">
                <div class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-primary mb-3 bg-blue-50 px-3.5 py-1.5 rounded-full">
                  <i class="fa-solid fa-certificate text-amber-500"></i>
                  <span>ऐतिहासिक अध्याय #01 • स्थापना एवं मूल संकल्प (2010)</span>
                </div>

                <h3 class="text-xl sm:text-2xl font-black text-gray-900 mb-4 leading-snug"><%= sec.heading || ("Section " + (idx + 1)) %></h3>

                <div class="text-gray-700 text-sm sm:text-base leading-relaxed space-y-3">
                  <% paragraphs.forEach(p => { %>
                    <p><%= p %></p>
                  <% }) %>
                </div>

                <!-- Highlight Box -->
                <div class="mt-5 p-4 rounded-xl bg-amber-50/80 border-l-4 border-amber-500 text-amber-950 text-xs sm:text-sm font-medium">
                  <p class="leading-relaxed">
                    <strong>मूल उद्देश्य:</strong> भारत के मूलनिवासी होने के बावजूद उपेक्षित रहे निषाद वंशियों को शिक्षित व संगठित कर संवैधानिक अधिकार दिलाना।
                  </p>
                </div>
              </div>

            </div>
          </div>

        <% } else if (idx === 1) { %>
          <!-- ==============================================
               HISTORICAL CHAPTER #02: SON OF MALLAH LEADERSHIP & 3 PILLARS
               ============================================== -->
          <div class="bg-gradient-to-br from-blue-50/70 via-white to-amber-50/40 rounded-3xl p-6 sm:p-10 shadow-sm border border-blue-100/80 hover:shadow-md transition-all">
            
            <div class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-primary mb-4 bg-white px-3.5 py-1.5 rounded-full shadow-sm border border-blue-100">
              <i class="fa-solid fa-user-shield text-amber-500"></i>
              <span>ऐतिहासिक अध्याय #02 • सन ऑफ मल्लाह का संकल्प एवं नेतृत्व</span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
              
              <!-- Left Visual Card: Leadership & 3 Key Mandates -->
              <div class="lg:col-span-5 flex flex-col justify-between">
                <div class="bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 text-white rounded-2xl p-6 shadow-md relative overflow-hidden border border-primary-700/60 h-full flex flex-col justify-between">
                  
                  <!-- Subtle Watermark -->
                  <div class="absolute -right-6 -bottom-6 text-white/5 text-9xl pointer-events-none">
                    <i class="fa-solid fa-anchor"></i>
                  </div>

                  <div>
                    <div class="flex items-center gap-3.5 mb-5 pb-4 border-b border-white/10">
                      <div class="w-12 h-12 rounded-xl bg-amber-400 text-gray-950 flex items-center justify-center text-xl font-black shadow flex-shrink-0">
                        <i class="fa-solid fa-crown"></i>
                      </div>
                      <div>
                        <span class="text-[11px] font-bold text-amber-300 uppercase tracking-wider block">संस्थापक एवं पथप्रदर्शक</span>
                        <h4 class="text-base sm:text-lg font-black text-white">सन ऑफ़ मल्लाह श्री मुकेश सहनी</h4>
                        <span class="text-[11px] text-blue-200 block">राष्ट्रीय अध्यक्ष, निषाद विकास संघ</span>
                      </div>
                    </div>

                    <p class="text-xs text-blue-100 font-bold uppercase tracking-wider mb-3 flex items-center gap-1.5">
                      <i class="fa-solid fa-bullseye text-amber-400"></i>
                      <span>संघ के 3 केंद्रीय संकल्प</span>
                    </p>

                    <!-- 3 Mandates List -->
                    <div class="space-y-2.5 text-xs sm:text-sm">
                      <div class="bg-white/10 p-3 rounded-xl border border-white/10 flex items-start gap-2.5">
                        <i class="fa-solid fa-scale-balanced text-amber-400 mt-1 flex-shrink-0"></i>
                        <div>
                          <strong class="text-white block font-bold">1. निषाद आरक्षण</strong>
                          <span class="text-blue-100 text-xs">निषाद वंशियों को SC सूची में शामिल कर आरक्षण अधिकार दिलाना</span>
                        </div>
                      </div>

                      <div class="bg-white/10 p-3 rounded-xl border border-white/10 flex items-start gap-2.5">
                        <i class="fa-solid fa-landmark text-amber-400 mt-1 flex-shrink-0"></i>
                        <div>
                          <strong class="text-white block font-bold">2. केंद्रीय मछुआरा आयोग</strong>
                          <span class="text-blue-100 text-xs">केंद्र स्तर पर मछुआरों के विकास हेतु विशेष आयोग की स्थापना</span>
                        </div>
                      </div>

                      <div class="bg-white/10 p-3 rounded-xl border border-white/10 flex items-start gap-2.5">
                        <i class="fa-solid fa-users text-amber-400 mt-1 flex-shrink-0"></i>
                        <div>
                          <strong class="text-white block font-bold">3. राजनीतिक हिस्सेदारी</strong>
                          <span class="text-blue-100 text-xs">संसद, विधानसभाओं और सत्ता में समाज का सशक्त प्रतिनिधित्व</span>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Bottom Tag -->
                  <div class="mt-5 pt-3 border-t border-white/10 flex items-center justify-between text-[11px] text-blue-200">
                    <span>एकजुटता से ही अधिकार संभव</span>
                    <i class="fa-solid fa-hand-fist text-amber-400"></i>
                  </div>

                </div>
              </div>

              <!-- Right Content Column: Detailed Narrative -->
              <div class="lg:col-span-7 flex flex-col justify-center">
                <h3 class="text-xl sm:text-2xl font-black text-gray-900 mb-3 leading-snug"><%= sec.heading || ("Section " + (idx + 1)) %></h3>

                <div class="text-gray-700 text-sm sm:text-base leading-relaxed space-y-4">
                  <% paragraphs.forEach(p => { %>
                    <p><%= p %></p>
                  <% }) %>
                </div>

                <!-- Callout Quote Box -->
                <div class="mt-5 p-4 rounded-xl bg-white border border-gray-100 shadow-sm">
                  <div class="flex items-start gap-3">
                    <i class="fa-solid fa-quote-left text-xl text-primary mt-0.5"></i>
                    <div>
                      <p class="text-xs sm:text-sm font-semibold text-gray-800 leading-relaxed">
                        "जब तक समाज का प्रत्येक व्यक्ति अपने हक और अधिकारों के प्रति शिक्षित और संगठित नहीं होगा, तब तक वास्तविक सामाजिक परिवर्तन अधूरा रहेगा।"
                      </p>
                      <span class="text-[11px] text-primary font-bold block mt-1.5">— श्री मुकेश सहनी</span>
                    </div>
                  </div>
                </div>

                <!-- Quick Tags -->
                <div class="mt-4 flex flex-wrap gap-2 text-xs font-semibold text-gray-600">
                  <span class="bg-blue-50 text-primary px-3 py-1 rounded-lg">#सामाजिक_जागरूकता</span>
                  <span class="bg-amber-50 text-amber-900 px-3 py-1 rounded-lg">#आरक्षण_आंदोलन</span>
                  <span class="bg-emerald-50 text-emerald-800 px-3 py-1 rounded-lg">#मछुआरा_आयोग</span>
                  <span class="bg-purple-50 text-purple-800 px-3 py-1 rounded-lg">#राजनीतिक_प्रतिनिधित्व</span>
                </div>

              </div>

            </div>

          </div>

        <% } else if (idx === 2) { %>
          <!-- ==============================================
               HISTORICAL CHAPTER #03: NISHAD KRANTI & LANDMARK VICTORIES
               ============================================== -->
          <div class="bg-gradient-to-br from-amber-50/60 via-white to-blue-50/50 rounded-3xl p-6 sm:p-10 shadow-sm border border-amber-200/90 hover:shadow-md transition-all relative overflow-hidden">
            
            <div class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-amber-900 mb-4 bg-amber-100 px-3.5 py-1.5 rounded-full">
              <i class="fa-solid fa-trophy text-amber-600"></i>
              <span>ऐतिहासिक अध्याय #03 • 'निषाद क्रांति' एवं आरक्षण आंदोलन का ऐतिहासिक असर</span>
            </div>

            <div class="max-w-4xl mb-6">
              <h3 class="text-xl sm:text-3xl font-black text-gray-900 mb-3 leading-snug"><%= sec.heading || ("Section " + (idx + 1)) %></h3>
              
              <div class="text-gray-700 text-sm sm:text-base leading-relaxed space-y-3">
