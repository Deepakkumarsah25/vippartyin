  <!-- Interactive Pagination Script for 23 Points -->
  <script>
    let currentObjectivePage = 1;
    const totalObjectivePages = 3;

    function switchObjectivePage(page, shouldScroll = false) {
      const cards = document.querySelectorAll('.objective-card');
      const tabBtns = document.querySelectorAll('.tab-phase-btn');
      const pagePills = document.querySelectorAll('.page-num-pill');
      const prevBtn = document.getElementById('btn-prev-page');
      const nextBtn = document.getElementById('btn-next-page');
      const rangeLabel = document.getElementById('item-range-label');
      const pageLabel = document.getElementById('current-page-label');
      const paginationBar = document.getElementById('objectives-pagination');

      currentObjectivePage = page;

      // Update Tabs active state
      tabBtns.forEach(btn => {
        btn.classList.remove('bg-white', 'text-primary', 'shadow-sm');
        btn.classList.add('text-gray-600');
      });

      const activeTab = document.getElementById('tab-btn-' + page);
      if (activeTab) {
        activeTab.classList.add('bg-white', 'text-primary', 'shadow-sm');
        activeTab.classList.remove('text-gray-600');
      }

      if (page === 'all') {
        // Show all cards
        cards.forEach(card => card.classList.remove('hidden'));
        if (rangeLabel) rangeLabel.textContent = 'बिंदु 1 से 23';
        if (pageLabel) pageLabel.textContent = '1-3';
        if (paginationBar) paginationBar.classList.add('opacity-50', 'pointer-events-none');
      } else {
        if (paginationBar) paginationBar.classList.remove('opacity-50', 'pointer-events-none');
        const num = parseInt(page, 10);
        
        cards.forEach(card => {
          if (parseInt(card.getAttribute('data-page'), 10) === num) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });

        // Update range label
        if (rangeLabel) {
          if (num === 1) rangeLabel.textContent = 'बिंदु 1 से 9';
          else if (num === 2) rangeLabel.textContent = 'बिंदु 10 से 18';
          else if (num === 3) rangeLabel.textContent = 'बिंदु 19 से 23';
        }
        if (pageLabel) pageLabel.textContent = num;

        // Update Pill buttons
        pagePills.forEach(pill => {
          pill.classList.remove('bg-primary', 'text-white', 'shadow-sm');
          pill.classList.add('bg-gray-100', 'text-gray-700');
        });
        const activePill = document.getElementById('page-pill-' + num);
        if (activePill) {
          activePill.classList.add('bg-primary', 'text-white', 'shadow-sm');
          activePill.classList.remove('bg-gray-100', 'text-gray-700');
        }

        // Prev Button state
        if (prevBtn) {
          if (num <= 1) {
            prevBtn.disabled = true;
            prevBtn.className = 'px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold border border-gray-200 text-gray-400 bg-gray-50 cursor-not-allowed transition-all inline-flex items-center gap-1.5';
          } else {
            prevBtn.disabled = false;
            prevBtn.className = 'px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold border border-gray-200 text-gray-700 hover:text-primary hover:border-primary/40 bg-white shadow-sm transition-all inline-flex items-center gap-1.5 cursor-pointer';
          }
        }

        // Next Button state
        if (nextBtn) {
          if (num >= totalObjectivePages) {
            nextBtn.disabled = true;
            nextBtn.className = 'px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold border border-gray-200 text-gray-400 bg-gray-50 cursor-not-allowed transition-all inline-flex items-center gap-1.5';
          } else {
            nextBtn.disabled = false;
            nextBtn.className = 'px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold border border-gray-200 text-gray-700 hover:text-primary hover:border-primary/40 bg-white shadow-sm transition-all inline-flex items-center gap-1.5 cursor-pointer';
          }
        }
      }

      // Smooth scroll back to top of objectives section if requested or if past header
      if (shouldScroll) {
        const target = document.getElementById('objectives-heading');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    function prevObjectivePage() {
      if (currentObjectivePage > 1 && currentObjectivePage !== 'all') {
        switchObjectivePage(currentObjectivePage - 1, true);
      }
    }

    function nextObjectivePage() {
      if (currentObjectivePage < totalObjectivePages && currentObjectivePage !== 'all') {
        switchObjectivePage(currentObjectivePage + 1, true);
      }
    }
  </script>

  <!-- Footer (Shared Component) -->
  <%- include('common/footer') %>

  <!-- Bilingual Translation & VIP Interactions Scripts -->
  <script src="/js/i18n.js"></script>
  <script src="/js/main.js"></script>

</body>
</html>
