<!DOCTYPE html>
<html lang="hi-IN" prefix="og: http://ogp.me/ns#">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- SEO Title & Meta Tags -->
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'निषाद विकास संघ (NVS) | विकासशील इंसान पार्टी' %></title>
  <meta name="title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : 'निषाद विकास संघ (NVS) | विकासशील इंसान पार्टी' %>">
  <meta name="description" content="निषाद विकास संघ (NVS) का आधिकारिक परिचय: स्थापना, इतिहास, निषाद क्रांति, आरक्षण आंदोलन और 23 प्रमुख सामाजिक एवं संगठनात्मक उद्देश्य।">
  <meta name="keywords" content="NVS, Nishad Vikas Sangh, Mukesh Sahani, Nishad Kranti, Nishad Reservation, Bihar Nishad, Son of Mallah">
