<!DOCTYPE html>
<html lang="hi-IN" prefix="og: http://ogp.me/ns#">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Terms and Conditions for the VIP Party mobile app">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Terms &amp; Conditions | VIP Party' %></title>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/vip-logo.svg">
  <link rel="shortcut icon" type="image/svg+xml" href="/images/vip-logo.svg">
  <link rel="apple-touch-icon" href="/images/vip-logo.svg">

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Tailwind CSS CDN Configured with VIP Party Branding -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              DEFAULT: '#0066b2',
              50: '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#0066b2',
              600: '#004b87',
              700: '#003a6c',
              800: '#002e54',
              900: '#001e38',
              950: '#001426',
            },
            secondary: {
              DEFAULT: '#004b87',
              hover: '#003a6c',
            },
            accent: '#f0f7ff',
            dark: '#0f172a'
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '"Noto Sans Devanagari"', 'Poppins', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Custom VIP Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">

  <style>
    :root {
      --text: #202124;
      --body: #3c4043;
      --muted: #5f6368;
      --line: #e5e7eb;
      --page: #f7f8fa;
      --white: #fff;
    }

    html {
      scroll-behavior: smooth;
    }

    .legal-container {
      width: min(1120px, calc(100% - 48px));
      margin: 28px auto 48px;
      font-family: Arial, Helvetica, sans-serif;
      color: var(--text);
      line-height: 1.7;
    }

    .legal-container a {
      color: #174ea6;
      overflow-wrap: anywhere;
      text-underline-offset: 2px;
    }

    .legal-container a:hover {
      color: #123b7a;
    }

    .legal-container .page-heading {
      padding-bottom: 20px;
      margin-bottom: 22px;
      border-bottom: 1px solid var(--line);
    }

    .legal-container h1 {
      font-size: clamp(27px, 3vw, 32px);
      line-height: 1.3;
      font-weight: 700;
      margin-bottom: 5px;
      letter-spacing: -0.45px;
    }

    .legal-container .subtitle {
      color: var(--muted);
      font-size: 15px;
      margin-bottom: 7px;
    }

    .legal-container .effective-date {
      display: block;
      color: var(--muted);
      font-size: 13px;
    }

    .legal-container .terms {
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: clamp(22px, 3.2vw, 38px);
    }

    .legal-container .intro {
      color: var(--muted);
      font-size: 14px;
      padding-bottom: 18px;
      margin-bottom: 20px;
      border-bottom: 1px solid var(--line);
    }

    .legal-container .section {
      padding: 21px 0;
      border-bottom: 1px solid var(--line);
      scroll-margin-top: 20px;
    }

    .legal-container .section:first-of-type {
      padding-top: 0;
    }

    .legal-container .section:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }

    .legal-container h2 {
      font-size: 19px;
      line-height: 1.4;
      margin-bottom: 10px;
      font-weight: 700;
    }

    .legal-container p {
      color: var(--body);
      margin-bottom: 11px;
    }

    .legal-container p:last-child {
      margin-bottom: 0;
    }

    .legal-container ul {
      color: var(--body);
      padding-left: 22px;
      margin: 9px 0 13px;
      list-style-type: disc;
    }

    .legal-container li {
      margin-bottom: 7px;
      padding-left: 2px;
    }

    .legal-container strong {
      color: var(--text);
    }

    .legal-container .contact {
      background: #fafafa;
      border: 1px solid var(--line);
      border-radius: 5px;
      padding: 14px 16px;
      margin-top: 12px;
    }

    .legal-container .contact p {
      margin-bottom: 7px;
    }

    @media (min-width: 1500px) {
      .legal-container {
        width: min(1160px, calc(100% - 64px));
      }
    }

    @media (max-width: 600px) {
      .legal-container {
        width: calc(100% - 24px);
        margin: 22px auto 30px;
      }

      .legal-container .page-heading {
        padding-bottom: 17px;
        margin-bottom: 17px;
      }

      .legal-container h1 {
        font-size: 28px;
      }

      .legal-container h2 {
        font-size: 18px;
      }

      .legal-container .terms {
        padding: 20px 16px;
      }

      .legal-container .section {
        padding: 19px 0;
      }
    }
  </style>
</head>

<body class="font-sans text-gray-700 bg-[#f7f8fa] antialiased">

