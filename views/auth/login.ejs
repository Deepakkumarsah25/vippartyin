
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title><%= pageTitle %></title>

  <link rel="icon" href="/images/vip-logo.svg">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/css/auth.css">

</head>

<body class="auth-body">

  <main class="auth-shell">

    <!-- LEFT SIDE -->
    <aside class="auth-story">

      <a class="auth-brand" href="/">
        <img src="/images/vip-logo.svg" alt="VIP">
        <span>VIKASSHEEL INSAAN PARTY</span>
      </a>

      <div class="auth-story-copy">
        <span class="auth-eyebrow">
          People first. Progress together.
        </span>

        <h1>A stronger voice begins with you.</h1>

        <p>
          Connect with your community, stay close to the
          movement and help shape a more hopeful future.
        </p>
      </div>

      <div class="auth-quote">
        जनता की आवाज़ · जनता का सम्मान
      </div>

    </aside>

    <!-- RIGHT SIDE -->
    <section class="auth-content">

      <div class="auth-card">

        <a class="auth-brand auth-mobile-brand" href="/">
          <img src="/images/vip-logo.svg" alt="VIP">
          <span style="color:#10253f">VIP PARTY</span>
        </a>

        <div class="auth-heading-row login-heading-row">
          <div class="auth-kicker">Welcome back</div>
        
        </div>

        <h2>Sign in account</h2>

        <p class="auth-subtitle">
          Pick up where you left off. Your community is waiting.
        </p>

        <div
          id="loginAlert"
          class="auth-alert"
          role="status"
          aria-live="polite"
        ></div>

        <!-- MOBILE / PASSWORD LOGIN -->
        <form id="loginForm">

          <div class="auth-fields">

            <div class="auth-field">
              <label for="loginIdentifier">Email address or mobile number</label>

              <input
                id="loginIdentifier"
                name="identifier"
                type="text"
                inputmode="text"
                autocomplete="username"
                maxlength="254"
                placeholder="Email address or Mobile number"
                required
              >
            </div>

            <div class="auth-field">

              <div class="auth-password-row">
                <label for="loginPassword">Password</label>

                <a href="/forgot-password">
                  Forgot password?
                </a>
              </div>

              <input
                id="loginPassword"
                name="password"
                type="password"
                autocomplete="current-password"
                placeholder="Enter your password"
                required
              >

            </div>

          </div>

          <div class="auth-submit-row">
            <button
              id="loginSubmitBtn"
              class="auth-primary"
              type="submit"
            >
              Sign in <span aria-hidden="true">→</span>
            </button>
          </div>

        </form>

        <div class="auth-divider">
          OR CONTINUE WITH
        </div>

        <!-- GOOGLE LOGIN -->
        <div
          id="googleButton"
          class="google-button"
          role="button"
          tabindex="0"
          data-return-to="<%= returnTo %>"
          aria-label="Sign in with Google"
        >
          <span class="google-mark" aria-hidden="true">G</span>
          <span>Continue with Google</span>
        </div>

        <div class="auth-switch">
          New to the community?
          <a href="/signup?returnTo=<%= encodeURIComponent(returnTo) %>">Create account</a>
        </div>

        <p class="auth-legal">
          By continuing, you agree to our community guidelines
          and applicable <a href="/">terms</a>.
        </p>

      </div>
    </section>

  </main>

  <script>
    const form = document.getElementById('loginForm');
    const alertBox = document.getElementById('loginAlert');
    const submit = document.getElementById('loginSubmitBtn');

    function message(text, type = 'error') {
      alertBox.textContent = text;
      alertBox.className = 'auth-alert show ' + type;
    }

    async function readResponse(response) {
      const raw = await response.text();

      try {
        return JSON.parse(raw);
      } catch {
        console.error(
          'Authentication endpoint returned a non-JSON response:',
          response.status
        );

        throw new Error(
          'Something went wrong. Please try again.'
        );
      }
    }

    // MOBILE / PASSWORD LOGIN
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      alertBox.className = 'auth-alert';
      submit.disabled = true;
      submit.textContent = 'Signing you in...';

      try {
        const response = await fetch('/auth/login', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            identifier: document.getElementById('loginIdentifier').value.trim(),
            password: document.getElementById('loginPassword').value,
            returnTo: <%- JSON.stringify(returnTo) %>
          })
        });

        const data = await readResponse(response);

        if (!response.ok || !data.success) {
          throw new Error(
            data.message || 'Could not sign in.'
          );
        }

        message(
          'You are signed in. Redirecting...',
          'success'
        );

        window.location.assign(data.redirect || '/');

      } catch (error) {
        message(
          error.message || 'Login failed. Please try again.'
        );

      } finally {
        submit.disabled = false;
        submit.innerHTML =
          'Sign in <span aria-hidden="true">→</span>';
      }
    });

  </script>
  <script type="module" src="/js/google-auth.js"></script>
  

</body>
</html>


