<!DOCTYPE html>
<html lang="hi-IN">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>लॉगिन (Login) | विकासशील इंसान पार्टी (VIP)</title>
  <link rel="icon" type="image/svg+xml" href="/images/vip-logo.svg">

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              DEFAULT: '#0066b2',
              50: '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#0066b2',
              600: '#004b87',
              700: '#003a6c',
              800: '#002e54',
              900: '#001e38',
              950: '#001426',
            }
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '"Noto Sans Devanagari"', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-slate-50 min-h-screen flex flex-col font-sans text-gray-800">
  <!-- Shared Navbar -->
  <%- include('../common/navbar') %>

  <!-- Main Login Container -->
  <main class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <!-- Subtle Background Elements -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-primary-100 rounded-full blur-3xl opacity-60 pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-amber-100 rounded-full blur-3xl opacity-60 pointer-events-none"></div>

    <div class="max-w-md w-full bg-white rounded-3xl shadow-2xl border border-gray-100 p-8 sm:p-10 relative z-10 animate-fade-in-up">
      
      <!-- Brand & Header -->
      <div class="text-center mb-8">
        <a href="/" class="inline-block mb-3 transform hover:scale-105 transition-transform">
          <img src="/images/vip-logo.svg" alt="VIP Logo" class="h-16 w-16 mx-auto object-contain drop-shadow">
        </a>
        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight" data-i18n="auth.login_title">
          वीआईपी सदस्य लॉगिन
        </h2>
        <p class="text-xs sm:text-sm text-gray-500 mt-1">
          अपने पंजीकृत मोबाइल नंबर या पासवर्ड से प्रवेश करें
        </p>
      </div>

      <!-- Alert Box -->
      <div id="loginAlert" class="hidden mb-5 p-4 rounded-xl text-sm font-medium"></div>

      <!-- Login Form -->
      <form id="loginForm" class="space-y-5">
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1.5" data-i18n="auth.mobile_label">
            मोबाइल नंबर दर्ज करें <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <span class="absolute left-3.5 top-3.5 text-gray-400 font-bold text-sm">+91</span>
            <input
              type="tel"
              id="loginPhone"
              name="phone"
              required
              maxlength="10"
              placeholder="10 अंकों का मोबाइल नंबर"
              class="w-full pl-14 pr-4 py-3 bg-gray-50/80 border border-gray-200 rounded-xl focus:outline-none focus:border-primary focus:bg-white text-sm font-semibold tracking-wider transition-all"
            >
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-xs font-bold text-gray-700">
              पासवर्ड / पिन (Password)
            </label>
            <a href="tel:06122506830" class="text-[11px] font-semibold text-primary hover:underline">
              पासवर्ड भूल गए?
            </a>
          </div>
          <div class="relative">
            <i class="fa-solid fa-lock absolute left-3.5 top-3.5 text-gray-400 text-sm"></i>
            <input
              type="password"
              id="loginPassword"
              name="password"
              placeholder="अपना पासवर्ड दर्ज करें (वैकल्पिक)"
              class="w-full pl-10 pr-4 py-3 bg-gray-50/80 border border-gray-200 rounded-xl focus:outline-none focus:border-primary focus:bg-white text-sm transition-all"
            >
          </div>
        </div>

        <button
          type="submit"
          id="loginSubmitBtn"
          class="w-full bg-primary hover:bg-primary-700 text-white font-bold py-3.5 px-4 rounded-xl transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2 text-base"
        >
          <i class="fa-solid fa-right-to-bracket text-sm"></i>
          <span id="loginBtnText">लॉगिन करें (Sign In)</span>
        </button>
      </form>

      <!-- Switch to SignUp -->
      <div class="mt-8 pt-6 border-t border-gray-100 text-center">
        <p class="text-xs sm:text-sm text-gray-600">
          क्या आप नए सदस्य हैं?
          <a href="/signup" class="font-bold text-primary hover:text-primary-700 hover:underline ml-1">
            यहाँ नया खाता बनाएं (Sign Up) &rarr;
          </a>
        </p>
      </div>

    </div>
  </main>

  <!-- Shared Footer -->
  <%- include('../common/footer') %>

  <!-- Scripts -->
  <script src="/js/i18n.js"></script>
  <script src="/js/main.js"></script>
  <script>
    const loginForm = document.getElementById('loginForm');
    const loginAlert = document.getElementById('loginAlert');
    const loginSubmitBtn = document.getElementById('loginSubmitBtn');
    const loginBtnText = document.getElementById('loginBtnText');

    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      loginAlert.classList.add('hidden');

      const phone = document.getElementById('loginPhone').value.trim();
      const password = document.getElementById('loginPassword').value.trim();

      if (!phone || phone.length < 10) {
        showAlert('कृपया वैध 10 अंकों का मोबाइल नंबर दर्ज करें।', 'error');
        return;
      }

      loginSubmitBtn.disabled = true;
      loginBtnText.textContent = 'सत्यापित हो रहा है...';

      try {
        const res = await fetch('/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone, password })
        });
        const data = await res.json();

        if (res.ok && data.success) {
          showAlert(data.message || 'लॉगिन सफल! मुख्य पृष्ठ पर पुनः निर्देशित किया जा रहा है...', 'success');
          setTimeout(() => {
            window.location.href = data.redirect || '/';
          }, 1200);
        } else {
          showAlert(data.message || 'लॉगिन में त्रुटि हुई। कृपया पुनः प्रयास करें।', 'error');
        }
      } catch (err) {
        showAlert('सर्वर से संपर्क नहीं हो पाया। कृपया इंटरनेट कनेक्शन जांचें।', 'error');
      } finally {
        loginSubmitBtn.disabled = false;
        loginBtnText.textContent = 'लॉगिन करें (Sign In)';
      }
    });

    function showAlert(msg, type) {
      loginAlert.textContent = msg;
      loginAlert.className = 'mb-5 p-4 rounded-xl text-sm font-medium ' +
        (type === 'success' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-red-50 text-red-700 border border-red-200');
      loginAlert.classList.remove('hidden');
    }
  </script>
</body>

</html>
