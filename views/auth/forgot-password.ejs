<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= pageTitle %></title><link rel="icon" href="/images/vip-logo.svg"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/auth.css"></head><body class="auth-body"><main class="auth-shell"><aside class="auth-story"><a class="auth-brand" href="/"><img src="/images/vip-logo.svg" alt="VIP"><span>VIKASSHEEL INSAAN PARTY</span></a><div class="auth-story-copy"><span class="auth-eyebrow">We’ve got you</span><h1>Let’s get you back in.</h1><p>It happens. Enter the email linked to your account and we’ll help you find your way back.</p></div><div class="auth-quote">आपकी आवाज़ · आपका साथ</div></aside><section class="auth-content"><a class="auth-back" href="/">← Back to website</a><div class="auth-card"><a class="auth-brand auth-mobile-brand" href="/"><img src="/images/vip-logo.svg" alt="VIP"><span style="color:#10253f">VIP PARTY</span></a><a class="auth-backlink" href="/login">← Back to sign in</a><div class="auth-kicker">Account recovery</div><h2>Forgot your password?</h2><p class="auth-subtitle">Enter your account email and we’ll send instructions to reset your password.</p><div id="resetAlert" class="auth-alert" role="status"></div><form id="resetForm"><div class="auth-field"><label for="resetEmail">Email address</label><input id="resetEmail" name="email" type="email" autocomplete="email" placeholder="you@example.com" required></div><button id="resetSubmit" class="auth-primary" type="submit">Send reset instructions <span aria-hidden="true">→</span></button></form><p class="auth-footnote">If you registered with a mobile number or need help, contact VIP support and we’ll help you recover access.</p><div class="auth-switch">Remember your password? <a href="/login">Sign in</a></div></div></section></main><script>const form=document.getElementById('resetForm'),box=document.getElementById('resetAlert'),button=document.getElementById('resetSubmit');form.addEventListener('submit',async e=>{e.preventDefault();button.disabled=true;button.textContent='Sending…';try{const r=await fetch('/auth/forgot-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:document.getElementById('resetEmail').value.trim()})}),d=await r.json();box.textContent=d.message||'If an account exists, reset instructions will be sent.';box.className='auth-alert show '+(r.ok?'success':'error')}catch{box.textContent='Could not reach the server. Please try again.';box.className='auth-alert show error'}finally{button.disabled=false;button.innerHTML='Send reset instructions <span aria-hidden="true">→</span>'}})</script></body></html>
