<!DOCTYPE html>
<html lang="hi-IN">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>साइन अप / नया खाता (Sign Up) | विकासशील इंसान पार्टी (VIP)</title>
  <link rel="icon" type="image/svg+xml" href="/images/vip-logo.svg">

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              DEFAULT: '#0066b2',
              50: '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#0066b2',
              600: '#004b87',
              700: '#003a6c',
              800: '#002e54',
              900: '#001e38',
              950: '#001426',
            }
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '"Noto Sans Devanagari"', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-slate-50 min-h-screen flex flex-col font-sans text-gray-800">
  <!-- Shared Navbar -->
  <%- include('../common/navbar') %>

  <!-- Main SignUp Container -->
  <main class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <!-- Subtle Background Glow -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-primary-100 rounded-full blur-3xl opacity-60 pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-amber-100 rounded-full blur-3xl opacity-60 pointer-events-none"></div>

    <div class="max-w-lg w-full bg-white rounded-3xl shadow-2xl border border-gray-100 p-8 sm:p-10 relative z-10 animate-fade-in-up">
      
      <!-- Brand & Header -->
      <div class="text-center mb-8">
        <a href="/" class="inline-block mb-3 transform hover:scale-105 transition-transform">
          <img src="/images/vip-logo.svg" alt="VIP Logo" class="h-16 w-16 mx-auto object-contain drop-shadow">
        </a>
        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight">
          नया सदस्य पंजीकरण
        </h2>
        <p class="text-xs sm:text-sm text-gray-500 mt-1">
          VIP डिजिटल पोर्टल पर अपना नया खाता बनाएं और आंदोलन से जुड़ें
        </p>
      </div>

      <!-- Alert Box -->
      <div id="signupAlert" class="hidden mb-5 p-4 rounded-xl text-sm font-medium"></div>

      <!-- SignUp Form -->
      <form id="signupForm" class="space-y-4">
        
        <!-- Full Name -->
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">
            पूरा नाम (Full Name) <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <i class="fa-solid fa-user absolute left-3.5 top-3.5 text-gray-400 text-sm"></i>
            <input
              type="text"
              id="signupName"
              name="name"
              required
              placeholder="आपका पूरा नाम"
              class="w-full pl-10 pr-4 py-3 bg-gray-50/80 border border-gray-200 rounded-xl focus:outline-none focus:border-primary focus:bg-white text-sm font-medium transition-all"
            >
          </div>
        </div>

        <!-- Mobile Number -->
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">
            मोबाइल नंबर (Mobile Number) <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <span class="absolute left-3.5 top-3.5 text-gray-400 font-bold text-sm">+91</span>
            <input
              type="tel"
              id="signupPhone"
              name="phone"
              required
              maxlength="10"
              placeholder="10 अंकों का मोबाइल नंबर"
              class="w-full pl-14 pr-4 py-3 bg-gray-50/80 border border-gray-200 rounded-xl focus:outline-none focus:border-primary focus:bg-white text-sm font-semibold tracking-wider transition-all"
            >
          </div>
        </div>

        <!-- Email & District Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">
              ईमेल (Email) <span class="text-gray-400 font-normal">(वैकल्पिक)</span>
            </label>
            <div class="relative">
              <i class="fa-solid fa-envelope absolute left-3.5 top-3.5 text-gray-400 text-sm"></i>
              <input
                type="email"
                id="signupEmail"
                name="email"
                placeholder="email@example.com"
                class="w-full pl-10 pr-4 py-3 bg-gray-50/80 border border-gray-200 rounded-xl focus:outline-none focus:border-primary focus:bg-white text-sm transition-all"
              >
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">
              गृह जिला (District) <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <i class="fa-solid fa-location-dot absolute left-3.5 top-3.5 text-gray-400 text-sm"></i>
              <input
                type="text"
                id="signupDistrict"
                name="district"
                required
                placeholder="उदा. पटना, मुजफ्फरपुर"
                class="w-full pl-10 pr-4 py-3 bg-gray-50/80 border border-gray-200 rounded-xl focus:outline-none focus:border-primary focus:bg-white text-sm font-medium transition-all"
              >
            </div>
          </div>
        </div>

        <!-- Password -->
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">
            पासवर्ड बनाएं (Create Password) <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <i class="fa-solid fa-lock absolute left-3.5 top-3.5 text-gray-400 text-sm"></i>
            <input
              type="password"
              id="signupPassword"
              name="password"
              required
              minlength="6"
              placeholder="कम से कम 6 अक्षर का पासवर्ड"
              class="w-full pl-10 pr-4 py-3 bg-gray-50/80 border border-gray-200 rounded-xl focus:outline-none focus:border-primary focus:bg-white text-sm transition-all"
            >
          </div>
        </div>

        <button
          type="submit"
          id="signupSubmitBtn"
          class="w-full bg-primary hover:bg-primary-700 text-white font-bold py-3.5 px-4 rounded-xl transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2 text-base mt-2"
        >
          <i class="fa-solid fa-user-plus text-sm"></i>
          <span id="signupBtnText">खाता बनाएं (Register Now)</span>
        </button>

      </form>

      <!-- Switch to Login -->
      <div class="mt-8 pt-6 border-t border-gray-100 text-center">
        <p class="text-xs sm:text-sm text-gray-600">
          पहले से पंजीकृत हैं?
          <a href="/login" class="font-bold text-primary hover:text-primary-700 hover:underline ml-1">
            यहाँ लॉगिन करें (Sign In) &rarr;
          </a>
        </p>
      </div>

    </div>
  </main>

  <!-- Shared Footer -->
  <%- include('../common/footer') %>

  <!-- Scripts -->
  <script src="/js/i18n.js"></script>
  <script src="/js/main.js"></script>
  <script>
    const signupForm = document.getElementById('signupForm');
    const signupAlert = document.getElementById('signupAlert');
    const signupSubmitBtn = document.getElementById('signupSubmitBtn');
    const signupBtnText = document.getElementById('signupBtnText');

    signupForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      signupAlert.classList.add('hidden');

      const name = document.getElementById('signupName').value.trim();
      const phone = document.getElementById('signupPhone').value.trim();
      const email = document.getElementById('signupEmail').value.trim();
      const district = document.getElementById('signupDistrict').value.trim();
      const password = document.getElementById('signupPassword').value.trim();

      if (!name || !phone || !district || !password) {
        showAlert('कृपया सभी आवश्यक फ़ील्ड भरें।', 'error');
        return;
      }

      if (phone.length < 10) {
        showAlert('कृपया वैध 10 अंकों का मोबाइल नंबर दर्ज करें।', 'error');
        return;
      }

      signupSubmitBtn.disabled = true;
      signupBtnText.textContent = 'खाता बनाया जा रहा है...';

      try {
        const res = await fetch('/auth/signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, phone, email, district, password })
        });
        const data = await res.json();

        if (res.ok && data.success) {
          showAlert(data.message || 'पंजीकरण सफल! लॉगिन पृष्ठ पर भेजा जा रहा है...', 'success');
          setTimeout(() => {
            window.location.href = '/login';
          }, 1500);
        } else {
          showAlert(data.message || 'पंजीकरण में त्रुटि हुई। कृपया पुनः प्रयास करें।', 'error');
        }
      } catch (err) {
        showAlert('सर्वर से संपर्क नहीं हो पाया। कृपया पुनः प्रयास करें।', 'error');
      } finally {
        signupSubmitBtn.disabled = false;
        signupBtnText.textContent = 'खाता बनाएं (Register Now)';
      }
    });

    function showAlert(msg, type) {
      signupAlert.textContent = msg;
      signupAlert.className = 'mb-5 p-4 rounded-xl text-sm font-medium ' +
        (type === 'success' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-red-50 text-red-700 border border-red-200');
      signupAlert.classList.remove('hidden');
    }
  </script>
</body>

</html>
