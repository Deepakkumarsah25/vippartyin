<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= pageTitle %></title><link rel="icon" href="/images/vip-logo.svg"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/auth.css"></head><body class="auth-body"><main class="auth-shell"><aside class="auth-story"><a class="auth-brand" href="/"><img src="/images/vip-logo.svg" alt="VIP"><span>VIKASSHEEL INSAAN PARTY</span></a><div class="auth-story-copy"><span class="auth-eyebrow">Be part of the change</span><h1>Your voice can move us forward.</h1><p>Join a growing community that believes every person deserves dignity, opportunity and a seat at the table.</p></div><div class="auth-quote">साथ चलें · बेहतर कल बनाएं</div></aside><section class="auth-content"><a class="auth-back" href="/">← Back to website</a><div class="auth-card"><a class="auth-brand auth-mobile-brand" href="/"><img src="/images/vip-logo.svg" alt="VIP"><span style="color:#10253f">VIP PARTY</span></a><div class="auth-kicker">Join the movement</div><h2>Create your account</h2><p class="auth-subtitle">A few details and you’re ready to get involved.</p><div id="signupAlert" class="auth-alert" role="status"></div><form id="signupForm"><div class="auth-fields"><div class="auth-field"><label for="signupName">Full name</label><input id="signupName" name="name" autocomplete="name" placeholder="Your name" required></div><div class="auth-fields two"><div class="auth-field"><label for="signupPhone">Mobile number</label><input id="signupPhone" name="phone" inputmode="numeric" autocomplete="tel-national" maxlength="10" placeholder="10-digit number" required></div><div class="auth-field"><label for="signupEmail">Email address <span style="font-weight:400;color:#96a2ad">(optional)</span></label><input id="signupEmail" name="email" type="email" autocomplete="email" placeholder="you@example.com"></div></div><div class="auth-field"><label for="signupDistrict">District</label><input id="signupDistrict" name="district" autocomplete="address-level2" placeholder="e.g. Patna" required></div><div class="auth-field"><label for="signupPassword">Create password</label><input id="signupPassword" name="password" type="password" minlength="8" autocomplete="new-password" placeholder="At least 8 characters" required></div></div><button id="signupSubmitBtn" class="auth-primary" type="submit">Create my account <span aria-hidden="true">→</span></button></form><div class="auth-switch">Already have an account? <a href="/login">Sign in</a></div><p class="auth-legal">Your details help us connect you with local updates and opportunities.</p></div></section></main><script>const form=document.getElementById('signupForm'),alertBox=document.getElementById('signupAlert'),submit=document.getElementById('signupSubmitBtn');function message(text,type='error'){alertBox.textContent=text;alertBox.className='auth-alert show '+type}form.addEventListener('submit',async e=>{e.preventDefault();alertBox.className='auth-alert';submit.disabled=true;submit.textContent='Creating your account…';const fields=['name','phone','email','district','password'],body={};fields.forEach(k=>body[k]=document.getElementById('signup'+k[0].toUpperCase()+k.slice(1)).value.trim());if(body.phone.length!==10){message('Please enter a valid 10-digit mobile number.');submit.disabled=false;submit.innerHTML='Create my account <span aria-hidden="true">→</span>';return}try{const r=await fetch('/auth/signup',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}),d=await r.json();if(!r.ok||!d.success)throw Error(d.message||'Could not create your account.');message('Your account is ready. Sign in to continue.','success');setTimeout(()=>location.href='/login',900)}catch(e){message(e.message)}finally{submit.disabled=false;submit.innerHTML='Create my account <span aria-hidden="true">→</span>'}})</script></body></html>
