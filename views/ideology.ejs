<!DOCTYPE html>
<html lang="hi-IN" prefix="og: http://ogp.me/ns#">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- SEO Title & Meta Tags -->
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'हमारी विचारधारा एवं सिद्धांत | विकासशील इंसान पार्टी (VIP)' %></title>
  <meta name="title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : 'हमारी विचारधारा एवं सिद्धांत | विकासशील इंसान पार्टी (VIP)' %>">
  <meta name="description" content="विकासशील इंसान पार्टी (VIP) की विचारधारा: इंसानियत, राष्ट्रभक्ति, सामाजिक समरसता, डॉ. भीमराव अम्बेडकर के सिद्धांत और भारतीय संविधान में अटूट निष्ठा।">
  <meta name="keywords" content="VIP Party Ideology, VIP Party Philosophy, Vikassheel Insaan Party, Mukesh Sahani, Social Justice, Ambedkarism, Secularism, Bihar Politics">
  <meta name="author" content="Vikassheel Insaan Party (VIP)">
  <meta name="robots" content="index, follow">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://vipparty.in/ideology">
  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : 'हमारी विचारधारा एवं सिद्धांत | विकासशील इंसान पार्टी (VIP)' %>">
  <meta property="og:description" content="विकासशील इंसान पार्टी (VIP) का वैचारिक दर्शन: समतामूलक समाज, इंसानियत, राष्ट्रभक्ति और हर वर्ग को समान अधिकार।">
  <meta property="og:image" content="/images/vip-logo.svg">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/vip-logo.svg">
  <link rel="shortcut icon" type="image/svg+xml" href="/images/vip-logo.svg">
  <link rel="apple-touch-icon" href="/images/vip-logo.svg">

  <!-- Google Fonts: Plus Jakarta Sans, Noto Sans Devanagari & Poppins -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- FontAwesome 6 Free Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Tailwind CSS CDN Configured with VIP Colors -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              DEFAULT: '#0066b2',
              50: '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#0066b2',
              600: '#004b87',
              700: '#003a6c',
              800: '#002e54',
              900: '#001e38',
              950: '#001426',
            },
            secondary: {
              DEFAULT: '#004b87',
              hover: '#003a6c',
            },
            accent: '#f0f7ff',
            dark: '#0f172a'
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '"Noto Sans Devanagari"', 'Poppins', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Custom VIP Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="font-sans text-gray-700 bg-white antialiased">

  <!-- 1. Header & Navigation (Shared Component) -->
  <%- include('common/navbar') %>

  <!-- ========================================================
       HERO BANNER & BREADCRUMBS
       ======================================================== -->
  <section class="bg-gradient-to-r from-primary-950 via-primary-900 to-primary-800 text-white py-12 sm:py-16 relative overflow-hidden border-b border-primary-700/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="flex items-center space-x-2 text-xs sm:text-sm text-blue-200">
          <li>
            <a href="/" class="hover:text-white transition-colors flex items-center gap-1.5">
              <i class="fa-solid fa-house text-[11px]"></i>
              <span data-i18n="nav.home">होम</span>
            </a>
          </li>
          <li class="text-blue-400">/</li>
          <li class="text-blue-200">
            <span data-i18n="nav.about">हमारे बारे में</span>
          </li>
          <li class="text-blue-400">/</li>
          <li class="text-amber-300 font-bold" aria-current="page">
            <span data-i18n="nav.ideology">हमारी विचारधारा</span>
          </li>
        </ol>
      </nav>

      <!-- Badge & Title -->
      <div class="max-w-4xl">
        <span class="inline-block bg-amber-400 text-gray-950 font-black text-xs px-3.5 py-1 rounded-full uppercase tracking-wider mb-3">
          ★ विकासशील इंसान पार्टी • दर्शन, सिद्धांत एवं मूल्य
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-3">
          <%= (typeof page !== 'undefined' && page && page.title) ? page.title : 'हमारी विचारधारा एवं सिद्धांत (Our Ideology)' %>
        </h1>
        <p class="text-blue-100 text-sm sm:text-base lg:text-lg max-w-2xl leading-relaxed">
          इंसानियत, राष्ट्रभक्ति, सामाजिक समरसता और भारतीय संविधान के समतामूलक मूल्यों पर आधारित वैचारिक दर्शन।
        </p>
      </div>

    </div>
  </section>

  <!-- ========================================================
       4 CORE PHILOSOPHICAL PILLARS STRIP
       ======================================================== -->
  <div class="relative z-20 -mt-6 sm:-mt-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
    <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-5 sm:p-6 grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 divide-y sm:divide-y-0 sm:divide-x divide-gray-100">
      
      <!-- 1. इंसानियत व समरसता -->
      <div class="flex items-center gap-3.5 pt-2 sm:pt-0">
        <div class="w-12 h-12 rounded-xl bg-blue-50 text-primary flex items-center justify-center flex-shrink-0 text-xl font-bold shadow-sm">
          <i class="fa-solid fa-hands-holding-child"></i>
        </div>
        <div>
          <span class="text-[11px] sm:text-xs font-bold text-gray-500 uppercase tracking-wider block">सर्वोच्च मूल्य</span>
          <p class="text-sm sm:text-base font-extrabold text-gray-900 tracking-tight">इंसानियत व समरसता</p>
          <span class="text-[10px] text-primary font-semibold block">मानवता की सेवा</span>
        </div>
      </div>

      <!-- 2. संवैधानिक निष्ठा -->
      <div class="flex items-center gap-3.5 pt-2 sm:pt-0 sm:pl-6">
        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center flex-shrink-0 text-xl font-bold shadow-sm">
          <i class="fa-solid fa-book-bookmark"></i>
        </div>
        <div>
          <span class="text-[11px] sm:text-xs font-bold text-gray-500 uppercase tracking-wider block">संविधान में विश्वास</span>
          <p class="text-sm sm:text-base font-extrabold text-gray-900 tracking-tight">अम्बेडकरवादी मूल्य</p>
          <span class="text-[10px] text-gray-600 block">पंथनिरपेक्षता व न्याय</span>
        </div>
      </div>

      <!-- 3. अहिंसा व विवेक -->
      <div class="flex items-center gap-3.5 pt-2 sm:pt-0 sm:pl-6">
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0 text-xl font-bold shadow-sm">
          <i class="fa-solid fa-dove"></i>
        </div>
        <div>
          <span class="text-[11px] sm:text-xs font-bold text-gray-500 uppercase tracking-wider block">कार्यशैली</span>
          <p class="text-sm sm:text-base font-extrabold text-gray-900 tracking-tight">अहिंसा, तर्क व विवेक</p>
          <span class="text-[10px] text-gray-600 block">अंधश्रद्धा का उन्मूलन</span>
        </div>
      </div>

      <!-- 4. समानुपातिक भागीदारी -->
      <div class="flex items-center gap-3.5 pt-2 sm:pt-0 sm:pl-6">
        <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center flex-shrink-0 text-xl font-bold shadow-sm">
          <i class="fa-solid fa-chart-pie"></i>
        </div>
        <div>
          <span class="text-[11px] sm:text-xs font-bold text-gray-500 uppercase tracking-wider block">राजनीतिक अधिकार</span>
          <p class="text-sm sm:text-base font-extrabold text-gray-900 tracking-tight">समानुपातिक प्रतिनिधित्व</p>
          <span class="text-[10px] text-purple-700 font-semibold block">जनसंख्या के अनुपात में</span>
        </div>
      </div>

    </div>
  </div>

  <!-- ========================================================
       DYNAMIC PHILOSOPHY MANIFESTO SECTIONS (FROM CMS)
       ======================================================== -->
  <% 
    const sections = (typeof page !== 'undefined' && page && page.sections) ? page.sections : [];
    const imageSec = sections.find(s => s.image && s.image.trim() !== '');
    const textSections = sections.filter(s => (s.description && s.description.trim() !== '') || (s.heading && s.heading.trim() !== ''));
  %>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
    
    <!-- Optional Ideology Hero Graphic from Admin Panel -->
    <% if (imageSec && imageSec.image) { %>
      <div class="bg-white rounded-3xl p-4 sm:p-6 shadow-sm border border-gray-100 max-w-4xl mx-auto mb-12">
        <div class="rounded-2xl overflow-hidden shadow-sm aspect-[16/9] sm:aspect-[21/9] bg-slate-900">
          <img 
            src="<%= imageSec.image %>" 
            alt="VIP Party Philosophy & Ideology" 
            class="w-full h-full object-cover object-center"
            loading="lazy"
          />
        </div>
      </div>
    <% } %>

    <div class="space-y-10">
      
      <% textSections.forEach((sec, idx) => { %>
        
        <div class="bg-white rounded-3xl p-6 sm:p-10 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
          
          <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 rounded-xl bg-primary-50 text-primary flex items-center justify-center font-black text-sm flex-shrink-0">
              0<%= idx + 1 %>
            </div>
            <div>
              <span class="text-xs font-bold text-amber-500 uppercase tracking-wider block">वैचारिक घोषणापत्र</span>
              <h3 class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight">
                <%= sec.heading || (idx === 0 ? 'समतामूलक समाज और आदर्श महापुरुषों के विचार' : 'इंसानियत, राष्ट्रभक्ति और संविधान में अटूट निष्ठा') %>
              </h3>
            </div>
          </div>

          <!-- Description Paragraphs -->
          <div class="text-gray-700 text-sm sm:text-base leading-relaxed space-y-4 font-normal">
            <% (sec.description || '').split(/\r?\n/).filter(line => line.trim().length > 0).forEach(paragraph => { %>
              
              <% if (paragraph.includes('इंसानियत, राष्ट्रभक्ति, सामाजिक समरसता ही पार्टी की प्रमुख सिद्धान्त') || paragraph.includes('समतामूलक समाज की स्थापना')) { %>
                <!-- Highlight Box -->
                <div class="bg-blue-50/70 p-5 rounded-2xl border-l-4 border-primary text-primary-950 font-medium my-3">
                  <p class="leading-relaxed"><%= paragraph %></p>
                </div>
              <% } else { %>
                <p class="leading-relaxed"><%= paragraph %></p>
              <% } %>

            <% }) %>
          </div>

        </div>

      <% }) %>

    </div>

  </section>

  <!-- ========================================================
       INSPIRING PHILOSOPHICAL QUOTE BANNER
       ======================================================== -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
    <div class="bg-gradient-to-r from-primary-900 via-primary-800 to-primary-950 text-white rounded-3xl p-8 sm:p-12 shadow-xl relative overflow-hidden text-center">
      <div class="max-w-3xl mx-auto relative z-10">
        <i class="fa-solid fa-quote-left text-3xl sm:text-4xl text-amber-400 mb-4 inline-block"></i>
        <blockquote class="text-lg sm:text-2xl font-bold leading-relaxed mb-4">
          "लोकतंत्र विकेन्द्रित शासन व्यवस्था के अनुरूप समरस समाज निर्माण करना पार्टी की आधारभूत निष्ठा है। समाज के अंतिम पायदान पर खड़े व्यक्ति को सम्मान और अवसर देना ही हमारा धर्म है।"
        </blockquote>
        <p class="text-amber-300 font-black text-sm tracking-wider uppercase">— विकासशील इंसान पार्टी (VIP)</p>
      </div>
    </div>
  </section>


  <!-- Footer (Shared Component) -->
  <%- include('common/footer') %>

  <!-- Bilingual Translation & VIP Interactions Scripts -->
  <script src="/js/i18n.js"></script>
  <script src="/js/main.js"></script>

</body>
</html>
