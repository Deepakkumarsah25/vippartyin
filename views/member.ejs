<!DOCTYPE html>
<html lang="hi-IN" prefix="og: http://ogp.me/ns#">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- SEO Title & Meta Tags -->
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'सदस्य बनें | VIP Online Membership | विकासशील इंसान पार्टी' %></title>
  <meta name="title" content="सदस्य बनें | VIP Online Membership | विकासशील इंसान पार्टी">
  <meta name="description" content="सामाजिक न्याय, निषाद आरक्षण और बिहार के नव-निर्माण के आंदोलन में शामिल हों। विकासशील इंसान पार्टी (VIP) के आधिकारिक सदस्य के रूप में ऑनलाइन पंजीकरण करें और तुरंत अपना डिजिटल सदस्यता कार्ड प्राप्त करें।">
  <meta name="keywords" content="VIP Member, VIP Party Membership, Join VIP, Mukesh Sahani, Vikassheel Insaan Party, Bihar Politics, Nishad Aarakshan">
  <meta name="author" content="Vikassheel Insaan Party (VIP)">
  <meta name="robots" content="index, follow">

  <!-- Open Graph / Social -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://vipparty.in/member">
  <meta property="og:title" content="सदस्य बनें | VIP Online Membership | विकासशील इंसान पार्टी">
  <meta property="og:description" content="सामाजिक न्याय और अधिकार की लड़ाई में भागीदार बनें। VIP पार्टी के सदस्य बनें।">
  <meta property="og:image" content="/images/vip-logo.svg">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/vip-logo.svg">
  <link rel="shortcut icon" type="image/svg+xml" href="/images/vip-logo.svg">
  <link rel="apple-touch-icon" href="/images/vip-logo.svg">

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Tailwind CSS CDN Configured with VIP Colors -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              DEFAULT: '#0066b2',
              50: '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#0066b2',
              600: '#004b87',
              700: '#003a6c',
              800: '#002e54',
              900: '#001e38',
              950: '#001426',
            },
            secondary: {
              DEFAULT: '#004b87',
              hover: '#003a6c',
            },
            accent: '#f0f7ff',
            dark: '#0f172a'
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '"Noto Sans Devanagari"', 'Poppins', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Custom VIP Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
  
  <style>
    /* Custom Styling for Membership & ID Card */
    .vip-card-font {
      font-family: 'Noto Sans Devanagari', 'Poppins', sans-serif;
    }
    .custom-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.2);
      border-radius: 9999px;
    }
    .animate-spin-fast {
      animation: spin 0.8s linear infinite;
    }
  </style>
</head>

<body class="font-sans text-gray-700 bg-white antialiased">

  <!-- 1. Header & Navigation (Shared Component) -->
  <%- include('common/navbar') %>

  <!-- Breadcrumb Navigation -->
  <div class="bg-gray-100 border-b border-gray-200 py-2.5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-xs md:text-sm font-semibold text-gray-600 flex items-center space-x-2">
      <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
        <i class="fa-solid fa-house text-xs"></i>
        <span>होम</span>
      </a>
      <span class="text-gray-400">›</span>
      <span class="text-primary font-bold">हमसे जुड़ें (Join VIP)</span>
    </div>
  </div>

  <!-- 2. Hero Header Banner (Styled like RJD with VIP Party Royal Blue & Rally Overlay) -->
  <div class="bg-gradient-to-r from-primary-950 via-primary-800 to-primary-900 py-12 md:py-16 relative overflow-hidden shadow-inner border-b-4 border-amber-400">
    <!-- Rally Background Blend Overlay -->
    <div class="absolute inset-0 bg-cover bg-center opacity-15 mix-blend-overlay" style="background-image: url('/images/event_rally.jpg');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-black/20"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center gap-2 bg-amber-400/20 border border-amber-400/40 text-amber-300 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-3 backdrop-blur-sm">
        <i class="fa-solid fa-anchor"></i> विकासशील इंसान पार्टी सदस्यता अभियान
      </div>
      <h1 class="text-3xl md:text-5xl font-black text-white mb-3 tracking-tight">सदस्य बनें</h1>
      <p class="text-blue-100 text-base md:text-lg max-w-2xl mx-auto leading-relaxed font-medium">
        विकासशील इंसान पार्टी परिवार से जुड़ें और स्वाभिमान, हक व अधिकार के महा-आंदोलन का हिस्सा बनें।
      </p>
    </div>
  </div>

  <!-- 3. Main Form Section -->
  <section class="py-12 bg-slate-50 min-h-screen relative">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="bg-white p-6 sm:p-10 md:p-12 rounded-3xl shadow-2xl border border-gray-100 transition-all duration-300">

        <!-- Form Container -->
        <div id="form-container">
          <div class="text-center mb-8">
            <div class="relative inline-block mb-3">
              <img src="/images/vip-logo.svg" alt="VIP Logo" width="1024" height="1024" class="h-20 w-20 mx-auto drop-shadow-md transition-transform hover:scale-105 duration-300">
              <div class="absolute -bottom-1 -right-1 bg-amber-400 text-gray-950 text-[10px] font-black px-2 py-0.5 rounded-full shadow">
                VIP
              </div>
            </div>
            <h2 class="text-3xl font-black text-gray-900 tracking-tight">सदस्यता फॉर्म</h2>
            <p class="text-gray-500 mt-1.5 text-sm sm:text-base font-medium">कृपया नीचे दिए गए फॉर्म में अपनी सही जानकारी दर्ज करें।</p>
          </div>

          <!-- Eligibility & Privacy Policy Alert Box (Like RJD) -->
          <div class="bg-blue-50/80 border-l-4 border-primary p-4 sm:p-5 mb-8 rounded-r-2xl text-left shadow-sm">
            <h3 class="text-base sm:text-lg font-bold text-primary-900 mb-2 flex items-center gap-2">
              <i class="fa-solid fa-shield-halved text-primary"></i>
              योग्यता एवं निजता नीति (Eligibility & Privacy)
            </h3>
            <ul class="list-disc list-inside text-xs sm:text-sm text-blue-900 space-y-1.5 leading-relaxed font-medium">
              <li>आवेदक भारत का नागरिक होना चाहिए और उसकी आयु 18 वर्ष या उससे अधिक होनी चाहिए।</li>
              <li>आपकी व्यक्तिगत जानकारी (जैसे फोन नंबर और पता) पूरी तरह से सुरक्षित है और इसका उपयोग केवल पार्टी संचार के लिए किया जाएगा।</li>
              <li>सदस्यता पूर्णतः स्वैच्छिक है और विकासशील इंसान पार्टी (VIP) के संविधान व नियमों के अधीन है।</li>
            </ul>
          </div>

          <!-- Registration Form -->
          <form id="membership-form" enctype="multipart/form-data" class="space-y-6">
            
            <!-- Row 1: Full Name & Phone Number -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="group">
                <label class="block text-sm font-bold text-gray-700 mb-2 group-hover:text-primary transition-colors">
                  पूरा नाम <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                  <input type="text" name="name" required class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/50 shadow-sm text-sm text-gray-800 font-medium" placeholder="अपना पूरा नाम दर्ज करें">
                  <i class="fa-regular fa-user absolute left-4 top-3.5 text-gray-400 group-hover:text-primary transition-colors"></i>
                </div>
              </div>

              <div class="group">
                <label class="block text-sm font-bold text-gray-700 mb-2 group-hover:text-primary transition-colors">
                  फ़ोन नंबर <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                  <input type="tel" name="phone" required pattern="[0-9]{10}" maxlength="10" class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/50 shadow-sm text-sm text-gray-800 font-medium" placeholder="10 अंकों का मोबाइल नंबर">
                  <i class="fa-solid fa-phone absolute left-4 top-3.5 text-gray-400 group-hover:text-primary transition-colors"></i>
                </div>
              </div>
            </div>

            <!-- Row 2: Email ID -->
            <div class="group">
              <label class="block text-sm font-bold text-gray-700 mb-2 group-hover:text-primary transition-colors">
                ईमेल आईडी <span class="text-red-500">*</span>
              </label>
              <div class="relative">
                <input type="email" name="email" required class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/50 shadow-sm text-sm text-gray-800 font-medium" placeholder="example@email.com">
                <i class="fa-regular fa-envelope absolute left-4 top-3.5 text-gray-400 group-hover:text-primary transition-colors"></i>
              </div>
            </div>

            <!-- Row 3: Age & Gender -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="group">
                <label class="block text-sm font-bold text-gray-700 mb-2 group-hover:text-primary transition-colors">
                  आयु (Age) <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                  <input type="number" name="age" required min="18" max="120" class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/50 shadow-sm text-sm text-gray-800 font-medium" placeholder="अपनी आयु दर्ज करें (न्यूनतम 18 वर्ष)">
                  <i class="fa-regular fa-calendar absolute left-4 top-3.5 text-gray-400 group-hover:text-primary transition-colors"></i>
                </div>
              </div>

              <div class="group">
                <label class="block text-sm font-bold text-gray-700 mb-2 group-hover:text-primary transition-colors">
                  लिंग (Gender) <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                  <select name="gender" required class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/50 shadow-sm bg-white text-sm text-gray-800 font-medium">
                    <option value="" disabled selected>अपना लिंग चुनें</option>
                    <option value="Male">पुरुष (Male)</option>
                    <option value="Female">महिला (Female)</option>
                    <option value="Other">अन्य (Other)</option>
                  </select>
                  <i class="fa-solid fa-venus-mars absolute left-4 top-3.5 text-gray-400 group-hover:text-primary transition-colors"></i>
                </div>
              </div>
            </div>

            <!-- Row 4: Education -->
            <div class="group">
              <label class="block text-sm font-bold text-gray-700 mb-2 group-hover:text-primary transition-colors">
                शिक्षा (Education) <span class="text-red-500">*</span>
              </label>
              <div class="relative">
                <select name="education" required class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/50 shadow-sm bg-white text-sm text-gray-800 font-medium">
                  <option value="" disabled selected>अपनी शिक्षा चुनें</option>
                  <option value="Below 10th">10वीं से कम (Below 10th)</option>
                  <option value="10th">10वीं पास (10th Pass)</option>
                  <option value="12th">12वीं (12th)</option>
                  <option value="Graduation">स्नातक (Graduation)</option>
                  <option value="Above Graduation">स्नातक से ऊपर (Post Graduation / Above)</option>
                </select>
                <i class="fa-solid fa-graduation-cap absolute left-4 top-3.5 text-gray-400 group-hover:text-primary transition-colors"></i>
              </div>
            </div>

            <!-- Row 5: State & District -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="group">
                <label class="block text-sm font-bold text-gray-700 mb-2 group-hover:text-primary transition-colors">
                  राज्य (State) <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                  <select name="state" required class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all shadow-sm bg-gray-100 text-gray-700 cursor-not-allowed text-sm font-semibold">
                    <option value="Bihar" selected>बिहार (Bihar)</option>
                  </select>
                  <i class="fa-solid fa-map-location-dot absolute left-4 top-3.5 text-gray-500"></i>
                </div>
              </div>

              <div class="group">
                <label class="block text-sm font-bold text-gray-700 mb-2 group-hover:text-primary transition-colors">
                  जिला (District) <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                  <select name="district" id="district" required class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/50 shadow-sm bg-white text-sm text-gray-800 font-medium">
                    <option value="" disabled selected>अपना जिला चुनें</option>
                  </select>
                  <i class="fa-solid fa-city absolute left-4 top-3.5 text-gray-400 group-hover:text-primary transition-colors"></i>
                </div>
              </div>
            </div>

            <!-- Row 6: Lok Sabha & Vidhan Sabha (Assembly) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="group">
                <label class="block text-sm font-bold text-gray-700 mb-2 group-hover:text-primary transition-colors">
                  लोकसभा (Loksabha) <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                  <select name="loksabha" id="loksabha" required class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/50 shadow-sm bg-white text-sm text-gray-800 font-medium">
                    <option value="" disabled selected>अपना लोकसभा चुनें</option>
                  </select>
                  <i class="fa-solid fa-landmark absolute left-4 top-3.5 text-gray-400 group-hover:text-primary transition-colors"></i>
                </div>
              </div>

              <div class="group">
                <label class="block text-sm font-bold text-gray-700 mb-2 group-hover:text-primary transition-colors">
                  विधानसभा (Vidhansabha) <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                  <select name="vidhansabha" id="vidhansabha" required class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/50 shadow-sm bg-white text-sm text-gray-800 font-medium">
                    <option value="" disabled selected>पहले जिला चुनें</option>
                  </select>
                  <i class="fa-solid fa-check-to-slot absolute left-4 top-3.5 text-gray-400 group-hover:text-primary transition-colors"></i>
                </div>
              </div>
            </div>

            <!-- Row 7: Block & Panchayat -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="group">
                <label class="block text-sm font-bold text-gray-700 mb-2 group-hover:text-primary transition-colors">
                  प्रखंड (Block) <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                  <select name="block" id="block" required class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/50 shadow-sm bg-white text-sm text-gray-800 font-medium">
                    <option value="" disabled selected>पहले जिला चुनें</option>
                  </select>
                  <i class="fa-solid fa-sitemap absolute left-4 top-3.5 text-gray-400 group-hover:text-primary transition-colors"></i>
                </div>
              </div>

              <div class="group">
                <label class="block text-sm font-bold text-gray-700 mb-2 group-hover:text-primary transition-colors">
                  पंचायत (Panchayat) <span class="text-xs text-gray-400 font-normal ml-1">(वैकल्पिक)</span>
                </label>
                <div class="relative">
                  <input type="text" name="panchayat" id="panchayat" class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/50 shadow-sm text-sm text-gray-800 font-medium" placeholder="अपनी ग्राम पंचायत का नाम दर्ज करें">
                  <i class="fa-solid fa-tree absolute left-4 top-3.5 text-gray-400 group-hover:text-primary transition-colors"></i>
                </div>
              </div>
            </div>

            <!-- Row 8: Ward No & Referral ID -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="group">
                <label class="block text-sm font-bold text-gray-700 mb-2 group-hover:text-primary transition-colors">
                  वार्ड नंबर (Ward No) <span class="text-xs text-gray-400 font-normal ml-1">(वैकल्पिक)</span>
                </label>
                <div class="relative">
                  <input type="text" name="ward" class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/50 shadow-sm text-sm text-gray-800 font-medium" placeholder="अपना वार्ड नंबर दर्ज करें">
                  <i class="fa-solid fa-hashtag absolute left-4 top-3.5 text-gray-400 group-hover:text-primary transition-colors"></i>
                </div>
              </div>

              <div class="group">
                <label class="block text-sm font-bold text-gray-700 mb-2 group-hover:text-primary transition-colors">
                  संदर्भ संख्या (Referral ID) <span class="text-xs text-gray-400 font-normal ml-1">(वैकल्पिक)</span>
                </label>
                <div class="flex">
                  <span class="inline-flex items-center px-4 py-3 rounded-l-xl border border-r-0 border-gray-300 bg-gray-50 text-primary font-black text-sm">
                    VIP-
                  </span>
                  <input type="text" name="referred_by" class="flex-1 w-full px-4 py-3 border border-gray-300 rounded-r-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/50 shadow-sm text-sm text-gray-800 font-medium" placeholder="2026-XXXXX">
                </div>
              </div>
            </div>

            <!-- Row 9: Full Address -->
            <div class="group">
              <label class="block text-sm font-bold text-gray-700 mb-2 group-hover:text-primary transition-colors">
                पूरा पता (Full Address) <span class="text-red-500">*</span>
              </label>
              <div class="relative">
                <textarea name="address" rows="3" required class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/50 shadow-sm text-sm text-gray-800 font-medium" placeholder="मकान संख्या, मोहल्ला/गांव, पोस्ट ऑफिस, पिन कोड सहित पूरा पता लिखें..."></textarea>
                <i class="fa-regular fa-address-book absolute left-4 top-3.5 text-gray-400 group-hover:text-primary transition-colors"></i>
              </div>
            </div>

            <!-- Row 10: Photo Upload & Preview -->
            <div class="group">
              <label class="block text-sm font-bold text-gray-700 mb-2 group-hover:text-primary transition-colors">
                अपनी तस्वीर अपलोड करें (JPG/PNG) <span class="text-red-500">*</span>
              </label>
              <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-2xl hover:border-primary transition-colors bg-gray-50/80 group-hover:bg-blue-50/30">
                <div class="space-y-1 text-center">
                  <i class="fa-regular fa-image text-4xl text-gray-400 group-hover:text-primary transition-colors mb-3"></i>
                  <div class="flex text-sm text-gray-600 justify-center">
                    <label for="photo" class="relative cursor-pointer bg-white rounded-lg font-bold text-primary hover:text-primary-700 px-4 py-2 shadow-sm border border-gray-200 transition-all hover:shadow hover:scale-105">
