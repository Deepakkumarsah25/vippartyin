    document.addEventListener('DOMContentLoaded', function () {
      // 1. Populate Districts
      const distSelect = document.getElementById('district');
      biharDistricts.forEach(d => {
        const opt = document.createElement('option');
        opt.value = d;
        opt.textContent = d;
        distSelect.appendChild(opt);
      });

      // 2. Populate Loksabha
      const lokSelect = document.getElementById('loksabha');
      biharLoksabha.forEach(l => {
        const opt = document.createElement('option');
        opt.value = l;
        opt.textContent = l;
        lokSelect.appendChild(opt);
      });

      // 3. District Change Handler -> Updates Vidhansabha & Block
      distSelect.addEventListener('change', function () {
        const selectedDist = this.value;
        const vidhanSelect = document.getElementById('vidhansabha');
        const blockSelect = document.getElementById('block');

        // Reset
        vidhanSelect.innerHTML = '<option value="" disabled selected>विधानसभा चुनें</option>';
        blockSelect.innerHTML = '<option value="" disabled selected>प्रखंड चुनें</option>';

        // Populate Vidhansabha
        const vidhanList = districtAssemblyMap[selectedDist] || ["सदर विधानसभा", "विधानसभा क्षेत्र 1", "विधानसभा क्षेत्र 2"];
        vidhanList.forEach(v => {
          const opt = document.createElement('option');
          opt.value = v;
          opt.textContent = v;
          vidhanSelect.appendChild(opt);
        });

        // Populate Blocks
        const blockList = districtBlockMap[selectedDist] || genericBlocks;
        blockList.forEach(b => {
          const opt = document.createElement('option');
          opt.value = b;
          opt.textContent = b;
          blockSelect.appendChild(opt);
        });
      });
    });

    // Image Preview & Validation Function
    function previewImage(event) {
      const file = event.target.files[0];
      const errorMsg = document.getElementById('error-message');
      const previewContainer = document.getElementById('image-preview-container');

      if (!file) return;

      errorMsg.classList.add('hidden');
      errorMsg.textContent = '';

      const maxSize = 1.5 * 1024 * 1024; // 1.5MB max size
      if (file.size > maxSize) {
        errorMsg.textContent = 'फ़ाइल का आकार 1.5MB से कम होना चाहिए। (File size must be less than 1.5MB.)';
        errorMsg.classList.remove('hidden');
        event.target.value = '';
        previewContainer.classList.add('hidden');
        return;
      }

      const reader = new FileReader();
      reader.onload = function () {
        const output = document.getElementById('image-preview');
        output.src = reader.result;
        previewContainer.classList.remove('hidden');
      };
      reader.readAsDataURL(file);
    }

    // Form Submission & Card Generation
    document.getElementById('membership-form').addEventListener('submit', function (e) {
      e.preventDefault();
      submitMemberForm();
    });

    function submitMemberForm() {
      const form = document.getElementById('membership-form');
      const errorMsg = document.getElementById('error-message');
      const loadingState = document.getElementById('loading-state');
      const formContainer = document.getElementById('form-container');

      const formData = new FormData(form);
      const memberPhotoPreview = document.getElementById('image-preview').getAttribute('src') || '';

      formContainer.classList.add('hidden');
      loadingState.classList.remove('hidden');
      errorMsg.classList.add('hidden');

      fetch('/actions/process_member', {
        method: 'POST',
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          // Fill Digital ID Card
          document.getElementById('card-name').textContent = data.data.name;
          document.getElementById('card-id').textContent = data.data.unique_id;

          const distVal = formData.get('district') || '';
          document.getElementById('card-district').textContent = distVal.split(' ')[0] || distVal;
          
          const lokVal = formData.get('loksabha') || '';
          document.getElementById('card-loksabha').textContent = lokVal.split(' ')[0] || lokVal || '-';

          const today = new Date();
          document.getElementById('card-date').textContent =
            String(today.getDate()).padStart(2, '0') + '/' +
            String(today.getMonth() + 1).padStart(2, '0') + '/' +
            today.getFullYear();

          document.getElementById('card-photo').src = memberPhotoPreview || '/images/vip-logo.svg';

          // Hide Loading & Show Modal
          loadingState.classList.add('hidden');
          formContainer.classList.remove('hidden');
          form.reset();
          document.getElementById('image-preview-container').classList.add('hidden');

          const modal = document.getElementById('success-modal');
          const modalContent = document.getElementById('modal-content');
          modal.classList.remove('hidden');

          setTimeout(() => {
            modalContent.classList.remove('scale-90', 'opacity-0');
            modalContent.classList.add('scale-100', 'opacity-100');
          }, 100);

        } else {
          throw new Error(data.message || 'पंजीकरण में त्रुटि हुई। कृपया पुनः प्रयास करें।');
        }
      })
      .catch(error => {
        loadingState.classList.add('hidden');
        formContainer.classList.remove('hidden');
        errorMsg.textContent = error.message;
        errorMsg.classList.remove('hidden');
      });
    }

    function closeModal() {
      const modal = document.getElementById('success-modal');
      const modalContent = document.getElementById('modal-content');

      modalContent.classList.remove('scale-100', 'opacity-100');
      modalContent.classList.add('scale-90', 'opacity-0');

      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }

    // High Quality ID Card Download using html2canvas
    function downloadIDCard() {
      const btn = document.getElementById('download-btn');
      const cardElement = document.getElementById('id-card');

      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i><span>आईडी कार्ड तैयार हो रहा है...</span>';

      html2canvas(cardElement, {
        scale: 3, // Ultra-sharp 3x retina quality
        useCORS: true,
        allowTaint: true,
        backgroundColor: null,
        width: 360,
        height: 640,
        windowWidth: 360,
        windowHeight: 640,
        scrollX: 0,
        scrollY: 0,
        logging: false
      }).then(canvas => {
        const image = canvas.toDataURL('image/png', 1.0);
        const link = document.createElement('a');
        const memberId = document.getElementById('card-id').textContent.trim();
        link.download = 'VIP_Member_Card_' + memberId + '.png';
        link.href = image;
        link.click();

        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-check"></i><span>डाउनलोड सफल!</span>';
        setTimeout(() => {
          btn.innerHTML = '<i class="fa-solid fa-download"></i><span>आईडी कार्ड डाउनलोड करें</span>';
        }, 2500);
      }).catch(err => {
        console.error('Download error:', err);
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-download"></i><span>आईडी कार्ड डाउनलोड करें</span>';
      });
    }
  </script>

