<div id="authModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[220] hidden items-center justify-center p-4">
  <div
    class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl border border-gray-100 transform transition-all animate-fade-in-up relative">

    <!-- Close Button -->
    <button id="closeAuthModalBtn"
      class="absolute top-5 right-5 text-gray-400 hover:text-gray-700 text-2xl leading-none">&times;</button>

    <!-- Header -->
    <div class="text-center mb-6">
      <img src="/images/vip-logo.svg" alt="VIP Logo" class="h-14 w-14 mx-auto mb-3 object-contain">
      <h3 class="text-2xl font-black text-gray-900" data-i18n="auth.title">वीआईपी डिजिटल पोर्टल</h3>
      <p class="text-xs text-gray-500 mt-1" data-i18n="auth.subtitle">लॉगिन करें या नया सदस्य खाता बनाएं</p>
    </div>

    <!-- Tabs: Login vs Signup -->
    <div class="flex bg-gray-100 p-1 rounded-xl mb-6">
      <button type="button" id="authTabLogin"
        class="flex-1 py-2 text-sm font-bold rounded-lg bg-white text-primary shadow-sm transition-all"
        data-i18n="auth.tab_login">
        लॉगिन
      </button>
      <button type="button" id="authTabSignup"
        class="flex-1 py-2 text-sm font-bold rounded-lg text-gray-600 transition-all hover:text-gray-900"
        data-i18n="auth.tab_signup">
        नया खाता बनाएं
      </button>
    </div>

    <!-- Form Content -->
    <form id="authForm" onsubmit="event.preventDefault(); alert('ओटीपी आपके नंबर पर भेज दिया गया है!');">
      <!-- Full Name (Only for signup) -->
      <div id="signupNameField" class="mb-4 hidden">
        <label class="block text-xs font-bold text-gray-700 mb-1" data-i18n="auth.name_label">पूरा नाम</label>
        <div class="relative">
          <i class="fa-solid fa-user absolute left-3.5 top-3.5 text-gray-400 text-sm"></i>
          <input type="text" placeholder="आपका पूरा नाम" data-i18n-ph="auth.name_ph"
            class="w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:border-primary text-sm font-medium">
        </div>
      </div>

      <!-- Mobile Number -->
      <div class="mb-5">
        <label class="block text-xs font-bold text-gray-700 mb-1" data-i18n="auth.mobile_label">मोबाइल नंबर दर्ज
          करें</label>
        <div class="relative">
          <span class="absolute left-3.5 top-3.5 text-gray-500 text-sm font-bold">+91</span>
          <input type="tel" maxlength="10" required placeholder="10 अंकों का मोबाइल नंबर" data-i18n-ph="auth.mobile_ph"
            class="w-full pl-14 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:border-primary text-sm font-semibold tracking-wider">
        </div>
      </div>

      <!-- Action Button -->
      <button type="submit"
        class="w-full bg-primary hover:bg-primary-700 text-white font-bold py-3.5 px-4 rounded-xl transition-all shadow-lg hover:shadow-xl flex items-center justify-center gap-2">
        <i class="fa-solid fa-paper-plane text-xs"></i>
        <span id="authSubmitText" data-i18n="auth.send_otp">ओटीपी प्राप्त करें</span>
      </button>

      <!-- Terms Note -->
      <p class="text-[11px] text-gray-400 text-center mt-4">
        आगे बढ़कर आप विकासशील इंसान पार्टी के नियमों व गोपनीयता नीति को स्वीकार करते हैं।
      </p>
    </form>
  </div>
</div>

