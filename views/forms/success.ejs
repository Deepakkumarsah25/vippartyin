<!DOCTYPE html>
<html lang="hi-IN" prefix="og: http://ogp.me/ns#">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- SEO Title & Meta Tags -->
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'आवेदन सफलतापूर्वक दर्ज | Vikassheel Insaan Party (VIP)' %></title>
  <meta name="robots" content="noindex, follow">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/vip-logo.svg">
  <link rel="shortcut icon" type="image/svg+xml" href="/images/vip-logo.svg">

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <!-- Tailwind CSS CDN Configured with VIP Colors -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              DEFAULT: '#0066b2',
              50: '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#0066b2',
              600: '#004b87',
              700: '#003a6c',
              800: '#002e54',
              900: '#001e38',
              950: '#001426',
            },
            accent: '#f59e0b'
          },
          fontFamily: {
            hindi: ['Noto Sans Devanagari', 'sans-serif'],
            sans: ['Plus Jakarta Sans', 'Noto Sans Devanagari', 'sans-serif'],
          }
        }
      }
    };
  </script>

  <!-- html2canvas for ID card download -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  <link rel="stylesheet" href="/css/style.css">

  <style>
    @keyframes pulseRing {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.15); opacity: 0.3; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    .pulse-ring {
      animation: pulseRing 2.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @media print {
      header, nav, footer, .no-print {
        display: none !important;
      }
      body {
        background: white !important;
        color: black !important;
      }
      .print-area {
        box-shadow: none !important;
        border: 1px solid #ccc !important;
      }
    }
  </style>
</head>

<body class="bg-gradient-to-b from-blue-50/70 via-white to-gray-50 text-gray-800 font-sans min-h-screen flex flex-col antialiased">

  <!-- Header / Navigation Bar -->
  <%- include('../common/navbar') %>

  <!-- Main Success Content -->
  <main class="flex-grow py-8 sm:py-14 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">

      <!-- Breadcrumbs & Return Bar -->
      <div class="mb-6 flex items-center justify-between text-xs sm:text-sm text-gray-500 no-print">
        <div class="flex items-center gap-2">
          <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
            <i class="fa-solid fa-house"></i>
            <span>होम</span>
          </a>
          <span>/</span>
          <a id="breadcrumbFormsLink" href="/forms" class="hover:text-primary transition-colors">फॉर्म सेक्शन</a>
          <span>/</span>
          <span class="text-primary font-bold" id="breadcrumbFormName">आवेदन सफलता</span>
        </div>

        <button onclick="handleClose()" class="text-gray-500 hover:text-red-600 transition flex items-center gap-1.5 font-semibold">
          <i class="fa-solid fa-arrow-left"></i>
          <span>फॉर्म पर वापस जाएं</span>
        </button>
      </div>

      <!-- Main Success Container Card -->
      <div class="bg-white rounded-3xl shadow-2xl border border-gray-100 overflow-hidden print-area">
        
        <!-- Top Celebration Header -->
        <div class="relative bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700 text-white p-6 sm:p-10 text-center overflow-hidden">
          <!-- Background decorative elements -->
          <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none"></div>
          <div class="absolute -top-12 -right-12 w-48 h-48 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
          <div class="absolute -bottom-12 -left-12 w-48 h-48 bg-amber-400/20 rounded-full blur-2xl pointer-events-none"></div>

          <!-- Pulsing Success Icon -->
          <div class="relative inline-flex items-center justify-center mb-4">
            <div class="absolute w-24 h-24 bg-emerald-400/30 rounded-full pulse-ring"></div>
            <div class="relative w-20 h-20 bg-white text-emerald-600 rounded-full flex items-center justify-center text-4xl shadow-xl">
              <i class="fa-solid fa-check"></i>
            </div>
          </div>

          <!-- Form Badge -->
          <div class="mb-3">
            <span id="formBadge" class="inline-flex items-center gap-1.5 bg-white/20 backdrop-blur-md text-amber-300 font-extrabold text-xs sm:text-sm px-4 py-1.5 rounded-full border border-white/30 tracking-wide uppercase shadow-sm">
              <i class="fa-solid fa-file-circle-check"></i>
              <span id="formBadgeText">आवेदन दर्ज हुआ</span>
            </span>
          </div>

          <!-- Main Title -->
          <h1 id="successMainTitle" class="text-2xl sm:text-4xl font-black text-white tracking-tight mb-2 drop-shadow-sm font-hindi">
            बधाई हो! आवेदन सफलतापूर्वक दर्ज हुआ
          </h1>

          <!-- Dynamic Subtitle -->
          <p id="successSubtitle" class="text-emerald-50 text-sm sm:text-base max-w-xl mx-auto leading-relaxed opacity-95">
            आपका विवरण विकासशील इंसान पार्टी के केंद्रीय सर्वर में सुरक्षित दर्ज कर लिया गया है।
          </p>
        </div>

        <!-- Details Section -->
        <div class="p-6 sm:p-10">

          <!-- Reference ID Highlight Box -->
          <div class="bg-gradient-to-r from-blue-50 to-indigo-50/50 border-2 border-primary/20 rounded-2xl p-4 sm:p-6 mb-8 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="text-center sm:text-left">
              <span class="text-xs font-bold uppercase text-primary-700 tracking-wider block" id="refIdLabel">
                आवेदन / संदर्भ संख्या (Reference ID)
              </span>
              <span id="referenceId" class="text-2xl sm:text-3xl font-black text-gray-900 font-mono tracking-wider">
                VIP-SUCCESS-2026
              </span>
            </div>
            <button onclick="copyRefId()" id="copyBtn" class="shrink-0 inline-flex items-center gap-2 bg-white hover:bg-primary-50 text-primary-700 border border-primary/30 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-sm transition hover:scale-105 active:scale-95 no-print">
              <i class="fa-regular fa-copy"></i>
              <span id="copyBtnText">आईडी कॉपी करें</span>
            </button>
          </div>

          <!-- Applicant Information Grid -->
          <div class="bg-gray-50/80 rounded-2xl p-5 sm:p-6 mb-8 border border-gray-100">
            <h3 class="text-xs font-black uppercase text-gray-400 tracking-wider mb-4 flex items-center gap-2">
              <i class="fa-solid fa-circle-info text-primary"></i>
              <span>पंजीकृत विवरण (Registration Details)</span>
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
              <div class="bg-white p-3.5 rounded-xl border border-gray-100 shadow-sm">
                <span class="text-xs text-gray-500 block mb-0.5">आवेदक का नाम</span>
                <span id="detailName" class="font-bold text-gray-900 text-base">-</span>
              </div>

              <div class="bg-white p-3.5 rounded-xl border border-gray-100 shadow-sm">
                <span class="text-xs text-gray-500 block mb-0.5">मोबाइल नंबर</span>
                <span id="detailMobile" class="font-bold text-gray-900 text-base">-</span>
              </div>

              <div class="bg-white p-3.5 rounded-xl border border-gray-100 shadow-sm">
                <span class="text-xs text-gray-500 block mb-0.5">फॉर्म का प्रकार</span>
                <span id="detailFormType" class="font-bold text-primary text-base">-</span>
              </div>

              <div class="bg-white p-3.5 rounded-xl border border-gray-100 shadow-sm">
                <span class="text-xs text-gray-500 block mb-0.5">जिला / क्षेत्र</span>
                <span id="detailLocation" class="font-bold text-gray-900 text-base">-</span>
              </div>

              <div class="bg-white p-3.5 rounded-xl border border-gray-100 shadow-sm">
                <span class="text-xs text-gray-500 block mb-0.5">जमा करने की तिथि</span>
                <span id="detailDate" class="font-bold text-gray-900 text-base">-</span>
              </div>

              <div class="bg-white p-3.5 rounded-xl border border-gray-100 shadow-sm">
                <span class="text-xs text-gray-500 block mb-0.5">आवेदन स्थिति</span>
                <span id="detailStatus" class="inline-flex items-center gap-1.5 text-emerald-700 font-extrabold text-sm bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
                  <i class="fa-solid fa-circle-check text-xs"></i>
                  <span>सफलतापूर्वक दर्ज</span>
                </span>
              </div>
            </div>
          </div>

          <!-- Digital Membership Card Section (Rendered dynamically if formType == 'member') -->
          <div id="membershipCardContainer" class="hidden mb-10">
            <div class="flex items-center gap-3 mb-5">
              <div class="flex-1 h-px bg-gray-200"></div>
              <span class="text-xs font-black uppercase tracking-widest text-primary flex items-center gap-2">
                <i class="fa-solid fa-id-card"></i>
                <span>आपका डिजिटल सदस्यता पहचान पत्र</span>
              </span>
              <div class="flex-1 h-px bg-gray-200"></div>
            </div>

            <!-- Digital ID Card Container (360x640 Canvas) -->
            <div id="id-card-wrapper" class="flex justify-center w-full my-4 overflow-x-auto pb-4">
              <div id="id-card" style="width: 360px; min-width: 360px; height: 640px; position: relative; border-radius: 24px; overflow: hidden; font-family: 'Noto Sans Devanagari', 'Poppins', sans-serif; background: #001f3f; box-shadow: 0 25px 60px rgba(0,25,50,0.5); box-sizing: border-box;">

                <!-- Multi-layered Background with VIP Royal Navy Gradients -->
                <div style="position: absolute; inset: 0; background: linear-gradient(165deg, #001529 0%, #003666 45%, #001f3f 100%);"></div>

                <!-- Subtle Watermark Boat / Emblem -->
                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); opacity: 0.05; width: 280px; height: 280px; pointer-events: none;">
                  <img src="/images/vip-logo.svg" alt="" style="width: 100%; height: 100%; object-fit: contain;">
                </div>

                <!-- Card Content Wrapper -->
                <div style="position: relative; z-index: 10; padding: 24px 22px; height: 100%; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: space-between;">

                  <!-- 1. Card Header -->
                  <div style="display: flex; flex-direction: column; align-items: center; width: 100%; padding-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,0.12);">
                    <div style="background: white; border-radius: 14px; padding: 6px 10px; margin-bottom: 8px; box-shadow: 0 4px 16px rgba(0,0,0,0.4); display: flex; align-items: center; gap: 8px;">
                      <img src="/images/vip-logo.svg" alt="VIP" width="1024" height="1024" style="height: 40px; width: 40px; object-fit: contain; display: block;">
                      <span style="color: #0066b2; font-weight: 900; font-size: 20px; letter-spacing: 0.5px; line-height: 1;">VIP</span>
                    </div>
                    <p style="font-size: 20px; font-weight: 900; color: white; margin: 0; line-height: 1.2; text-align: center;">विकासशील इंसान पार्टी</p>
                    <p style="font-size: 9.5px; color: #f59e0b; letter-spacing: 3px; text-transform: uppercase; margin: 4px 0 0 0; font-weight: 800;">VIKASSHEEL INSAAN PARTY</p>
                  </div>

                  <!-- 2. Card Member Profile Inner Box -->
                  <div style="width: 100%; background: rgba(0, 24, 48, 0.7); border-radius: 20px; padding: 18px 16px; display: flex; flex-direction: column; align-items: center; border: 1px solid rgba(255,255,255,0.1); box-sizing: border-box;">

                    <!-- Profile Photo with Gold Ring & VIP Badge -->
                    <div style="position: relative; margin-bottom: 12px;">
                      <div style="position: absolute; inset: -6px; border-radius: 50%; background: linear-gradient(135deg, #f59e0b, #d97706, #f59e0b);"></div>
                      <div style="position: absolute; inset: -2px; border-radius: 50%; background: white;"></div>
                      <div style="width: 104px; height: 104px; border-radius: 50%; overflow: hidden; position: relative; background: #001a33;">
                        <img id="cardPhoto" src="/images/vip-logo.svg" alt="सदस्य फोटो" width="104" height="104" style="width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block;">
                      </div>
                      <div style="position: absolute; bottom: 0px; right: 0px; width: 28px; height: 28px; border-radius: 50%; background: white; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(0,0,0,0.5); border: 2px solid #f59e0b;">
                        <img src="/images/vip-logo.svg" alt="" width="18" height="18" style="width: 18px; height: 18px; object-fit: contain;">
                      </div>
                    </div>

                    <!-- Member Full Name -->
                    <h2 id="cardName" style="font-size: 20px; font-weight: 800; color: white; text-align: center; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 8px 0; line-height: 1.25;">
                      सदस्य का नाम
                    </h2>

                    <!-- Official Member Badge -->
                    <div style="background: rgba(0,0,0,0.35); border: 1px solid rgba(245, 158, 11, 0.4); border-radius: 30px; padding: 4px 16px; margin-bottom: 14px;">
                      <span style="font-size: 11px; font-weight: 800; color: #f59e0b; letter-spacing: 1px;">✦ आधिकारिक सदस्य ✦</span>
                    </div>

                    <!-- Two Column District & Lok Sabha Info -->
                    <div style="width: 100%; display: flex; justify-content: space-between; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 12px; margin-bottom: 12px;">
                      <div style="text-align: left;">
                        <p style="font-size: 9px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 1px; margin: 0 0 2px 0; font-weight: 700;">जिला (DISTRICT)</p>
                        <p id="cardDistrict" style="font-size: 14px; font-weight: 800; color: white; margin: 0;">-</p>
                      </div>
                      <div style="text-align: right;">
                        <p style="font-size: 9px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 1px; margin: 0 0 2px 0; font-weight: 700;">लोकसभा (LOKSABHA)</p>
                        <p id="cardLoksabha" style="font-size: 14px; font-weight: 800; color: white; margin: 0;">-</p>
                      </div>
                    </div>

                    <!-- Member ID Row -->
                    <div style="width: 100%; text-align: center;">
                      <p style="font-size: 8.5px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 1.5px; margin: 0 0 6px 0; font-weight: 700;">सदस्यता संख्या (MEMBER ID)</p>
                      <div style="display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 8px; width: 100%;">
                        <div style="flex: 1; height: 1px; background: rgba(255,255,255,0.25);"></div>
                        <span id="cardId" style="font-size: 16px; font-weight: 800; color: #ffffff; letter-spacing: 2px; font-family: 'Courier New', Courier, monospace; white-space: nowrap; line-height: 1;">VIP-2026-XXXX</span>
                        <div style="flex: 1; height: 1px; background: rgba(255,255,255,0.25);"></div>
                      </div>
                    </div>

                  </div>

                  <!-- 3. Card Footer (Issue Date & Motto) -->
                  <div style="width: 100%; display: flex; justify-content: space-between; align-items: center; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.1);">
                    <div style="text-align: left;">
                      <p style="font-size: 8px; color: rgba(255,255,255,0.45); text-transform: uppercase; letter-spacing: 1px; margin: 0 0 2px 0; font-weight: 700;">जारी होने की तिथि</p>
                      <p id="cardDate" style="font-size: 12px; font-weight: 800; color: white; margin: 0;">-</p>
                    </div>
                    <div style="text-align: right;">
                      <p style="font-size: 9px; color: #f59e0b; font-weight: 800; margin: 0; letter-spacing: 1px;">स्वाभिमान • हक • अधिकार</p>
                    </div>
                  </div>

                </div>

                <!-- Right Gold Border Accent Line -->
                <div style="position: absolute; right: 0; top: 0; bottom: 0; width: 6px; background: linear-gradient(to bottom, #f59e0b, #d97706, #f59e0b);"></div>

              </div>
            </div>

            <!-- Download Button for Member ID Card -->
            <div class="flex justify-center mt-3 no-print">
              <button onclick="downloadIDCard()" id="downloadBtn" class="bg-gradient-to-r from-primary to-primary-700 hover:from-primary-600 hover:to-primary-800 text-white font-bold py-3.5 px-6 rounded-xl shadow-lg hover:shadow-xl transition flex items-center gap-2 transform hover:-translate-y-0.5">
                <i class="fa-solid fa-download"></i>
                <span id="downloadBtnText">आईडी कार्ड डाउनलोड करें</span>
              </button>
            </div>
          </div>

          <!-- Instructions & Information Card -->
          <div class="border-t border-gray-100 pt-6 mb-8 text-sm text-gray-600">
            <h4 class="font-bold text-gray-900 mb-2 flex items-center gap-2">
              <i class="fa-solid fa-list-check text-emerald-600"></i>
              <span>अगला कदम (Next Steps)</span>
            </h4>
            <ul class="space-y-2 list-disc list-inside text-xs sm:text-sm text-gray-600">
              <li>कृपया भविष्य के संदर्भ के लिए अपना <strong>संदर्भ क्रमांक (Reference ID)</strong> नोट करके सुरक्षित रखें।</li>
              <li>पार्टी के राज्य/जिला नेतृत्व एवं संबंधित विभाग द्वारा आपके आवेदन का सत्यापन किया जाएगा।</li>
              <li>आवश्यकतानुसार पार्टी के आधिकारिक पदाधिकारी दिए गए मोबाइल नंबर पर आपसे संपर्क करेंगे।</li>
            </ul>
          </div>

          <!-- ==============================================
               ACTION BUTTONS & THE CLOSE BUTTON
               ============================================== -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4 border-t border-gray-100 no-print">
            
            <!-- CLOSE BUTTON (Requested by User: Brings user back to form section) -->
            <button onclick="handleClose()" id="closeSuccessBtn" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-red-600 hover:bg-red-700 active:bg-red-800 text-white font-black py-4 px-8 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-200 transform hover:-translate-y-0.5 text-base">
              <i class="fa-solid fa-xmark text-lg"></i>
              <span>बंद करें (Close & Return)</span>
            </button>

            <!-- PRINT BUTTON -->
            <button onclick="window.print()" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white hover:bg-gray-100 text-gray-800 border-2 border-gray-200 font-bold py-4 px-6 rounded-2xl shadow-sm transition-all duration-200 text-base">
              <i class="fa-solid fa-print text-gray-500"></i>
              <span>पावती प्रिंट करें</span>
            </button>

            <!-- EXPLORE OTHER FORMS -->
            <a href="/forms" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-primary/10 hover:bg-primary/20 text-primary-700 font-bold py-4 px-6 rounded-2xl transition-all duration-200 text-base">
              <i class="fa-solid fa-layer-group"></i>
              <span>अन्य फॉर्म देखें</span>
            </a>

          </div>

        </div>

      </div>

    </div>
  </main>

  <!-- Footer -->
  <%- include('../common/footer') %>

  <!-- Success Page Logic Script -->
  <script>
    // Configuration per Form Type
    const formConfig = {
      member: {
        badge: 'वीआईपी सदस्यता पंजीकरण',
        title: 'बधाई हो! आपकी सदस्यता दर्ज हो गई',
        subtitle: 'आप आधिकारिक रूप से विकासशील इंसान पार्टी के सदस्य बन गए हैं। आपका डिजिटल सदस्यता पहचान पत्र नीचे उपलब्ध है।',
        defaultReturn: '/member',
        label: 'सदस्यता संख्या (Member ID)'
      },
      volunteer: {
        badge: 'वालंटियर पंजीकरण',
        title: 'हार्दिक बधाई! आपका वालंटियर आवेदन दर्ज हुआ',
        subtitle: 'विकासशील इंसान पार्टी के सामाजिक न्याय आंदोलन में वालंटियर के रूप में शामिल होने के लिए धन्यवाद। संगठन टीम शीघ्र आपसे संपर्क करेगी।',
        defaultReturn: '/volunteer',
        label: 'वालंटियर आईडी (Volunteer ID)'
      },
      scholarship: {
        badge: 'जुब्बा सहनी मेधा छात्रवृत्ति योजना',
        title: 'छात्रवृत्ति आवेदन सफलतापूर्वक जमा हुआ',
        subtitle: 'जुब्बा सहनी मेधा छात्रवृत्ति योजना 2026-27 के अंतर्गत आपका आवेदन दर्ज कर लिया गया है। समीक्षा उपरांत चयनित छात्रों को सूचित किया जाएगा।',
        defaultReturn: '/scholarship',
        label: 'आवेदन क्रमांक (Application ID)'
      },
      candidature: {
        badge: 'यूपी 2027 उम्मीदवारी आवेदन',
        title: 'उम्मीदवारी आवेदन सफलतापूर्वक दर्ज हुआ',
        subtitle: 'उत्तर प्रदेश विधानसभा चुनाव 2027 के लिए आपका उम्मीदवारी आवेदन प्रपत्र पार्टी के केंद्रीय संसदीय बोर्ड को प्रेषित कर दिया गया है।',
        defaultReturn: '/candidature-up-2027',
        label: 'प्रत्याशी आवेदन संख्या (Candidature ID)'
      },
      contact: {
        badge: 'संपर्क सूत्र संदेश',
        title: 'आपका संदेश सफलतापूर्वक भेजा गया',
        subtitle: 'हमसे संपर्क करने के लिए धन्यवाद! हमारी मीडिया एवं जनसंपर्क टीम जल्द ही आपसे संपर्क करेगी।',
        defaultReturn: '/contact',
        label: 'संदेश संदर्भ संख्या (Reference ID)'
      },
      donate: {
        badge: 'सहयोग एवं दान अभिस्वीकृति',
        title: 'आपके बहुमूल्य सहयोग के लिए धन्यवाद',
        subtitle: 'पार्टी को मजबूत बनाने में आपका योगदान सराहनीय है। आपकी दान रसीद की पावती दर्ज कर ली गई है।',
        defaultReturn: '/donate',
        label: 'रसीद संख्या (Receipt Number)'
      }
    };

    let returnUrl = '/forms';

    document.addEventListener('DOMContentLoaded', () => {
      // 1. Read Query Parameters
      const urlParams = new URLSearchParams(window.location.search);
      const queryType = urlParams.get('type') || '';
      const queryId = urlParams.get('id') || '';
      const queryName = urlParams.get('name') || '';
      const queryPhone = urlParams.get('mobile') || urlParams.get('phone') || '';
      const queryDistrict = urlParams.get('district') || '';
      const queryAssembly = urlParams.get('assembly') || '';
      const queryFrom = urlParams.get('from') || '';

      // 2. Read Session Storage Data (if available)
      let sessionData = {};
      try {
        const stored = sessionStorage.getItem('vip_form_success');
        if (stored) {
          sessionData = JSON.parse(stored);
        }
      } catch (e) {
        console.warn('Session storage read error:', e);
      }

      // Combine Data (prefer sessionData, fallback to queryParams, then defaults)
      const formType = (sessionData.formType || queryType || 'member').toLowerCase();
      const refId = sessionData.id || queryId || 'VIP-REG-' + Math.floor(10000 + Math.random() * 90000);
      const applicantName = sessionData.name || queryName || 'सम्मानित आवेदक';
      const applicantMobile = sessionData.phone || queryPhone || '-';
      const district = sessionData.district || queryDistrict || 'बिहार';
      const loksabha = sessionData.loksabha || queryAssembly || district || '-';
      const photo = sessionData.photo || '/images/vip-logo.svg';
      const dateStr = sessionData.date || new Date().toLocaleDateString('en-GB');

      // Determine Return URL
      const config = formConfig[formType] || formConfig.member;
      returnUrl = sessionData.from || queryFrom || config.defaultReturn || '/forms';

      // Update Breadcrumbs
      document.getElementById('breadcrumbFormName').textContent = config.badge;
      document.getElementById('breadcrumbFormsLink').href = returnUrl;

      // Update Top Card Information
      document.getElementById('formBadgeText').textContent = config.badge;
      document.getElementById('successMainTitle').textContent = config.title;
      document.getElementById('successSubtitle').textContent = config.subtitle;
      document.getElementById('refIdLabel').textContent = config.label;
      document.getElementById('referenceId').textContent = refId;

      // Update Detailed Grid
      document.getElementById('detailName').textContent = applicantName;
      document.getElementById('detailMobile').textContent = applicantMobile;
      document.getElementById('detailFormType').textContent = config.badge;
      document.getElementById('detailLocation').textContent = [district, loksabha].filter(x => x && x !== '-').join(' / ') || 'बिहार';
      document.getElementById('detailDate').textContent = dateStr;

      // If Membership Form, populate and show Digital ID Card
      if (formType === 'member') {
        const cardContainer = document.getElementById('membershipCardContainer');
        if (cardContainer) {
          cardContainer.classList.remove('hidden');
          document.getElementById('cardName').textContent = applicantName;
          document.getElementById('cardId').textContent = refId;
          document.getElementById('cardDistrict').textContent = district;
          document.getElementById('cardLoksabha').textContent = loksabha;
          document.getElementById('cardDate').textContent = dateStr;
          
          if (photo) {
            document.getElementById('cardPhoto').src = photo;
          }
        }
      }
    });

    // Close Button Action: Redirects user back to the form section
    function handleClose() {
      // Clear current form success session storage so it doesn't linger
      try {
        sessionStorage.removeItem('vip_form_success');
      } catch (e) {}

      // Redirect back to the form page or forms section
      window.location.href = returnUrl || '/forms';
    }

    // Copy Reference ID
    function copyRefId() {
      const idText = document.getElementById('referenceId').textContent.trim();
      navigator.clipboard.writeText(idText).then(() => {
        const btnText = document.getElementById('copyBtnText');
        const original = btnText.textContent;
        btnText.textContent = 'कॉपी हो गया!';
        setTimeout(() => {
          btnText.textContent = original;
        }, 2000);
      }).catch(err => {
        alert('आईडी: ' + idText);
      });
    }

    // Download ID Card Function (html2canvas)
    function downloadIDCard() {
      const btn = document.getElementById('downloadBtn');
      const cardElement = document.getElementById('id-card');
      if (!cardElement) return;

      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i><span>आईडी कार्ड तैयार हो रहा है...</span>';

      html2canvas(cardElement, {
        scale: 3,
        useCORS: true,
        allowTaint: true,
        backgroundColor: null,
        width: 360,
        height: 640,
        windowWidth: 360,
        windowHeight: 640,
        scrollX: 0,
        scrollY: 0,
        logging: false
      }).then(canvas => {
        const image = canvas.toDataURL('image/png', 1.0);
        const link = document.createElement('a');
        const memberId = document.getElementById('cardId').textContent.trim();
        link.download = 'VIP_Member_Card_' + memberId + '.png';
        link.href = image;
        link.click();

        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-check"></i><span>डाउनलोड सफल!</span>';
        setTimeout(() => {
          btn.innerHTML = '<i class="fa-solid fa-download"></i><span>आईडी कार्ड डाउनलोड करें</span>';
        }, 2500);
      }).catch(err => {
        console.error('Download error:', err);
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-download"></i><span>आईडी कार्ड डाउनलोड करें</span>';
      });
    }
  </script>

  <!-- Bilingual & UI Scripts -->
  <script src="/js/i18n.js"></script>
  <script src="/js/main.js"></script>
</body>

</html>
