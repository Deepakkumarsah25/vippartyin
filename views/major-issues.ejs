            <img 
              src="/images/issues/social_harmony.png" 
              alt="सामाजिक सद्भाव - Social Harmony" 
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute bottom-3 left-3 bg-slate-900/90 backdrop-blur-sm text-white text-xs font-bold px-3 py-1 rounded-lg">
              <i class="fa-solid fa-people-group text-amber-400 mr-1.5"></i> सामाजिक सद्भाव
            </div>
          </div>
        </div>

        <!-- Content Column -->
        <div class="lg:col-span-7 lg:order-2">
          
          <div class="flex items-center justify-between gap-3 mb-3">
            <div class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-primary bg-blue-50 px-3.5 py-1.5 rounded-full">
              <i class="fa-solid fa-people-group text-amber-500"></i>
              <span>मुद्दा #01 • सामाजिक एकता</span>
            </div>
            <span class="text-xs font-bold text-gray-400">Social Harmony</span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-black text-gray-900 mb-4 leading-snug">
            सामाजिक सद्भाव (Social Harmony)
          </h2>

          <div class="text-gray-700 text-sm sm:text-base leading-relaxed space-y-3 font-normal">
            <p>
              समाज के सर्वांगीण विकास के लिए समाज में सद्भाव तथा सौहार्द का होना अत्यंत आवश्यक है। सामाजिक सद्भाव का माहौल ही समाज को तरक्की के रास्ते पर अग्रसर करता है। एक सामाजिक प्राणी होने के नाते मनुष्य समाज में रहता है तथा एक बेहतर, तरक्कीपसंद और अमन-चैन से परिपूर्ण समाज के लिए सामाजिक सद्भाव अत्यंत महत्वपूर्ण है।
            </p>
            <p>
              सामाजिक सद्भाव के कारण ही समाज में विविधता होते हुए भी लोगों में आपसी प्रेम, मित्रता तथा भाईचारा रहता है और लोग एक-दूसरे के सुख-दुख में सहभागी बनते हैं। विकासशील इंसान पार्टी का उद्देश्य समाज में एक बेहतर प्रगतिशीलता का माहौल कायम करना तथा संपूर्ण समाज को एकजुट करना है।
            </p>
          </div>

          <!-- Highlight Box -->
          <div class="mt-5 p-4 rounded-xl bg-blue-50/70 border-l-4 border-primary text-gray-800 text-xs sm:text-sm font-medium">
            <p class="leading-relaxed">
              <strong>पार्टी का संकल्प:</strong> बिना किसी भेद-भाव के हर जाति, वर्ग और समुदाय में आपसी विश्वास, सौहार्द और परस्पर सम्मान की मजबूत नींव रखना।
            </p>
          </div>

          <!-- Tags -->
          <div class="mt-4 flex flex-wrap gap-2 text-xs font-semibold text-gray-600">
            <span class="bg-gray-100 px-3 py-1 rounded-lg">#सौहार्दपूर्ण_माहौल</span>
            <span class="bg-gray-100 px-3 py-1 rounded-lg">#आपसी_भाईचारा</span>
            <span class="bg-gray-100 px-3 py-1 rounded-lg">#एकजुट_बिहार</span>
          </div>

        </div>

