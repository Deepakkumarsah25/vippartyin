<!doctype html>
<html lang="hi-IN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { theme: { extend: {
      colors: { primary: { DEFAULT: '#0066b2', 50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd', 400: '#60a5fa', 500: '#0066b2', 600: '#004b87', 700: '#003a6c', 800: '#002e54', 900: '#001e38', 950: '#001426' }, secondary: { DEFAULT: '#004b87', hover: '#003a6c' }, accent: '#f0f7ff', dark: '#0f172a' },
      fontFamily: { sans: ['"Plus Jakarta Sans"', '"Noto Sans Devanagari"', 'Poppins', 'sans-serif'] }
    } }};
  </script>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    :root { --gallery-primary: #0066b2; --gallery-primary-dark: #001e38; --gallery-hero-height: 190px; --gallery-hero-height-desktop: 235px; }
    .gallery-hero { background-color: var(--gallery-primary-dark); }
    .gallery-hero-overlay { background: linear-gradient(90deg, #001426 0%, var(--gallery-primary) 52%, #004b87 100%); }
    .gallery-hero-content { min-height: var(--gallery-hero-height); padding-top: 1.5rem; padding-bottom: 1.5rem; }
    .gallery-search { border: 2px solid #cbd5e1; box-shadow: 0 1px 2px rgb(15 23 42 / 8%); }
    .gallery-search::placeholder { color: #94a3b8; }
    .gallery-search-wrap:hover .gallery-search { border-color: #60a5fa; }
    .gallery-search:focus { border-color: var(--gallery-primary); box-shadow: 0 0 0 4px rgb(0 102 178 / 14%); }
    .gallery-chip { border: 2px solid #cbd5e1; background: #fff; color: #334155; }
    .gallery-chip:hover { border-color: var(--gallery-primary); background: #eff6ff; color: #004b87; }
    .gallery-chip.is-active { border-color: var(--gallery-primary); background: var(--gallery-primary); color: #fff; box-shadow: 0 1px 2px rgb(15 23 42 / 12%); }
    .gallery-card { box-shadow: 0 8px 24px rgb(15 23 42 / 7%); transition: transform .25s ease, box-shadow .25s ease; }
    .gallery-card:hover { transform: translateY(-4px); box-shadow: 0 16px 36px rgb(15 23 42 / 12%); }
    .card-slider-track { will-change: transform; }
    #photo-modal.hidden { display: none !important; }
    #photo-modal:not(.hidden) { display: flex !important; }
    @media (min-width: 640px) { .gallery-hero-content { min-height: var(--gallery-hero-height-desktop); padding-top: 2rem; padding-bottom: 2rem; } }
  </style>
</head>
<body class="font-sans text-gray-700 bg-slate-50 antialiased">
  <%- include('../common/navbar') %>
  <main class="min-h-screen pb-20">
    <section class="gallery-hero relative overflow-hidden text-white">
      <div class="gallery-hero-overlay absolute inset-0"></div>
      <div class="gallery-hero-content relative mx-auto flex max-w-7xl items-center justify-center px-5 text-center">
        <div>
          <p class="mb-2 text-sm font-bold uppercase tracking-[.2em] text-blue-200">VIP Party</p>
          <h1 class="text-4xl font-black sm:text-6xl">फोटो गैलरी</h1>
          <p class="mx-auto mt-3 max-w-2xl text-base text-blue-100 sm:text-lg">पार्टी की खास झलकियां एवं कार्यक्रम</p>
        </div>
      </div>
    </section>

    <section id="photo-gallery" class="mx-auto max-w-7xl px-5 pb-12 pt-6 sm:pb-16 sm:pt-8">
      <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div id="gallery-categories" class="flex flex-wrap gap-2" aria-label="श्रेणी चुनें"></div>
        <label class="gallery-search-wrap relative block w-full sm:w-72 lg:w-80">
          <span class="sr-only">तस्वीरें खोजें</span>
          <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-500"></i>
          <input id="gallery-search" type="search" placeholder="तस्वीरें खोजें..." class="gallery-search w-full rounded-full bg-white py-3 pl-11 pr-4 outline-none transition">
        </label>
      </div>

      <!-- Photo Cards Grid -->
      <div id="gallery-grid" class="grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3" aria-live="polite">
        <div class="col-span-full rounded-2xl bg-white p-12 text-center text-slate-500 shadow-sm">
          <i class="fa-solid fa-spinner fa-spin text-2xl text-primary mb-3"></i>
          <p>तस्वीरें लोड हो रही हैं...</p>
        </div>
      </div>
      <div id="gallery-empty" class="hidden rounded-2xl bg-white p-12 text-center text-slate-500 shadow-sm">
        <i class="fa-regular fa-image text-4xl text-slate-300 mb-3 block"></i>
        इस खोज में कोई तस्वीर नहीं मिली।
      </div>
    </section>

    <!-- Photo Preview Lightbox Modal -->
    <div id="photo-modal" class="fixed inset-0 z-[999] hidden items-center justify-center bg-black/92 p-2 sm:p-4 backdrop-blur-sm transition-opacity duration-200" role="dialog" aria-modal="true" aria-label="Photo Preview">
      
      <!-- Top Control Bar -->
      <div class="absolute top-0 inset-x-0 z-30 flex items-center justify-between p-3 sm:p-5 bg-gradient-to-b from-black/85 via-black/40 to-transparent text-white">
        <div class="flex items-center gap-2.5 max-w-[70%] sm:max-w-[80%]">
          <span id="modal-category" class="rounded-full bg-primary px-3 py-1 text-xs font-bold text-white uppercase tracking-wider shrink-0 shadow-sm">VIP</span>
          <h2 id="modal-title" class="text-sm sm:text-base font-bold truncate text-white drop-shadow"></h2>
        </div>
        <div class="flex items-center gap-2">
          <!-- Open original in new tab -->
          <a id="modal-external-link" href="#" target="_blank" rel="noopener noreferrer" title="मूल तस्वीर देखें (Open Full Size)" class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/10 hover:bg-white/25 flex items-center justify-center text-white transition-colors" aria-label="Open photo in new tab">
            <i class="fa-solid fa-arrow-up-right-from-square text-xs sm:text-sm"></i>
          </a>
          <!-- Close button -->
          <button id="modal-close" type="button" title="बंद करें (Esc)" class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/10 hover:bg-red-600 flex items-center justify-center text-white transition-colors" aria-label="Close modal">
            <i class="fa-solid fa-xmark text-lg"></i>
          </button>
        </div>
      </div>

      <!-- Navigation Arrows -->
      <button id="modal-prev" type="button" title="पिछली तस्वीर (Left Arrow)" class="absolute left-2 sm:left-5 top-1/2 -translate-y-1/2 z-30 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white/15 hover:bg-primary text-white flex items-center justify-center transition-all active:scale-95 shadow-xl border border-white/20" aria-label="Previous photo">
        <i class="fa-solid fa-chevron-left text-base sm:text-lg"></i>
      </button>

      <!-- Center Photo Display -->
      <div id="modal-image-wrap" class="relative max-h-[82vh] max-w-[94vw] sm:max-w-[85vw] flex flex-col items-center justify-center select-none z-20">
        <img id="modal-img" src="" alt="VIP Party Photo" class="max-h-[72vh] sm:max-h-[78vh] w-auto max-w-full rounded-xl object-contain shadow-2xl transition-all duration-200">
        <p id="modal-caption" class="mt-2.5 text-xs sm:text-sm text-slate-200 text-center max-w-xl px-4 line-clamp-2 drop-shadow"></p>
      </div>

      <button id="modal-next" type="button" title="अगली तस्वीर (Right Arrow)" class="absolute right-2 sm:right-5 top-1/2 -translate-y-1/2 z-30 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white/15 hover:bg-primary text-white flex items-center justify-center transition-all active:scale-95 shadow-xl border border-white/20" aria-label="Next photo">
        <i class="fa-solid fa-chevron-right text-base sm:text-lg"></i>
      </button>

      <!-- Bottom Thumbnail / Counter Indicator -->
      <div class="absolute bottom-3 inset-x-0 z-30 flex flex-col items-center gap-2 pointer-events-none">
        <span id="modal-counter" class="bg-black/70 px-3.5 py-1 rounded-full backdrop-blur-sm border border-white/15 text-xs text-white/90 font-medium shadow-md"></span>
      </div>

    </div>
  </main>
  <%- include('../common/footer') %>
  <script src="/js/i18n.js"></script>
  <script src="/js/main.js"></script>
  <script>
    (() => {
      const grid = document.getElementById('gallery-grid');
      const chips = document.getElementById('gallery-categories');
      const search = document.getElementById('gallery-search');
      const empty = document.getElementById('gallery-empty');

      // Modal elements
      const modal = document.getElementById('photo-modal');
      const modalImg = document.getElementById('modal-img');
      const modalTitle = document.getElementById('modal-title');
      const modalCategory = document.getElementById('modal-category');
      const modalCaption = document.getElementById('modal-caption');
      const modalCounter = document.getElementById('modal-counter');
      const modalLink = document.getElementById('modal-external-link');
      const modalClose = document.getElementById('modal-close');
      const modalPrev = document.getElementById('modal-prev');
      const modalNext = document.getElementById('modal-next');

      let albums = [];
      let currentVisible = [];
      let category = 'all';

      // Modal navigation state: array of photos currently viewed in modal
      let modalPhotos = [];
      let modalPhotoIndex = 0;
      let modalActiveAlbum = null;

      const safe = (value) => String(value || '').replace(/[&<>"']/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));

      // ----------------------------------------------------
      // Modal Lightbox Functions
      // ----------------------------------------------------
      const updateModalDisplay = () => {
        if (!modalPhotos.length || modalPhotoIndex < 0 || modalPhotoIndex >= modalPhotos.length) return;
        const currentPhotoUrl = modalPhotos[modalPhotoIndex];

        modalImg.src = currentPhotoUrl;
        modalImg.alt = modalActiveAlbum ? modalActiveAlbum.title : 'VIP Party Photo';
        modalTitle.textContent = modalActiveAlbum ? modalActiveAlbum.title : 'VIP Party';
        modalCategory.textContent = modalActiveAlbum ? modalActiveAlbum.category : 'Gallery';
        modalCaption.textContent = modalActiveAlbum ? (modalActiveAlbum.description || '') : '';
        modalCounter.textContent = `तस्वीर ${modalPhotoIndex + 1} / ${modalPhotos.length}`;
        modalLink.href = currentPhotoUrl;

        const isSingle = modalPhotos.length <= 1;
        modalPrev.style.display = isSingle ? 'none' : 'flex';
        modalNext.style.display = isSingle ? 'none' : 'flex';
      };

      const openModalWithAlbum = (album, startPhotoIndex = 0) => {
        modalActiveAlbum = album;
        modalPhotos = (album.photos && album.photos.length) ? album.photos : [album.cover].filter(Boolean);
        modalPhotoIndex = Math.max(0, Math.min(startPhotoIndex, modalPhotos.length - 1));
        
        updateModalDisplay();
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        modalClose.focus();
      };

      const closeModal = () => {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
        modalImg.src = '';
      };

      const modalPrevPhoto = () => {
        if (!modalPhotos.length) return;
        modalPhotoIndex = (modalPhotoIndex - 1 + modalPhotos.length) % modalPhotos.length;
        updateModalDisplay();
      };

      const modalNextPhoto = () => {
        if (!modalPhotos.length) return;
        modalPhotoIndex = (modalPhotoIndex + 1) % modalPhotos.length;
        updateModalDisplay();
      };

      modalClose.addEventListener('click', closeModal);
      modalPrev.addEventListener('click', (e) => { e.stopPropagation(); modalPrevPhoto(); });
      modalNext.addEventListener('click', (e) => { e.stopPropagation(); modalNextPhoto(); });

      // Close on backdrop click
      modal.addEventListener('click', (e) => {
        if (e.target === modal || e.target.id === 'modal-image-wrap') {
          closeModal();
        }
      });

      // Keyboard navigation for modal
      document.addEventListener('keydown', (e) => {
        if (modal.classList.contains('hidden')) return;
        if (e.key === 'Escape') {
          closeModal();
        } else if (e.key === 'ArrowLeft') {
          modalPrevPhoto();
        } else if (e.key === 'ArrowRight') {
          modalNextPhoto();
        }
      });

      // Touch swipe in modal
      let modalTouchStartX = 0;
      let modalTouchEndX = 0;
      modal.addEventListener('touchstart', (e) => {
        modalTouchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      modal.addEventListener('touchend', (e) => {
        modalTouchEndX = e.changedTouches[0].screenX;
        const diff = modalTouchEndX - modalTouchStartX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) {
            modalPrevPhoto();
          } else {
            modalNextPhoto();
          }
        }
      }, { passive: true });

      // ----------------------------------------------------
      // Category Filter Chips
      // ----------------------------------------------------
      const drawChips = () => {
        const categories = ['all', ...new Set(albums.map(item => item.category).filter(Boolean))];
        chips.innerHTML = categories.map(value => `
          <button type="button" data-category="${safe(value)}" class="gallery-chip rounded-full px-4 py-2 text-sm font-bold transition ${value === category ? 'is-active' : ''}">
            ${value === 'all' ? 'सभी तस्वीरें' : safe(value)}
          </button>
        `).join('');
        
        chips.querySelectorAll('button').forEach(button => {
          button.addEventListener('click', () => {
            category = button.dataset.category;
            drawChips();
            drawItems();
          });
        });
      };

      // ----------------------------------------------------
      // Render Cards & Slider Functionality Inside Each Card
      // ----------------------------------------------------
      const drawItems = () => {
        const term = search.value.trim().toLowerCase();
        currentVisible = albums.filter(item => {
          const matchCat = (category === 'all' || item.category === category);
          const matchSearch = `${item.title || ''} ${item.category || ''} ${item.description || ''}`.toLowerCase().includes(term);
          return matchCat && matchSearch;
        });

        if (currentVisible.length === 0) {
          grid.innerHTML = '';
          grid.classList.add('hidden');
          empty.classList.remove('hidden');
          return;
        }

        empty.classList.add('hidden');
        grid.classList.remove('hidden');

        grid.innerHTML = currentVisible.map((item, idx) => {
          const photos = (item.photos && item.photos.length) ? item.photos : [item.cover || item.image || item.imageUrl || item.mediaUrl].filter(Boolean);
          const title = safe(item.title || 'VIP Party');
          const cat = safe(item.category || 'Gallery');
          const formattedDate = item.date ? new Date(item.date).toLocaleDateString('hi-IN', {day:'numeric',month:'long',year:'numeric'}) : '';
          const hasMultiple = photos.length > 1;

          return `
            <article data-card-idx="${idx}" class="gallery-card group overflow-hidden rounded-2xl bg-white border border-slate-100 flex flex-col justify-between">
              <div>
                <!-- Card Slider Container -->
                <div class="card-slider relative aspect-[4/3] overflow-hidden bg-slate-900 select-none cursor-pointer" data-action="open-modal">
                  
                  <!-- Carousel Track -->
                  <div class="card-slider-track flex h-full w-full transition-transform duration-300 ease-out" style="transform: translateX(0%);">
                    ${photos.map((pUrl, pIdx) => `
                      <div class="h-full w-full shrink-0 relative" data-photo-idx="${pIdx}">
                        <img src="${safe(pUrl)}" alt="${title} - Photo ${pIdx + 1}" class="h-full w-full object-cover" loading="${idx < 3 ? 'eager' : 'lazy'}">
                      </div>
                    `).join('')}
                  </div>

                  <!-- Hover Subtle Overlay & Zoom Icon -->
                  <div class="absolute inset-0 bg-slate-950/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center pointer-events-none">
                    <span class="w-11 h-11 rounded-full bg-white/95 text-primary shadow-lg flex items-center justify-center text-sm transform scale-90 group-hover:scale-100 transition-transform">
                      <i class="fa-solid fa-magnifying-glass-plus"></i>
                    </span>
                  </div>

                  <!-- Category Badge (Top-Left) -->
                  <div class="absolute top-3 left-3 z-10 pointer-events-none">
                    <span class="rounded-full bg-primary/90 backdrop-blur-sm px-2.5 py-1 text-xs font-bold text-white shadow-sm border border-white/20">
                      ${cat}
                    </span>
                  </div>

                  <!-- Photo Counter Badge (Top-Right) -->
                  ${hasMultiple ? `
                    <div class="absolute top-3 right-3 z-10 pointer-events-none">
                      <span class="card-count-badge rounded-full bg-black/60 backdrop-blur-sm px-2.5 py-1 text-[11px] font-bold text-white flex items-center gap-1.5 shadow-sm border border-white/20">
                        <i class="fa-solid fa-images text-[10px] text-amber-400"></i>
                        <span class="card-current-num">1</span>/${photos.length}
                      </span>
                    </div>
                  ` : ''}

                  <!-- Next / Previous Slider Arrows on Card -->
                  ${hasMultiple ? `
                    <button type="button" class="card-prev-btn absolute left-2 top-1/2 -translate-y-1/2 z-20 w-9 h-9 rounded-full bg-black/60 hover:bg-primary text-white flex items-center justify-center transition-all opacity-95 sm:opacity-0 sm:group-hover:opacity-100 shadow-md active:scale-90 border border-white/20" aria-label="पिछली तस्वीर">
                      <i class="fa-solid fa-chevron-left text-xs pointer-events-none"></i>
                    </button>
                    <button type="button" class="card-next-btn absolute right-2 top-1/2 -translate-y-1/2 z-20 w-9 h-9 rounded-full bg-black/60 hover:bg-primary text-white flex items-center justify-center transition-all opacity-95 sm:opacity-0 sm:group-hover:opacity-100 shadow-md active:scale-90 border border-white/20" aria-label="अगली तस्वीर">
                      <i class="fa-solid fa-chevron-right text-xs pointer-events-none"></i>
                    </button>

                    <!-- Dot Indicators -->
                    <div class="card-dots-wrap absolute bottom-2.5 inset-x-0 z-20 flex justify-center items-center gap-1.5">
                      ${photos.map((_, dIdx) => `
                        <button type="button" data-dot-idx="${dIdx}" class="card-dot inline-block h-1.5 rounded-full transition-all duration-200 ${dIdx === 0 ? 'w-5 bg-amber-400 shadow-sm' : 'w-1.5 bg-white/70 hover:bg-white'}" aria-label="फोटो ${dIdx + 1} पर जाएं"></button>
                      `).join('')}
                    </div>
                  ` : ''}

                </div>

                <!-- Card Body -->
                <div class="p-5">
                  <h3 class="line-clamp-2 font-bold text-slate-900 group-hover:text-primary transition-colors text-base cursor-pointer" data-action="open-modal">
                    ${title}
                  </h3>
                  ${item.description ? `
                    <p class="mt-2 line-clamp-2 text-xs text-slate-500 leading-relaxed">${safe(item.description)}</p>
                  ` : ''}
                </div>
              </div>

              <!-- Card Footer -->
              <div class="px-5 pb-5 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
                <span class="flex items-center gap-1.5">
                  <i class="fa-regular fa-calendar-days text-slate-400"></i>
                  ${formattedDate || 'VIP Party'}
                </span>
                <button type="button" class="text-primary hover:text-primary-700 font-bold flex items-center gap-1 text-xs cursor-pointer" data-action="open-modal">
                  <span>तस्वीरें देखें (${photos.length})</span>
                  <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </button>
              </div>

            </article>
          `;
        }).join('');

        // Attach Card Slider & Modal Events for Each Card
        grid.querySelectorAll('.gallery-card').forEach(card => {
          const cardIdx = parseInt(card.getAttribute('data-card-idx'), 10);
          const album = currentVisible[cardIdx];
          if (!album) return;

          const photos = (album.photos && album.photos.length) ? album.photos : [album.cover].filter(Boolean);
          const totalPhotos = photos.length;
          let currentSlide = 0;

          const track = card.querySelector('.card-slider-track');
          const currentNumSpan = card.querySelector('.card-current-num');
          const dots = card.querySelectorAll('.card-dot');
          const prevBtn = card.querySelector('.card-prev-btn');
          const nextBtn = card.querySelector('.card-next-btn');
          const sliderEl = card.querySelector('.card-slider');

          const updateSlide = (newIndex) => {
            currentSlide = (newIndex + totalPhotos) % totalPhotos;
            if (track) {
              track.style.transform = `translateX(-${currentSlide * 100}%)`;
            }
            if (currentNumSpan) {
              currentNumSpan.textContent = currentSlide + 1;
            }
            if (dots.length) {
              dots.forEach((dot, dIdx) => {
                if (dIdx === currentSlide) {
                  dot.className = 'card-dot inline-block h-1.5 rounded-full transition-all duration-200 w-5 bg-amber-400 shadow-sm';
                } else {
                  dot.className = 'card-dot inline-block h-1.5 rounded-full transition-all duration-200 w-1.5 bg-white/70 hover:bg-white';
                }
              });
            }
          };

          if (prevBtn) {
            prevBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              e.preventDefault();
              updateSlide(currentSlide - 1);
            });
          }

          if (nextBtn) {
            nextBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              e.preventDefault();
              updateSlide(currentSlide + 1);
            });
          }

          if (dots.length) {
            dots.forEach(dot => {
              dot.addEventListener('click', (e) => {
                e.stopPropagation();
                e.preventDefault();
                const targetIdx = parseInt(dot.getAttribute('data-dot-idx'), 10);
                updateSlide(targetIdx);
              });
            });
          }

          // Mobile touch swipe on card slider
          if (sliderEl && totalPhotos > 1) {
            let cardTouchStartX = 0;
            let cardTouchEndX = 0;
            sliderEl.addEventListener('touchstart', (e) => {
              cardTouchStartX = e.changedTouches[0].screenX;
            }, { passive: true });

            sliderEl.addEventListener('touchend', (e) => {
              cardTouchEndX = e.changedTouches[0].screenX;
              const diff = cardTouchEndX - cardTouchStartX;
              if (Math.abs(diff) > 35) {
                if (diff > 0) {
                  updateSlide(currentSlide - 1); // swiped right -> prev
                } else {
                  updateSlide(currentSlide + 1); // swiped left -> next
                }
              }
            }, { passive: true });
          }

          // Open Full Lightbox Modal on Clicking Card or "तस्वीरें देखें"
          card.querySelectorAll('[data-action="open-modal"]').forEach(clickableEl => {
            clickableEl.addEventListener('click', (e) => {
              // Ensure we didn't click slider buttons or dots
              if (e.target.closest('.card-prev-btn') || e.target.closest('.card-next-btn') || e.target.closest('.card-dot')) {
                return;
              }
              openModalWithAlbum(album, currentSlide);
            });
          });
        });
      };

      search.addEventListener('input', drawItems);

            albums = <%- JSON.stringify(initialAlbums || []).replace(/</g, '\\u003c') %>;
      albums = albums.filter(item => item && (item.cover || item.image || item.imageUrl || item.mediaUrl || (item.photos && item.photos.length)));
      drawChips();
      drawItems();
    })();
  </script>
</body>
</html>
