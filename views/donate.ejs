                <div class="relative group animate-slide-up w-full sm:w-auto">
                    <a href="/member" class="w-full sm:w-auto bg-amber-500 hover:bg-amber-400 text-gray-950 font-black px-8 py-3.5 rounded-xl text-base shadow-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl inline-flex items-center justify-center gap-2 whitespace-nowrap">
                        <span data-i18n="callout.btn">सदस्य बनें (Join VIP)</span>
