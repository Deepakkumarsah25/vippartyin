    <!-- 6. Shared Footer -->
    <%- include('common/footer') %>

    <!-- Toast Notification -->
    <div id="copyToast" class="toast-notification">
        <i class="fa-solid fa-circle-check text-emerald-400 mr-2"></i>
        <span id="toastMsg">कॉपी हो गया!</span>
    </div>

    <!-- Scripts -->
    <script src="/js/i18n.js"></script>
    <script src="/js/main.js"></script>

    <script>
        // Copy to clipboard helper
        function copyText(val, label) {
            if (!val) return;
            navigator.clipboard.writeText(val).then(() => {
                const toast = document.getElementById('copyToast');
                const msg = document.getElementById('toastMsg');
                msg.textContent = `${label} सफलतापूर्वक कॉपी किया गया!`;
                toast.style.display = 'block';
                setTimeout(() => {
                    toast.style.display = 'none';
                }, 2500);
            });
        }

        // Quick amount selection
        function setAmount(amt) {
            const input = document.getElementById('donAmount');
            input.value = amt;
            document.querySelectorAll('.amt-chip').forEach(c => {
                c.classList.remove('border-primary', 'bg-blue-50', 'text-primary');
                c.classList.add('border-gray-200', 'text-gray-700');
            });
            if (event && event.target) {
                event.target.classList.remove('border-gray-200', 'text-gray-700');
                event.target.classList.add('border-primary', 'bg-blue-50', 'text-primary');
            }
        }

        // Form Submission
        const form = document.getElementById('donationSubmitForm');
        const alertBox = document.getElementById('donateAlert');
        const submitBtn = document.getElementById('donSubmitBtn');
        const btnText = document.getElementById('donBtnText');
        const receiptBox = document.getElementById('receiptBox');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            alertBox.classList.add('hidden');

            const donorName = document.getElementById('donName').value.trim();
            const donorPhone = document.getElementById('donPhone').value.trim();
            const donorEmail = document.getElementById('donEmail').value.trim();
            const panNumber = document.getElementById('donPan').value.trim();
            const amount = document.getElementById('donAmount').value;
            const utrNumber = document.getElementById('donUtr').value.trim();
            const paymentMode = document.getElementById('donMode').value;
            const state = document.getElementById('donState').value.trim();
            const district = document.getElementById('donDistrict').value.trim();
            const message = document.getElementById('donMsg').value.trim();

            if (!donorName || !donorPhone || !amount) {
                alertBox.textContent = 'कृपया नाम, मोबाइल नंबर और सहयोग राशि अनिवार्य रूप से भरें।';
                alertBox.className = 'mb-6 p-4 rounded-2xl text-sm font-semibold bg-red-50 text-red-700 border border-red-200';
                alertBox.classList.remove('hidden');
                return;
            }

            submitBtn.disabled = true;
            btnText.textContent = 'सूचना दर्ज हो रही है...';

            try {
                const res = await fetch('/api/donate/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        donorName, donorPhone, donorEmail, panNumber, amount,
                        utrNumber, paymentMode, state, district, message
                    })
                });

                const data = await res.json();
                if (data.success) {
                    alertBox.textContent = data.message;
                    alertBox.className = 'mb-6 p-4 rounded-2xl text-sm font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200';
                    alertBox.classList.remove('hidden');

                    document.getElementById('recNo').textContent = data.receiptNumber;
                    document.getElementById('recAmt').textContent = '₹' + Number(data.amount).toLocaleString('en-IN');
                    document.getElementById('recName').textContent = data.donorName;
                    document.getElementById('recDate').textContent = new Date().toLocaleDateString('hi-IN', { day: '2-digit', month: 'short', year: 'numeric' });
                    receiptBox.classList.remove('hidden');
                    receiptBox.scrollIntoView({ behavior: 'smooth' });

                    form.reset();
                } else {
                    alertBox.textContent = data.message || 'त्रुटि हुई। कृपया पुनः प्रयास करें।';
                    alertBox.className = 'mb-6 p-4 rounded-2xl text-sm font-semibold bg-red-50 text-red-700 border border-red-200';
                    alertBox.classList.remove('hidden');
                }
            } catch (err) {
                alertBox.textContent = 'सर्वर से संपर्क नहीं हो पाया। कृपया नेटवर्क जांचें।';
                alertBox.className = 'mb-6 p-4 rounded-2xl text-sm font-semibold bg-red-50 text-red-700 border border-red-200';
                alertBox.classList.remove('hidden');
            } finally {
                submitBtn.disabled = false;
                btnText.textContent = 'दान की सूचना सबमिट करें (Submit Donation Acknowledgment)';
            }
        });
    </script>
</body>
</html>
