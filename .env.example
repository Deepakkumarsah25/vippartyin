# Google Identity Services Web OAuth client ID.
# Create a Web application client in Google Cloud Console and authorize
# http://localhost:3000 plus the production site origin.
GOOGLE_CLIENT_ID=

# Optional; set a long random value for signing login cookies.
AUTH_SESSION_SECRET=
# Cloudinary account -> Dashboard/API Keys page
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
